<!doctype html>
<html lang="id">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title><%= invoice.invoice_number %> · <%= branding.companyName %></title>
<style>
:root{--ink:#0b1020;--purple:#603aea;--red:#ff433e;--green:#18a979;--line:#e4e7ec;--soft:#f8f9fc;--muted:#667085;--text:#101828}*{box-sizing:border-box}body{font-family:Inter,Arial,sans-serif;color:var(--text);margin:0;background:#eef1f6}.sheet{width:min(900px,calc(100% - 28px));margin:28px auto;background:#fff;box-shadow:0 18px 55px rgba(16,24,40,.12)}.top{position:relative;min-height:128px;padding:28px 34px;color:#fff;background:var(--ink);overflow:hidden}.top:after{content:"";position:absolute;left:0;right:0;bottom:0;height:4px;background:linear-gradient(90deg,var(--purple) 0 73%,var(--red) 73%)}.top img{width:160px;max-height:48px;object-fit:contain;object-position:left center}.invoice-title{position:absolute;right:34px;top:27px;text-align:right}.invoice-title h1{margin:0;font-size:29px;letter-spacing:.04em}.invoice-title strong{display:block;margin-top:7px;color:#b5a8ff;font-size:12px}.invoice-title small{display:block;margin-top:8px;color:#c8ceda}.body{padding:31px 34px}.party-grid{display:grid;grid-template-columns:1.25fr .75fr;gap:24px}.eyebrow{display:block;color:var(--purple);font-size:10px;font-weight:800;letter-spacing:.12em;margin-bottom:8px}.billto h2{margin:0;font-size:20px}.billto p{margin:5px 0;color:var(--muted);font-size:12px;line-height:1.55}.meta{border:1px solid var(--line);border-radius:13px;padding:14px;background:var(--soft)}.meta div{display:flex;justify-content:space-between;gap:15px;padding:7px 0;border-bottom:1px solid var(--line);font-size:11px}.meta div:last-child{border-bottom:0}.meta span{color:var(--muted)}.meta strong{text-align:right}.service{width:100%;border-collapse:separate;border-spacing:0;margin-top:30px;border:1px solid var(--line);border-radius:12px;overflow:hidden}.service th{background:#121a2c;color:#fff;padding:12px 14px;font-size:10px;text-align:left}.service th:last-child,.service td:last-child{text-align:right}.service td{padding:16px 14px;border-bottom:1px solid var(--line);font-size:12px}.service td strong{display:block}.service td small{display:block;margin-top:5px;color:var(--muted)}.lower{display:grid;grid-template-columns:1fr 360px;gap:28px;margin-top:24px}.payment-box{border:1px solid var(--line);border-radius:13px;padding:16px;background:var(--soft)}.payment-box h3{margin:0 0 11px;font-size:12px}.payment-box strong{display:block;color:var(--purple);font-size:17px}.payment-box p{margin:5px 0;color:var(--muted);font-size:11px}.totals{border:1px solid var(--line);border-radius:13px;padding:15px}.totals div{display:flex;justify-content:space-between;padding:8px 2px;font-size:12px}.totals .line{border-top:1px solid var(--line);margin-top:3px;padding-top:12px}.totals .due{border-top:1px solid var(--line);margin-top:4px;padding-top:13px;font-weight:800;font-size:16px}.totals .due b{color:<%= Number(invoice.outstanding)>0?'#ff433e':'#18a979' %>}.status{display:inline-flex;margin-top:20px;padding:8px 13px;border-radius:999px;font-size:11px;font-weight:800;background:<%= invoice.status==='paid'?'#eafbf5':invoice.status==='overdue'?'#fff0ef':'#f1edff' %>;color:<%= invoice.status==='paid'?'#18a979':invoice.status==='overdue'?'#ff433e':'#603aea' %>}.history{margin-top:26px;padding-top:22px;border-top:1px solid var(--line)}.history h3{font-size:12px}.history-row{display:grid;grid-template-columns:120px 1fr auto;gap:12px;padding:9px 0;border-bottom:1px solid var(--line);font-size:11px}.history-row span{color:var(--muted)}.foot{margin-top:32px;padding-top:18px;border-top:1px solid var(--line);display:flex;justify-content:space-between;gap:20px;color:var(--muted);font-size:10px;line-height:1.5}.foot strong{display:block;color:var(--text);margin-bottom:4px}.actions{display:flex;gap:8px;justify-content:flex-end;margin-bottom:18px}.actions a,.actions button{border:0;border-radius:9px;padding:10px 14px;cursor:pointer;text-decoration:none;font:inherit;font-size:11px;font-weight:700}.actions button{background:var(--purple);color:#fff}.actions a{background:var(--soft);color:var(--text);border:1px solid var(--line)}@media(max-width:700px){.party-grid,.lower{grid-template-columns:1fr}.invoice-title{position:static;text-align:left;margin-top:20px}.top{padding-bottom:30px}.history-row{grid-template-columns:1fr}.sheet{margin:0;width:100%}}@media print{body{background:#fff}.sheet{box-shadow:none;width:auto;margin:0}.actions{display:none}.body{padding:24px 28px}.top{print-color-adjust:exact;-webkit-print-color-adjust:exact}.service th{print-color-adjust:exact;-webkit-print-color-adjust:exact}}
</style>
<style>@page{size:A4;margin:0}@media print{html,body{width:210mm;height:297mm;background:#fff!important;overflow:hidden}.sheet{width:210mm;height:297mm;margin:0;box-shadow:none;overflow:hidden}.actions{display:none!important}.top{min-height:30mm;padding:7mm 9mm}.body{padding:7mm 9mm}.service{margin-top:6mm}.lower{margin-top:5mm}.history{margin-top:5mm;padding-top:4mm}.foot{margin-top:6mm;padding-top:4mm}}</style>
</head>
<body><div class="sheet"><div class="top"><img src="<%= branding.logoPath?'/invoices/branding/logo/'+encodeURIComponent(branding.logoPath):'/img/inkamnet-wordmark-hq.png' %>" alt="<%= branding.companyName %>"><div class="invoice-title"><h1>INVOICE</h1><strong><%= invoice.invoice_number %></strong><small><%= branding.companyName %></small></div></div><div class="body"><div class="actions"><a href="/invoices/<%= invoice.id %>/pdf?download=1">Download PDF</a><button onclick="window.print()">Cetak / Simpan PDF</button></div><div class="party-grid"><div class="billto"><span class="eyebrow">DITAGIHKAN KEPADA</span><h2><%= invoice.customer_name %></h2><p><%= invoice.customer_code %><br><%= invoice.address||'-' %><br><%= invoice.phone||'-' %></p></div><div class="meta"><div><span>Tanggal Invoice</span><strong><%= formatDate(invoice.invoice_date) %></strong></div><div><span>Jatuh Tempo</span><strong><%= formatDate(invoice.due_date) %></strong></div><div><span>Periode</span><strong><%= String(invoice.period_month).padStart(2,'0') %>/<%= invoice.period_year %></strong></div><div><span>Site / Cluster</span><strong><%= invoice.site_code %> / <%= invoice.cluster_name||'-' %></strong></div></div></div><table class="service"><thead><tr><th>DESKRIPSI LAYANAN</th><th>QTY</th><th>NOMINAL</th></tr></thead><tbody><tr><td><strong><%= invoice.package_name %><%= invoice.is_prorata?' · Prorata':'' %></strong><small>Layanan Internet · <%= invoice.site_code %> · Cluster <%= invoice.cluster_name||'-' %></small></td><td>1</td><td><%= formatRupiah(invoice.subtotal) %></td></tr></tbody></table><div class="lower"><div><div class="payment-box"><h3>INFORMASI PEMBAYARAN</h3><% if(bank){ %><strong><%= bank.bank_name %> · <%= bank.account_number %></strong><p>a.n. <%= bank.account_name %></p><p>Cantumkan nomor invoice pada referensi pembayaran.</p><% }else{ %><p>Hubungi admin <%= branding.companyName %> untuk informasi rekening pembayaran.</p><% } %></div><span class="status">STATUS · <%= String(invoice.status).toUpperCase() %></span></div><div class="totals"><div><span>Subtotal</span><b><%= formatRupiah(invoice.subtotal) %></b></div><div><span>Diskon</span><b>- <%= formatRupiah(invoice.discount) %></b></div><div class="line"><span>Total Invoice</span><b><%= formatRupiah(invoice.total) %></b></div><div><span>Terbayar</span><b><%= formatRupiah(invoice.paid_amount) %></b></div><div class="due"><span>SISA TAGIHAN</span><b><%= formatRupiah(invoice.outstanding) %></b></div></div></div><% if(payments.length){ %><div class="history"><h3>RIWAYAT PEMBAYARAN</h3><% payments.forEach(p=>{ %><div class="history-row"><strong><%= formatRupiah(p.amount) %></strong><span><%= String(p.method).toUpperCase() %> · <%= String(p.status).toUpperCase() %><%= p.reference?' · '+p.reference:'' %></span><span><%= new Date(p.paid_at).toLocaleString('id-ID',{timeZone:'Asia/Jakarta'}) %></span></div><% }) %></div><% } %><div class="foot"><div><strong><%= branding.companyName %></strong><%= branding.address||'' %><% if(branding.phone){ %><br>Tel. <%= branding.phone %><% } %><% if(branding.email){ %> · <%= branding.email %><% } %><% if(branding.website){ %><br><%= branding.website %><% } %><% if(branding.taxId){ %><br>NPWP/ID Pajak: <%= branding.taxId %><% } %></div><div style="text-align:right"><strong><%= branding.tagline %></strong><%= branding.footer %></div></div></div></div></body></html>
