<section>
<div class="module-head"><div><div class="module-kicker">BILLING ENGINE</div><h1>Tagihan Pelanggan</h1><p>Generate invoice, pantau tunggakan, prorata, outstanding, dan status pembayaran.</p></div><div class="module-actions"><a class="btn-tech" href="/payments"><i class="bi bi-wallet2"></i>Pembayaran</a><form method="post" action="/invoices/generate"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn-tech primary"><i class="bi bi-stars"></i>Generate Tagihan</button></form></div></div>
<% const paidCount=invoices.filter(i=>i.status==='paid').length; const overdueCount=invoices.filter(i=>i.status==='overdue').length; const outstanding=invoices.reduce((a,i)=>a+Number(i.outstanding||0),0); const total=invoices.reduce((a,i)=>a+Number(i.total||0),0); %>
<div class="metric-grid"><article class="metric-card"><div class="metric-top"><span class="metric-label">Total Invoice</span><span class="metric-icon"><i class="bi bi-receipt-fill"></i></span></div><strong><%= invoices.length %></strong><small>Data sesuai filter</small></article><article class="metric-card green"><div class="metric-top"><span class="metric-label">Lunas</span><span class="metric-icon"><i class="bi bi-check2-circle"></i></span></div><strong><%= paidCount %></strong><small>Invoice paid</small></article><article class="metric-card red"><div class="metric-top"><span class="metric-label">Overdue</span><span class="metric-icon"><i class="bi bi-alarm-fill"></i></span></div><strong><%= overdueCount %></strong><small>Perlu follow-up</small></article><article class="metric-card orange"><div class="metric-top"><span class="metric-label">Outstanding</span><span class="metric-icon"><i class="bi bi-hourglass-split"></i></span></div><strong><%= formatRupiah(outstanding) %></strong><small>Dari <%= formatRupiah(total) %> tertagih</small></article></div>
<div class="filter-card"><div class="toolbar"><div class="toolbar-left"><a href="/invoices" class="btn-tech <%= !status?'primary':'' %>">Semua</a><a href="/invoices?status=unpaid" class="btn-tech <%= status==='unpaid'?'primary':'' %>">Unpaid</a><a href="/invoices?status=overdue" class="btn-tech <%= status==='overdue'?'primary':'' %>">Overdue</a><a href="/invoices?status=paid" class="btn-tech <%= status==='paid'?'primary':'' %>">Paid</a></div><div class="toolbar-right"><a class="btn-tech" href="/reports"><i class="bi bi-bar-chart-line"></i>Laporan</a></div></div></div>
<div class="data-card"><div class="data-card-head"><div><h3>Invoice Registry</h3><small>Billing status dan nominal per pelanggan</small></div></div><div class="table-responsive"><table class="app-table"><thead><tr><th>Invoice</th><th>Pelanggan</th><th>Site</th><th>Jatuh Tempo</th><th>Tagihan</th><th>Dibayar</th><th>Outstanding</th><th>Status</th></tr></thead><tbody><% invoices.forEach(i=>{ %><tr><td><span class="cell-main text-purple"><%= i.invoice_number %></span><span class="cell-sub"><%= i.is_prorata?'PRORATA':'MONTHLY' %></span></td><td><span class="cell-main"><%= i.customer_name %></span><span class="cell-sub"><%= i.customer_code %></span></td><td><span class="status-badge purple"><%= i.site_code %></span></td><td><%= formatDate(i.due_date) %></td><td class="money"><%= formatRupiah(i.total) %></td><td class="money text-success-soft"><%= formatRupiah(i.paid_amount) %></td><td class="money <%= Number(i.outstanding)>0?'text-danger-soft':'' %>"><%= formatRupiah(i.outstanding) %></td><td><span class="status-badge <%= i.status==='paid'?'green':i.status==='overdue'?'red':i.status==='partial'?'orange':'gray' %>"><%= i.status %></span></td></tr><% }) %><% if(!invoices.length){%><tr><td colspan="8"><div class="empty-state"><i class="bi bi-receipt"></i><strong>Belum ada invoice</strong><small>Gunakan Generate Tagihan untuk membuat billing.</small></div></td></tr><%}%></tbody></table></div></div>
</section>
