<section class="billing-page">
  <div class="module-head billing-head">
    <div>
      <div class="module-kicker">MESIN TAGIHAN</div>
      <h1>Tagihan Pelanggan</h1>
      <p>Buat tagihan per bulan atau per pelanggan, pantau status pembayaran, dan tindak lanjuti tagihan dari satu halaman.</p>
    </div>
    <div class="module-actions">
      <a class="btn-tech" href="/reports?view=invoice"><i class="bi bi-file-earmark-text"></i>Faktur</a><a class="btn-tech" href="/payments"><i class="bi bi-wallet2"></i>Pembayaran</a>
      <button class="btn-tech primary" type="button" data-bs-toggle="modal" data-bs-target="#generateInvoiceModal"><i class="bi bi-arrow-repeat"></i>Refresh / Generate Tagihan</button>
    </div>
  </div>

  <div class="billing-period-note">
    <i class="bi bi-info-circle-fill"></i>
    <div><strong>Periode aktif: <%= monthNames[filters.month-1] %> <%= filters.year %></strong><span>Ringkasan dan tabel di bawah mengikuti periode/filter yang dipilih. Pembuatan tagihan dapat dilakukan untuk semua pelanggan aktif atau satu pelanggan tertentu.</span></div>
  </div>

  <div class="billing-stat-grid">
    <article class="billing-stat"><span class="billing-stat-icon green"><i class="bi bi-people"></i></span><div><small>Pelanggan Aktif</small><strong><%= summary.active %></strong></div></article>
    <article class="billing-stat"><span class="billing-stat-icon blue"><i class="bi bi-calendar2-check"></i></span><div><small>Total Tagihan</small><strong><%= summary.total %></strong></div></article>
    <article class="billing-stat"><span class="billing-stat-icon green"><i class="bi bi-receipt"></i></span><div><small>Tagihan Terbit</small><strong><%= summary.issued %></strong></div></article>
    <article class="billing-stat"><span class="billing-stat-icon red"><i class="bi bi-calendar2-x"></i></span><div><small>Belum Terbit</small><strong><%= summary.notIssued %></strong></div></article>
    <article class="billing-stat"><span class="billing-stat-icon green"><i class="bi bi-check2-circle"></i></span><div><small>Tagihan Lunas</small><strong><%= summary.paidCount %></strong></div></article>
    <article class="billing-stat"><span class="billing-stat-icon red"><i class="bi bi-alarm"></i></span><div><small>Belum Lunas</small><strong><%= summary.unpaidCount %></strong></div></article>
    <article class="billing-stat"><span class="billing-stat-icon green"><i class="bi bi-cash-coin"></i></span><div><small>Nominal Terbayar</small><strong><%= formatRupiah(summary.paidAmount) %></strong></div></article>
    <article class="billing-stat"><span class="billing-stat-icon red"><i class="bi bi-hourglass-split"></i></span><div><small>Sisa Tagihan</small><strong><%= formatRupiah(summary.outstanding) %></strong></div></article>
  </div>

  <form class="billing-filter-panel" method="get" action="/invoices">
    <div class="billing-filter-head"><div><strong>Filter Tagihan</strong><small>Pilih periode dan data yang ingin ditampilkan.</small></div><a href="/invoices" class="ink-text-link"><i class="bi bi-arrow-counterclockwise"></i> Atur Ulang</a></div>
    <div class="billing-filter-grid">
      <div class="filter-group"><label>BULAN</label><select class="form-select" name="month"><% monthNames.forEach((m,i)=>{ %><option value="<%= i+1 %>" <%= filters.month===i+1?'selected':'' %>><%= m %></option><% }) %></select></div>
      <div class="filter-group"><label>TAHUN</label><input class="form-control" name="year" type="number" min="2020" max="2100" value="<%= filters.year %>"></div>
      <div class="filter-group"><label>STATUS</label><select class="form-select" name="status"><option value="">Semua Status</option><option value="unpaid" <%= filters.status==='unpaid'?'selected':'' %>>Belum Lunas</option><option value="partial" <%= filters.status==='partial'?'selected':'' %>>Sebagian</option><option value="overdue" <%= filters.status==='overdue'?'selected':'' %>>Terlambat</option><option value="paid" <%= filters.status==='paid'?'selected':'' %>>Lunas</option></select></div>
      <div class="filter-group"><label>SITE / POP</label><select class="form-select" name="site"><option value="">Semua Site</option><% sites.forEach(s=>{ %><option value="<%= s.code %>" <%= filters.site===s.code?'selected':'' %>><%= s.code %> · <%= s.name %></option><% }) %></select></div>
      <div class="filter-group"><label>CLUSTER / ODP</label><select class="form-select" name="cluster"><option value="">Semua Cluster</option><% clusters.forEach(c=>{ %><option value="<%= c.id %>" <%= String(filters.cluster)===String(c.id)?'selected':'' %>><%= c.site_code %> · <%= c.name %></option><% }) %></select></div>
      <div class="filter-group billing-filter-customer"><label>PELANGGAN</label><select class="form-select" name="customer"><option value="">Semua Pelanggan</option><% customers.forEach(c=>{ %><option value="<%= c.id %>" <%= String(filters.customer)===String(c.id)?'selected':'' %>><%= c.site_code %> · Cluster <%= c.cluster_name||'-' %> · <%= c.customer_code %> · <%= c.name %></option><% }) %></select></div>
      <div class="filter-group billing-filter-search"><label>CARI</label><div class="search-box"><i class="bi bi-search"></i><input name="q" value="<%= filters.q %>" placeholder="Nama, ID pelanggan, faktur, site, cluster..."></div></div>
      <div class="billing-filter-submit"><button class="btn-tech primary"><i class="bi bi-funnel"></i>Terapkan Filter</button></div>
    </div>
  </form>

  <div class="data-card invoice-registry-card action-safe-card">
    <div class="data-card-head invoice-registry-head">
      <div><h3>Daftar Tagihan</h3><small><%= invoices.length %> tagihan · <%= monthNames[filters.month-1] %> <%= filters.year %></small></div>
      <div class="invoice-registry-tools">
        <div class="invoice-selection-state"><i class="bi bi-check2-square"></i><span><b id="invoiceTableSelectedCount">0</b> dipilih</span></div>
        <button class="btn-tech success compact" type="button" id="paySelectedInvoices" disabled><i class="bi bi-wallet2"></i>Bayar Dipilih</button>
        <div class="legend-inline"><span><i class="dot success"></i>Lunas</span><span><i class="dot warning"></i>Belum Lunas</span></div>
      </div>
    </div>
    <div class="table-responsive action-safe-table">
      <table class="app-table invoice-table">
        <thead><tr><th>#</th><th>Pelanggan</th><th>Periode</th><th>Status</th><th>Tagihan</th><th>Terbayar</th><th>Sisa</th><th>Site</th><th>Jatuh Tempo</th><th class="invoice-action-head">Tindakan</th></tr></thead>
        <tbody>
          <% invoices.forEach((i,index)=>{ const wa=String(i.phone||'').replace(/\D/g,'').replace(/^0/,'62'); const reminder=`Halo ${i.customer_name}, kami mengingatkan tagihan INKAMNET periode ${monthNames[i.period_month-1]} ${i.period_year} sebesar ${formatRupiah(i.outstanding)}. No. faktur ${i.invoice_number}. Terima kasih.`; const canPay=Number(i.outstanding)>0 && !['paid','cancelled','refunded'].includes(i.status); %>
          <tr>
            <td><span class="cell-main"><%= index+1 %></span></td>
            <td>
              <div class="invoice-customer-select">
                <input class="form-check-input invoice-table-check" type="checkbox" value="<%= i.id %>" data-invoice-table-check <%= canPay?'':'disabled' %> aria-label="Pilih tagihan <%= i.customer_name %>">
                <div><span class="cell-main"><%= i.customer_name %></span><span class="cell-sub"><%= i.customer_code %></span><a class="invoice-number-link" href="/invoices/<%= i.id %>/pdf" target="_blank"><i class="bi bi-file-earmark-pdf"></i><%= i.invoice_number %></a></div>
              </div>
            </td>
            <td><span class="cell-main"><%= monthNames[i.period_month-1] %> <%= i.period_year %></span><span class="cell-sub"><%= i.is_prorata?'PRORATA':'BULANAN' %></span></td>
            <td><span class="status-badge <%= i.status==='paid'?'green':i.status==='overdue'?'red':i.status==='partial'?'orange':'gray' %>"><%= i.status==='paid'?'LUNAS':i.status==='overdue'?'TERLAMBAT':i.status==='partial'?'SEBAGIAN':i.status==='cancelled'?'DIBATALKAN':'BELUM LUNAS' %></span></td>
            <td class="money"><%= formatRupiah(i.total) %><span class="cell-sub"><%= i.package_name %></span></td>
            <td class="money text-success-soft"><%= formatRupiah(i.paid_amount) %></td>
            <td class="money <%= Number(i.outstanding)>0?'text-danger-soft':'text-success-soft' %>"><%= formatRupiah(i.outstanding) %></td>
            <td><span class="cell-main"><%= i.site_code %></span><span class="cell-sub">Cluster <%= i.cluster_name||'-' %></span></td>
            <td><%= formatDate(i.due_date) %></td>
            <td class="invoice-action-cell">
              <div class="invoice-inline-actions">
                <% if(canPay){ %><button type="button" class="invoice-pay-button" data-bs-toggle="modal" data-bs-target="#paymentModal" data-payment-invoice-id="<%= i.id %>"><i class="bi bi-wallet2"></i><span>Bayar</span></button><% } %>
                <button class="action-menu" type="button" data-action-popover-target="invoiceAction<%= i.id %>" aria-label="Buka tindakan tagihan <%= i.invoice_number %>"><i class="bi bi-three-dots-vertical"></i></button>
              </div>
              <div class="ink-action-popover" id="invoiceAction<%= i.id %>" hidden>
                <div class="ink-action-popover-head"><div><small>TAGIHAN</small><strong><%= i.customer_name %></strong><span><%= i.invoice_number %></span></div></div>
                <div class="ink-action-popover-body">
                  <% if(canPay){ %><button type="button" class="ink-action-item compact success" data-action-close data-bs-toggle="modal" data-bs-target="#paymentModal" data-payment-invoice-id="<%= i.id %>"><i class="bi bi-wallet2"></i><span><b>Pembayaran</b><small>Catat pembayaran</small></span></button><% } %>
                  <button type="button" class="ink-action-item compact" data-action-close data-bs-toggle="modal" data-bs-target="#invoiceEditModal" data-invoice-edit-id="<%= i.id %>" data-invoice-edit-number="<%= i.invoice_number %>" data-invoice-edit-customer="<%= i.customer_name %>" data-invoice-edit-date="<%= i.invoice_date_key %>" data-invoice-edit-due="<%= i.due_date_key %>" data-invoice-edit-prorata="<%= i.is_prorata?1:0 %>"><i class="bi bi-pencil-square"></i><span><b>Edit Tagihan</b><small>Tanggal & tipe, bukan nominal</small></span></button>
                  <% if(user.role==='admin' && (Number(i.paid_amount)>0 || ['paid','partial'].includes(i.status))){ %><form method="post" action="/invoices/<%= i.id %>/reset-unpaid" onsubmit="return confirm('Koreksi tagihan menjadi BELUM LUNAS? Semua pembayaran aktif untuk faktur ini akan dibatalkan dan pendapatan kas terkait otomatis dikurangi. Nominal tagihan tidak berubah.')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="return_to" value="/invoices?<%= periodQueryString %>"><button class="ink-action-item compact warning" type="submit"><i class="bi bi-arrow-counterclockwise"></i><span><b>Jadikan Belum Lunas</b><small>Koreksi pembayaran & pendapatan otomatis</small></span></button></form><% } %>
                  <a class="ink-action-item compact" href="/invoices/<%= i.id %>/pdf" target="_blank"><i class="bi bi-file-earmark-pdf"></i><span><b>Lihat Faktur PDF</b><small>Buka di tab baru</small></span></a>
                  <a class="ink-action-item compact" href="/invoices/<%= i.id %>/pdf?download=1"><i class="bi bi-download"></i><span><b>Unduh PDF</b><small>Simpan faktur</small></span></a>
                  <a class="ink-action-item compact" href="/payments?q=<%= encodeURIComponent(i.invoice_number) %>"><i class="bi bi-clock-history"></i><span><b>Riwayat Pembayaran</b><small>Lihat transaksi</small></span></a>
                  <% if(wa){ %><a class="ink-action-item compact success" target="_blank" rel="noopener" href="https://wa.me/<%= wa %>?text=<%= encodeURIComponent(reminder) %>"><i class="bi bi-whatsapp"></i><span><b>Kirim Pengingat</b><small>WhatsApp pelanggan</small></span></a><% } %>
                  <% if(user.role==='admin' && Number(i.active_payment_count||0)===0 && Number(i.payment_count||0)>0 && i.status!=='cancelled'){ %><div class="ink-action-separator"></div><form method="post" action="/invoices/<%= i.id %>/cancel" onsubmit="return confirm('Batalkan tagihan <%= i.invoice_number %>? Tagihan akan dihapus dari outstanding, tetapi histori transaksi tetap disimpan untuk audit.')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="return_to" value="/invoices?<%= periodQueryString %>"><button class="ink-action-item compact danger" type="submit"><i class="bi bi-x-octagon"></i><span><b>Hapus / Batalkan Tagihan</b><small>Histori pembayaran tetap aman</small></span></button></form><% } %>
                  <% if(user.role==='admin' && Number(i.payment_count||0)===0 && Number(i.paid_amount)===0){ %><div class="ink-action-separator"></div><form method="post" action="/invoices/<%= i.id %>/delete" onsubmit="return confirm('Hapus permanen tagihan <%= i.invoice_number %>? Tagihan ini belum pernah memiliki transaksi pembayaran.')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="return_to" value="/invoices?<%= periodQueryString %>"><button class="ink-action-item compact danger" type="submit"><i class="bi bi-trash3"></i><span><b>Hapus Tagihan</b><small>Hanya jika belum pernah ada pembayaran</small></span></button></form><% } %>
                </div>
              </div>
            </td>
          </tr>
          <% }) %>
          <% if(!invoices.length){ %><tr><td colspan="10"><div class="empty-state"><i class="bi bi-receipt"></i><strong>Tidak ada tagihan pada filter ini</strong><small>Ubah periode/filter atau gunakan Refresh / Generate Tagihan.</small></div></td></tr><% } %>
        </tbody>
      </table>
    </div>
  </div>
</section>

<div class="modal fade" id="generateInvoiceModal" tabindex="-1">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <form method="post" action="/invoices/generate" class="modal-content">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="modal-header"><div><div class="module-kicker">PEMBUAT TAGIHAN</div><h5 class="modal-title">Refresh / Buat Tagihan</h5></div><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div>
      <div class="modal-body">
        <div class="generate-note"><i class="bi bi-shield-check"></i><div><strong>Idempotent - aman dijalankan ulang</strong><small>Pilih bulan/tahun lalu jalankan kapan saja untuk menangkap pelanggan baru. Tagihan existing, termasuk yang sudah LUNAS, tidak akan dibuat ulang atau di-reset.</small></div></div>
        <div class="row g-3 mt-1">
          <div class="col-md-4"><label class="form-label">Bulan</label><select class="form-select" name="month" required><% monthNames.forEach((m,i)=>{ %><option value="<%= i+1 %>" <%= filters.month===i+1?'selected':'' %>><%= m %></option><% }) %></select></div>
          <div class="col-md-4"><label class="form-label">Tahun</label><input class="form-control" type="number" name="year" min="2020" max="2100" value="<%= filters.year %>" required></div>
          <div class="col-md-4"><label class="form-label">Site (opsional)</label><select class="form-select" name="site"><option value="">Semua Site</option><% sites.forEach(s=>{ %><option value="<%= s.code %>" <%= filters.site===s.code?'selected':'' %>><%= s.code %></option><% }) %></select></div>
          <div class="col-md-4"><label class="form-label">Cluster (opsional)</label><select class="form-select" name="cluster_id"><option value="">Semua Cluster</option><% clusters.forEach(c=>{ %><option value="<%= c.id %>" <%= String(filters.cluster)===String(c.id)?'selected':'' %>><%= c.site_code %> · <%= c.name %></option><% }) %></select></div>
          <div class="col-12"><label class="form-label">Pelanggan</label><select class="form-select" name="customer_id"><option value="">Semua pelanggan aktif</option><% customers.forEach(c=>{ %><option value="<%= c.id %>"><%= c.site_code %> · Cluster <%= c.cluster_name||'-' %> · <%= c.customer_code %> · <%= c.name %></option><% }) %></select><div class="form-help">Kosongkan untuk refresh seluruh pelanggan aktif. Pelanggan dengan tanggal aktivasi setelah periode yang dipilih tidak akan ditagih.</div></div>
        </div>
      </div>
      <div class="modal-footer"><button type="button" class="btn-tech" data-bs-dismiss="modal">Batal</button><button class="btn-tech primary"><i class="bi bi-arrow-repeat"></i>Refresh / Generate</button></div>
    </form>
  </div>
</div>

<div class="modal fade" id="invoiceEditModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <form class="modal-content" id="invoiceEditForm" method="post">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="return_to" value="/invoices?<%= periodQueryString %>">
      <div class="modal-header"><div><div class="module-kicker">EDIT TAGIHAN</div><h5 class="modal-title">Perbaiki Metadata Tagihan</h5><small class="text-secondary" id="invoiceEditIdentity">-</small></div><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
      <div class="modal-body">
        <div class="invoice-edit-safety"><i class="bi bi-shield-lock-fill"></i><div><strong>Nominal dikunci</strong><small>Tanggal dan tipe dapat diedit tanpa mengubah nominal. Gunakan aksi “Jadikan Belum Lunas” untuk koreksi pembayaran yang salah.</small></div></div>
        <div class="row g-3 mt-1"><div class="col-md-6"><label class="form-label">Tanggal Faktur</label><input class="form-control" type="date" name="invoice_date" id="invoiceEditDate" required></div><div class="col-md-6"><label class="form-label">Jatuh Tempo</label><input class="form-control" type="date" name="due_date" id="invoiceEditDue" required></div><div class="col-12"><label class="form-label">Tipe Tagihan</label><select class="form-select" name="is_prorata" id="invoiceEditProrata"><option value="0">Bulanan</option><option value="1">Prorata</option></select></div></div>
      </div>
      <div class="modal-footer"><button type="button" class="btn-tech" data-bs-dismiss="modal">Batal</button><button class="btn-tech primary"><i class="bi bi-check2-circle"></i>Simpan Perubahan</button></div>
    </form>
  </div>
</div>

<%- include('../payments/_payment-modal',{openInvoices,staff,preselectedInvoiceId:null,returnTo:'/invoices?'+periodQueryString,autoOpenPaymentModal:false}) %>

<script>
(()=>{
  const tableChecks=[...document.querySelectorAll('[data-invoice-table-check]')];
  const paySelected=document.getElementById('paySelectedInvoices');
  const selectedCount=document.getElementById('invoiceTableSelectedCount');
  const refreshSelection=()=>{const ids=tableChecks.filter(x=>x.checked&&!x.disabled).map(x=>String(x.value));if(selectedCount)selectedCount.textContent=ids.length;if(paySelected)paySelected.disabled=!ids.length;return ids;};
  tableChecks.forEach(ch=>ch.addEventListener('change',refreshSelection));
  paySelected?.addEventListener('click',()=>{const ids=refreshSelection();if(!ids.length)return;const paymentModal=document.getElementById('paymentModal');if(!paymentModal)return;paymentModal.querySelectorAll('.payment-invoice-check').forEach(ch=>{ch.checked=ids.includes(String(ch.value));ch.dispatchEvent(new Event('change',{bubbles:true}));});bootstrap.Modal.getOrCreateInstance(paymentModal).show();});
  const editModal=document.getElementById('invoiceEditModal');
  editModal?.addEventListener('show.bs.modal',event=>{const b=event.relatedTarget;if(!b)return;document.getElementById('invoiceEditForm').action=`/invoices/${b.dataset.invoiceEditId}/update-meta`;document.getElementById('invoiceEditIdentity').textContent=`${b.dataset.invoiceEditNumber} · ${b.dataset.invoiceEditCustomer}`;document.getElementById('invoiceEditDate').value=b.dataset.invoiceEditDate||'';document.getElementById('invoiceEditDue').value=b.dataset.invoiceEditDue||'';document.getElementById('invoiceEditProrata').value=b.dataset.invoiceEditProrata||'0';});
  refreshSelection();
})();
</script>
