<section>
<div class="module-head"><div><div class="module-kicker">FIELD OPERATIONS</div><h1>Ticketing</h1><p>Keluhan pelanggan dan pekerjaan teknisi dengan priority, PIC, status, dan timer.</p></div><div class="module-actions"><button class="btn-tech primary" data-bs-toggle="modal" data-bs-target="#ticketModal"><i class="bi bi-plus-lg"></i>Buat Ticket</button></div></div>
<div class="metric-grid"><article class="metric-card red"><div class="metric-top"><span class="metric-label">Open</span><span class="metric-icon"><i class="bi bi-exclamation-diamond-fill"></i></span></div><strong><%= Number(stats.open_count||0) %></strong><small>Perlu ditangani</small></article><article class="metric-card orange"><div class="metric-top"><span class="metric-label">Progress</span><span class="metric-icon"><i class="bi bi-tools"></i></span></div><strong><%= Number(stats.progress_count||0) %></strong><small>Sedang dikerjakan</small></article><article class="metric-card"><div class="metric-top"><span class="metric-label">Pending</span><span class="metric-icon"><i class="bi bi-hourglass-split"></i></span></div><strong><%= Number(stats.pending_count||0) %></strong><small>Menunggu follow-up</small></article><article class="metric-card green"><div class="metric-top"><span class="metric-label">Closed</span><span class="metric-icon"><i class="bi bi-check2-circle"></i></span></div><strong><%= Number(stats.closed_count||0) %></strong><small>Selesai</small></article></div>
<form class="filter-card" method="get"><div class="filter-grid"><div class="filter-group"><label>STATUS</label><select class="form-select" name="status"><option value="">Semua Status</option><% ['open','progress','pending','closed'].forEach(v=>{ %><option value="<%= v %>" <%= filters.status===v?'selected':'' %>><%= v.toUpperCase() %></option><% }) %></select></div><div class="filter-group"><label>PRIORITY</label><select class="form-select" name="priority"><option value="">Semua Priority</option><% ['low','medium','high','critical'].forEach(v=>{ %><option value="<%= v %>" <%= filters.priority===v?'selected':'' %>><%= v.toUpperCase() %></option><% }) %></select></div><div class="d-flex align-items-end"><button class="btn-tech primary">Terapkan Filter</button></div></div></form>
<div class="data-card"><div class="data-card-head"><div><h3>Operation Tickets</h3><small>Tracking gangguan dan pekerjaan lapangan</small></div></div><div class="table-responsive"><table class="app-table"><thead><tr><th>Kode</th><th>Subject</th><th>Pelanggan</th><th>Priority</th><th>Status</th><th>PIC</th><th>Opened</th><th>Action</th></tr></thead><tbody><% tickets.forEach(t=>{ %><tr><td><span class="cell-main text-purple"><%= t.ticket_code %></span></td><td><span class="cell-main"><%= t.subject %></span><span class="cell-sub"><%= t.type %></span></td><td><span class="cell-main"><%= t.customer_name||'-' %></span><span class="cell-sub"><%= t.customer_code||'' %></span></td><td><span class="status-badge <%= t.priority==='critical'||t.priority==='high'?'red':t.priority==='medium'?'orange':'gray' %>"><%= t.priority %></span></td><td><span class="status-badge <%= t.status==='closed'?'green':t.status==='open'?'red':t.status==='progress'?'purple':'orange' %>"><%= t.status %></span></td><td><%= t.assigned_name||'Belum ditugaskan' %></td><td><span class="cell-main"><%= formatDate(t.opened_at) %></span></td><td><form method="post" action="/tickets/<%= t.id %>/status" class="d-flex gap-1"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><select class="form-select" name="status" style="min-height:34px;width:110px"><% ['open','progress','pending','closed'].forEach(v=>{ %><option value="<%= v %>" <%= t.status===v?'selected':'' %>><%= v %></option><% }) %></select><button class="action-menu"><i class="bi bi-check-lg"></i></button></form></td></tr><% }) %><% if(!tickets.length){%><tr><td colspan="8"><div class="empty-state"><i class="bi bi-life-preserver"></i><strong>Belum ada ticket</strong><small>Semua terlihat tenang. Buat ticket untuk pekerjaan baru.</small></div></td></tr><%}%></tbody></table></div></div>
</section>
<div class="modal fade" id="ticketModal" tabindex="-1"><div class="modal-dialog modal-lg modal-dialog-centered"><form class="modal-content" method="post" action="/tickets"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="modal-header"><div><div class="module-kicker">NEW OPERATION TICKET</div><h5 class="modal-title">Buat Ticket</h5></div><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="row g-3"><div class="col-md-6"><label class="form-label">Pelanggan</label><select class="form-select" name="customer_id"><option value="">Ticket internal / tanpa pelanggan</option><% customers.forEach(c=>{ %><option value="<%= c.id %>"><%= c.customer_code %> · <%= c.name %></option><% }) %></select></div><div class="col-md-6"><label class="form-label">PIC</label><select class="form-select" name="assigned_to"><option value="">Belum ditugaskan</option><% users.forEach(u=>{ %><option value="<%= u.id %>"><%= u.name %></option><% }) %></select></div><div class="col-12"><label class="form-label">Subject</label><input class="form-control" name="subject" required placeholder="Contoh: Migrasi pelanggan / Loss tinggi / Label ODP"></div><div class="col-md-6"><label class="form-label">Tipe Ticket</label><select class="form-select" name="type"><option>Gangguan Internet</option><option>Instalasi Baru</option><option>Migrasi</option><option>Maintenance</option><option>Audit Jaringan</option><option>Upgrade Bandwidth</option><option>Lainnya</option></select></div><div class="col-md-6"><label class="form-label">Priority</label><select class="form-select" name="priority"><option value="low">Low</option><option value="medium" selected>Medium</option><option value="high">High</option><option value="critical">Critical</option></select></div><div class="col-12"><label class="form-label">Deskripsi / Checklist</label><textarea class="form-control" name="description" rows="4"></textarea></div></div></div><div class="modal-footer"><button type="button" class="btn-tech" data-bs-dismiss="modal">Batal</button><button class="btn-tech primary">Buat Ticket</button></div></form></div></div>
