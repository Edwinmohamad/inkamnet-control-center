<section>
<div class="module-head"><div><div class="module-kicker"><%= customer?'CUSTOMER UPDATE':'NEW SUBSCRIBER' %></div><h1><%= customer?'Edit':'Tambah' %> Pelanggan</h1><p>Identitas, service plan, network mapping, dan billing preference.</p></div><div class="module-actions"><a class="btn-tech" href="/customers"><i class="bi bi-arrow-left"></i>Kembali</a></div></div>
<form method="post" action="<%= customer ? '/customers/'+customer.id : '/customers' %>" class="data-card"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
<div class="data-card-head"><div><h3>Customer Profile</h3><small>Field bertanda wajib harus diisi</small></div><span class="status-badge purple"><%= customer?.customer_code||'NEW' %></span></div>
<div class="data-card-body"><div class="row g-3">
<div class="col-md-4"><label class="form-label">Customer ID *</label><input class="form-control" name="customer_code" required value="<%= customer?.customer_code || '' %>" placeholder="KRW-15-001"></div>
<div class="col-md-8"><label class="form-label">Nama *</label><input class="form-control" name="name" required value="<%= customer?.name || '' %>"></div>
<div class="col-md-6"><label class="form-label">No. WhatsApp</label><input class="form-control" name="phone" value="<%= customer?.phone || '' %>" placeholder="628..."></div>
<div class="col-md-6"><label class="form-label">Email</label><input class="form-control" type="email" name="email" value="<%= customer?.email || '' %>"></div>
<div class="col-12"><label class="form-label">Alamat</label><textarea class="form-control" rows="3" name="address"><%= customer?.address || '' %></textarea></div>
</div><hr style="border-color:var(--line);margin:24px 0"><div class="module-kicker">SERVICE & NETWORK</div><div class="row g-3">
<div class="col-md-4"><label class="form-label">Site *</label><select class="form-select" name="site_id" required><% sites.forEach(s=>{ %><option value="<%= s.id %>" <%= String(customer?.site_id||'')===String(s.id)?'selected':'' %>><%= s.code %> · <%= s.name %></option><% }) %></select></div>
<div class="col-md-4"><label class="form-label">Paket *</label><select class="form-select" name="package_id" required><% packages.forEach(p=>{ %><option value="<%= p.id %>" <%= String(customer?.package_id||'')===String(p.id)?'selected':'' %>><%= p.name %> · <%= formatRupiah(p.price) %></option><% }) %></select></div>
<div class="col-md-4"><label class="form-label">Cluster / ODP</label><select class="form-select" name="cluster_id"><option value="">Belum dipilih</option><% clusters.forEach(cl=>{ %><option value="<%= cl.id %>" <%= String(customer?.cluster_id||'')===String(cl.id)?'selected':'' %>><%= cl.site_code %> · <%= cl.name %></option><% }) %></select></div>
<div class="col-md-6"><label class="form-label">Router MikroTik</label><select class="form-select" name="router_id"><option value="">Belum dipilih</option><% routers.forEach(r=>{ %><option value="<%= r.id %>" <%= String(customer?.router_id||'')===String(r.id)?'selected':'' %>><%= r.site_code %> · <%= r.name %></option><% }) %></select></div>
<div class="col-md-6"><label class="form-label">Username PPPoE</label><input class="form-control" name="pppoe_username" value="<%= customer?.pppoe_username || '' %>" placeholder="krw001"></div>
</div><hr style="border-color:var(--line);margin:24px 0"><div class="module-kicker">BILLING POLICY</div><div class="row g-3">
<div class="col-md-3"><label class="form-label">Aktif Sejak</label><input class="form-control" type="date" name="activation_date" value="<%= customer?.activation_date ? new Date(customer.activation_date).toISOString().slice(0,10) : '' %>"></div>
<div class="col-md-3"><label class="form-label">Jatuh Tempo</label><input class="form-control" type="number" min="1" max="28" name="due_day" value="<%= customer?.due_day || '' %>" placeholder="Default site"></div>
<div class="col-md-3"><label class="form-label">Grace Period</label><input class="form-control" type="number" min="0" max="30" name="grace_days" value="<%= customer?.grace_days ?? '' %>" placeholder="Default site"></div>
<div class="col-md-3"><label class="form-label">Status</label><select class="form-select" name="customer_status"><% ['active','suspended','terminated'].forEach(x=>{ %><option value="<%= x %>" <%= (customer?.customer_status||'active')===x?'selected':'' %>><%= x %></option><% }) %></select></div>
<div class="col-md-4"><div class="form-check form-switch mt-3"><input class="form-check-input" type="checkbox" name="prorata_enabled" id="prorata" <%= customer ? (customer.prorata_enabled?'checked':'') : 'checked' %>><label class="form-check-label" for="prorata">Prorata bulan pertama</label></div></div>
<div class="col-12"><label class="form-label">Catatan</label><textarea class="form-control" rows="3" name="notes"><%= customer?.notes || '' %></textarea></div>
</div><div class="mt-4 d-flex gap-2"><button class="btn-tech primary"><i class="bi bi-check2-circle"></i>Simpan Pelanggan</button><a href="/customers" class="btn-tech">Batal</a></div></div></form>
</section>
