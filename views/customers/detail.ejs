<section>
<div class="module-head"><div><div class="module-kicker">CUSTOMER 360</div><h1><%= customer.name %></h1><p><%= customer.customer_code %> · <%= customer.site_code %> · Cluster <%= customer.cluster_name||'-' %> · <%= customer.package_name %></p></div><div class="module-actions"><a class="btn-tech" href="/customers"><i class="bi bi-arrow-left"></i>Daftar</a><a class="btn-tech primary" href="/customers/<%= customer.id %>/edit"><i class="bi bi-pencil-square"></i>Edit</a></div></div>
<div class="metric-grid"><article class="metric-card"><div class="metric-top"><span class="metric-label">Paket</span><span class="metric-icon"><i class="bi bi-speedometer2"></i></span></div><strong><%= customer.package_name %></strong><small><%= formatRupiah(customer.package_price) %>/bulan</small></article><article class="metric-card <%= customer.network_status==='online'?'green':customer.network_status==='isolated'?'red':'' %>"><div class="metric-top"><span class="metric-label">Jaringan</span><span class="metric-icon"><i class="bi bi-wifi"></i></span></div><strong><%= statusLabel(customer.network_status) %></strong><small><%= customer.pppoe_username||'PPPoE belum diisi' %></small></article><article class="metric-card <%= customer.billing_status==='paid'?'green':'orange' %>"><div class="metric-top"><span class="metric-label">Tagihan</span><span class="metric-icon"><i class="bi bi-receipt"></i></span></div><strong><%= statusLabel(customer.billing_status) %></strong><small>Jatuh tempo tanggal <%= customer.due_day||'standar' %></small></article><article class="metric-card"><div class="metric-top"><span class="metric-label">Site</span><span class="metric-icon"><i class="bi bi-hdd-rack"></i></span></div><strong><%= customer.site_code %></strong><small>Cluster <%= customer.cluster_name||'-' %> · <%= customer.router_name||'Router belum dipilih' %></small></article></div>
<div class="row g-3"><div class="col-lg-4"><div class="data-card h-100"><div class="data-card-head"><div><h3>Profil Pelanggan</h3><small>Informasi subscriber</small></div></div><div class="data-card-body d-grid gap-3"><div><span class="cell-sub">WHATSAPP</span><span class="cell-main"><%= customer.phone||'-' %></span></div><div><span class="cell-sub">EMAIL</span><span class="cell-main"><%= customer.email||'-' %></span></div><div><span class="cell-sub">SALES</span><span class="cell-main"><%= customer.sales_name||'Direct / Tanpa Sales' %></span></div><div><span class="cell-sub">PPPOE</span><span class="cell-main text-purple"><%= customer.pppoe_username||'-' %></span></div><div><span class="cell-sub">ROUTER</span><span class="cell-main"><%= customer.router_name||'-' %></span></div><div><span class="cell-sub">ALAMAT</span><span class="cell-main"><%= customer.address||'-' %></span></div><% if(customer.router_id&&customer.pppoe_username){ %><div class="d-flex gap-2 flex-wrap mt-2"><form method="post" action="/network/<%= customer.id %>/check"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn-tech"><i class="bi bi-activity"></i>Cek PPPoE</button></form><form method="post" action="/network/<%= customer.id %>/isolate"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn-tech danger"><i class="bi bi-wifi-off"></i>Isolir</button></form><form method="post" action="/network/<%= customer.id %>/unisolate"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn-tech success"><i class="bi bi-wifi"></i>Buka</button></form></div><% } %></div></div></div><div class="col-lg-8"><div class="data-card h-100"><div class="data-card-head"><div><h3>Riwayat Tagihan</h3><small>Riwayat faktur pelanggan</small></div></div><div class="table-responsive"><table class="app-table"><thead><tr><th>Periode</th><th>Invoice</th><th>Total</th><th>Dibayar</th><th>Sisa</th><th>Status</th></tr></thead><tbody><% invoices.forEach(i=>{ %><tr><td><%= i.period_month %>/<%= i.period_year %></td><td class="text-purple"><%= i.invoice_number %></td><td class="money"><%= formatRupiah(i.total) %></td><td class="money text-success-soft"><%= formatRupiah(i.paid_amount) %></td><td class="money"><%= formatRupiah(i.outstanding) %></td><td><span class="status-badge <%= i.status==='paid'?'green':i.status==='overdue'?'red':'orange' %>"><%= statusLabel(i.status) %></span></td></tr><% }) %><% if(!invoices.length){%><tr><td colspan="6"><div class="empty-state"><i class="bi bi-receipt"></i><strong>Belum ada invoice</strong><small>Riwayat akan muncul setelah billing dibuat.</small></div></td></tr><%}%></tbody></table></div></div></div></div>
</section>
