<section><div class="module-head"><div><div class="module-kicker">MULTI-SITE CORE</div><h1>Lokasi Server / POP</h1><p>Kelola struktur KRW, CLM, KBG atau site baru beserta default billing.</p></div><div class="module-actions"><button class="btn-tech primary" data-bs-toggle="modal" data-bs-target="#siteModal"><i class="bi bi-plus-lg"></i>Tambah Site</button></div></div>
<div class="data-card"><div class="data-card-head"><div><h3>Site Registry</h3><small>Company → Site → Router → Pelanggan</small></div></div><div class="table-responsive"><table class="app-table"><thead><tr><th>Code</th><th>Nama</th><th>Pelanggan</th><th>Router</th><th>Due Day</th><th>Grace</th><th>Generate H-</th><th>Status</th></tr></thead><tbody><% sites.forEach(s=>{ %><tr><td><span class="status-badge purple"><%= s.code %></span></td><td><span class="cell-main"><%= s.name %></span><span class="cell-sub"><%= s.address||'-' %></span></td><td><%= s.customers %></td><td><%= s.routers %></td><td><%= s.default_due_day??'company' %></td><td><%= s.default_grace_days??'company' %></td><td><%= s.invoice_generate_days??'company' %></td><td><span class="status-badge <%= s.is_active?'green':'gray' %>"><%= s.is_active?'aktif':'nonaktif' %></span></td></tr><% }) %></tbody></table></div></div></section>
<div class="modal fade" id="siteModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><form class="modal-content" method="post" action="/sites"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="modal-header"><h5 class="modal-title">Tambah Lokasi Server</h5><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="row g-3"><div class="col-4"><label class="form-label">Code</label><input class="form-control" name="code" maxlength="20" required placeholder="KBG"></div><div class="col-8"><label class="form-label">Nama</label><input class="form-control" name="name" required></div><div class="col-12"><label class="form-label">Alamat</label><textarea class="form-control" name="address"></textarea></div><div class="col-4"><label class="form-label">Due Day</label><input class="form-control" type="number" min="1" max="28" name="default_due_day"></div><div class="col-4"><label class="form-label">Grace</label><input class="form-control" type="number" min="0" max="30" name="default_grace_days"></div><div class="col-4"><label class="form-label">Generate H-</label><input class="form-control" type="number" min="0" max="30" name="invoice_generate_days"></div></div></div><div class="modal-footer"><button class="btn-tech primary">Simpan Site</button></div></form></div></div>
