<!doctype html>
<html lang="id" data-theme="dark">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#070a13">
  <title>Login · INKAMNET Control Center</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"><link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <style>
  :root{--p:#603aea;--p2:#7d5af2;--r:#ff433e;--s:#2ed6a1;--ink:#080b14}*{box-sizing:border-box}html,body{margin:0;min-height:100%;font-family:Inter,system-ui,sans-serif}body{min-height:100vh;background:#070a13;color:#fff;overflow:hidden}.login-shell{min-height:100vh;display:grid;grid-template-columns:minmax(0,1.2fr) minmax(430px,.8fr)}
  .visual{position:relative;display:flex;flex-direction:column;justify-content:space-between;padding:38px 54px 36px;background:radial-gradient(circle at 23% 19%,rgba(96,58,234,.24),transparent 30%),radial-gradient(circle at 86% 78%,rgba(255,67,62,.12),transparent 23%),linear-gradient(145deg,#070a12,#09101f 63%,#0a1324);overflow:hidden}.grid{position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,.025) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.025) 1px,transparent 1px);background-size:46px 46px;mask-image:radial-gradient(circle at 30% 50%,#000 18%,transparent 85%)}.scan{position:absolute;left:0;right:0;top:-30%;height:22%;background:linear-gradient(transparent,rgba(96,58,234,.07),rgba(255,67,62,.025),transparent);filter:blur(2px);animation:scan 8.5s linear infinite}.data-line{position:absolute;width:1px;height:42vh;top:-45vh;background:linear-gradient(transparent,rgba(96,58,234,.45),transparent);animation:dataDrop 10s linear infinite}.data-line.a{left:18%;animation-delay:-2s}.data-line.b{left:63%;animation-delay:-6s;animation-duration:13s}.data-line.c{left:88%;animation-delay:-8s;animation-duration:11s}.visual>*{position:relative;z-index:2}.visual>.grid,.visual>.scan,.visual>.data-line{position:absolute;z-index:1}
  .brand-stage{width:min(610px,78%);position:relative;padding:18px 8px 8px;isolation:isolate}.brand-stage::before,.brand-stage::after{content:"";position:absolute;border-radius:50%;pointer-events:none}.brand-stage::before{width:390px;height:390px;left:-145px;top:-138px;border:1px solid rgba(96,58,234,.16);box-shadow:inset 0 0 80px rgba(96,58,234,.035);animation:ringBreath 5s ease-in-out infinite}.brand-stage::after{width:215px;height:215px;left:-58px;top:-50px;border:1px dashed rgba(255,67,62,.18);animation:ringSpin 22s linear infinite}.brand-stage img{display:block;width:100%;height:auto;image-rendering:auto;transform:translateZ(0);will-change:transform,filter;filter:drop-shadow(0 16px 36px rgba(96,58,234,.20));animation:logoFloat 5s ease-in-out infinite}.brand-beam{position:absolute;left:7%;right:2%;bottom:1px;height:1px;background:linear-gradient(90deg,transparent,var(--p),var(--r),transparent);box-shadow:0 0 18px rgba(96,58,234,.65);animation:beamPulse 2.8s ease-in-out infinite}.brand-tagline{margin:8px 0 0 11px;color:#aab2c3;font-size:.64rem;letter-spacing:.12em;font-weight:700}.brand-tagline b{color:#fff}.hero{max-width:760px}.eyebrow{display:flex;align-items:center;gap:8px;color:#b29fff;font-size:.63rem;font-weight:850;letter-spacing:.16em}.eyebrow span{width:7px;height:7px;border-radius:50%;background:var(--s);box-shadow:0 0 0 5px rgba(46,214,161,.08);animation:pulse 2s infinite}.hero h1{font-family:"Space Grotesk",sans-serif;font-size:clamp(2.7rem,5vw,5.2rem);line-height:.94;letter-spacing:-.065em;margin:17px 0 18px}.hero h1 b{font-weight:700;background:linear-gradient(90deg,#b9a8ff 3%,#f5f4ff 52%,#ff8e88);-webkit-background-clip:text;background-clip:text;color:transparent}.hero p{max-width:650px;color:#939db1;line-height:1.75;font-size:.86rem}.chips{display:flex;flex-wrap:wrap;gap:8px;margin-top:21px}.chips span{padding:7px 10px;border:1px solid rgba(255,255,255,.075);border-radius:999px;background:rgba(255,255,255,.03);color:#aeb7c8;font-size:.56rem;backdrop-filter:blur(12px)}.systembar{width:min(690px,96%);padding:12px 14px;border:1px solid rgba(255,255,255,.075);border-radius:14px;background:rgba(255,255,255,.033);backdrop-filter:blur(18px);display:flex;align-items:center;justify-content:space-between;gap:10px}.systems{display:flex;gap:14px;flex-wrap:wrap}.sys{display:flex;align-items:center;gap:6px;color:#aeb7c7;font-size:.52rem}.sys i{width:6px;height:6px;border-radius:50%;background:var(--s);box-shadow:0 0 10px rgba(46,214,161,.6)}.systembar small{color:#66728a;font-size:.51rem}
  .panel{position:relative;display:grid;place-items:center;padding:34px;background:radial-gradient(circle at 92% 2%,rgba(96,58,234,.11),transparent 26%),radial-gradient(circle at 10% 94%,rgba(255,67,62,.035),transparent 25%),#f7f7fb;color:#17192b}.panel::before{content:"";position:absolute;left:0;top:8%;bottom:8%;width:1px;background:linear-gradient(transparent,rgba(96,58,234,.34),rgba(255,67,62,.18),transparent)}.panel::after{content:"";position:absolute;inset:18px;border:1px solid rgba(96,58,234,.045);border-radius:24px;pointer-events:none}.login-box{width:min(432px,100%);animation:enter .58s cubic-bezier(.2,.8,.2,1) both}.mobile-logo{display:none}.kicker{color:#6b42e7;font-size:.59rem;font-weight:900;letter-spacing:.15em}.login-box h2{font-family:"Space Grotesk";font-size:2.05rem;letter-spacing:-.05em;margin:8px 0}.sub{color:#7b8597;font-size:.75rem;margin-bottom:22px}.cardx{position:relative;padding:27px;border:1px solid #e4e5ed;border-radius:21px;background:rgba(255,255,255,.95);box-shadow:0 30px 90px rgba(33,30,70,.14);overflow:hidden}.cardx::before{content:"";position:absolute;left:0;right:0;top:0;height:2px;background:linear-gradient(90deg,var(--p),var(--p2),var(--r))}.cardx::after{content:"";position:absolute;width:130px;height:130px;border-radius:50%;right:-70px;top:-75px;background:var(--p);filter:blur(45px);opacity:.08}.form-label{font-size:.62rem;font-weight:800;color:#596479}.input-wrap{height:49px;display:flex;align-items:center;border:1px solid #dce0ea;border-radius:12px;background:#fbfbfe;overflow:hidden;transition:.18s}.input-wrap:focus-within{border-color:rgba(96,58,234,.56);box-shadow:0 0 0 4px rgba(96,58,234,.075)}.input-wrap i{width:46px;text-align:center;color:#8994a6}.input-wrap input{flex:1;height:100%;border:0;outline:0;background:transparent;padding:0 12px 0 0;color:#17192b;font-size:.77rem}.btn-login{height:49px;border:0;border-radius:12px;background:linear-gradient(135deg,#603aea,#7650ee 72%,#ff433e 170%);font-weight:850;font-size:.71rem;box-shadow:0 14px 34px rgba(96,58,234,.27);transition:.2s}.btn-login:hover{transform:translateY(-1px);box-shadow:0 19px 42px rgba(96,58,234,.34)}.secure{margin-top:15px;text-align:center;color:#9ba3b2;font-size:.54rem}.foot{text-align:center;color:#a0a7b5;font-size:.53rem;margin-top:17px}.foot b{color:#603aea}.loader-line{height:3px;width:0;position:fixed;left:0;top:0;background:linear-gradient(90deg,var(--p),#8963f0,var(--r));box-shadow:0 0 16px rgba(96,58,234,.55);z-index:10;transition:.3s}
  @keyframes enter{from{opacity:0;transform:translateY(13px) scale(.99)}to{opacity:1;transform:none}}@keyframes scan{to{transform:translateY(650%)}}@keyframes pulse{0%{box-shadow:0 0 0 0 rgba(46,214,161,.32)}70%{box-shadow:0 0 0 8px rgba(46,214,161,0)}100%{box-shadow:0 0 0 0 rgba(46,214,161,0)}}@keyframes logoFloat{0%,100%{transform:translate3d(0,0,0) rotate(-.15deg)}50%{transform:translate3d(0,-8px,0) rotate(.15deg);filter:drop-shadow(0 24px 46px rgba(96,58,234,.28))}}@keyframes ringBreath{50%{transform:scale(1.06);border-color:rgba(96,58,234,.26)}}@keyframes ringSpin{to{transform:rotate(360deg)}}@keyframes beamPulse{50%{opacity:.35;transform:scaleX(.86)}}@keyframes dataDrop{to{transform:translateY(165vh)}}
  @media(max-width:980px){body{overflow:auto}.login-shell{grid-template-columns:1fr}.visual{display:none}.panel{min-height:100vh;padding:22px}.mobile-logo{display:block;width:min(310px,82%);margin:0 auto 28px;position:relative}.mobile-logo img{width:100%;height:auto;image-rendering:auto;animation:logoFloat 5s ease-in-out infinite}.login-box h2,.kicker,.sub{text-align:center}}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
  </style>
</head>
<body><div class="loader-line" id="loginLoader"></div><div class="login-shell">
<section class="visual"><div class="grid"></div><div class="scan"></div><i class="data-line a"></i><i class="data-line b"></i><i class="data-line c"></i>
  <div class="brand-stage"><img src="/img/inkamnet-wordmark-hq.png?v=1.2.1" alt="INKAMNET"><span class="brand-beam"></span><div class="brand-tagline"><b>FROM THE VILLAGE</b> · ONLINE EVERYWHERE</div></div>
  <div class="hero"><div class="eyebrow"><span></span> NETWORK · BILLING · FINANCE · WAREHOUSE</div><h1>Operate smarter.<br><b>Scale with control.</b></h1><p>Control center untuk pelanggan, MikroTik, billing, pembayaran, ticketing, gudang, teknisi, dan arus kas dalam satu workspace yang cepat dan terstruktur.</p><div class="chips"><span>Multi-Site</span><span>MikroTik NOC</span><span>Billing Engine</span><span>Cash Reconciliation</span><span>Warehouse</span><span>Field Ops</span></div></div>
  <div class="systembar"><div class="systems"><span class="sys"><i></i>NETWORK</span><span class="sys"><i></i>BILLING</span><span class="sys"><i></i>DATABASE</span><span class="sys"><i></i>AUTOMATION</span></div><small>Asia/Jakarta · Secure Access</small></div>
</section>
<section class="panel"><div class="login-box"><div class="mobile-logo"><img src="/img/inkamnet-wordmark-hq.png?v=1.2.1" alt="INKAMNET"></div><div class="kicker">SECURE CONTROL CENTER</div><h2>Welcome back.</h2><div class="sub">Masuk untuk melanjutkan operasional INKAMNET.</div><div class="cardx"><% if(typeof error !== 'undefined'){%><div class="alert alert-danger rounded-3 small"><i class="bi bi-exclamation-circle-fill me-2"></i><%= error %></div><%}%><form method="post" action="/login" id="loginForm"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="mb-3"><label class="form-label">USERNAME</label><div class="input-wrap"><i class="bi bi-person"></i><input name="username" placeholder="Masukkan username" required autofocus></div></div><div class="mb-4"><label class="form-label">PASSWORD</label><div class="input-wrap"><i class="bi bi-shield-lock"></i><input type="password" name="password" placeholder="Masukkan password" required></div></div><button class="btn btn-primary btn-login w-100">Masuk ke Control Center <i class="bi bi-arrow-right ms-2"></i></button></form><div class="secure"><i class="bi bi-lock-fill me-1"></i> Protected session · internal system</div></div><div class="foot">PT INKAMNET NEXERA TECHNOLOGY · <b>From the Village, Online Everywhere</b></div></div></section>
</div><script>document.getElementById('loginForm')?.addEventListener('submit',()=>{const l=document.getElementById('loginLoader');l.style.width='76%';setTimeout(()=>l.style.width='100%',430)});</script></body></html>
