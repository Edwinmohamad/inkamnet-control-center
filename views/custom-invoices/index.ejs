<section><div class="module-head"><div><div class="module-kicker">AD-HOC BILLING</div><h1>Faktur Custom</h1><p>Invoice non-bulanan untuk instalasi, material, jasa, atau transaksi khusus.</p></div><div class="module-actions"><button class="btn-tech primary" data-bs-toggle="modal" data-bs-target="#customModal"><i class="bi bi-file-earmark-plus-fill"></i>Buat Faktur</button></div></div>
<div class="data-card"><div class="data-card-head"><div><h3>Custom Invoice Registry</h3><small>Terpisah dari invoice langganan bulanan</small></div></div><div class="table-responsive"><table class="app-table"><thead><tr><th>Invoice</th><th>Customer</th><th>Tanggal</th><th>Jatuh Tempo</th><th>Total</th><th>Status</th></tr></thead><tbody><% invoices.forEach(i=>{ %><tr><td class="text-purple"><%= i.invoice_number %></td><td><span class="cell-main"><%= i.customer_name %></span><span class="cell-sub"><%= i.customer_code||'CUSTOM' %></span></td><td><%= formatDate(i.invoice_date) %></td><td><%= formatDate(i.due_date) %></td><td class="money"><%= formatRupiah(i.total) %></td><td><span class="status-badge <%= i.status==='paid'?'green':i.status==='sent'?'purple':i.status==='cancelled'?'red':'gray' %>"><%= i.status %></span></td></tr><% }) %><% if(!invoices.length){%><tr><td colspan="6"><div class="empty-state"><i class="bi bi-file-earmark-text"></i><strong>Belum ada faktur custom</strong><small>Buat untuk biaya instalasi atau transaksi non-bulanan.</small></div></td></tr><%}%></tbody></table></div></div></section>
<div class="modal fade" id="customModal" tabindex="-1"><div class="modal-dialog modal-lg modal-dialog-centered"><form class="modal-content" method="post" action="/custom-invoices"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="modal-header"><h5 class="modal-title">Buat Faktur Custom</h5><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="row g-3"><div class="col-md-6"><label class="form-label">Pelanggan Terdaftar</label><select class="form-select" name="customer_id"><option value="">Tidak dipilih</option><% customers.forEach(c=>{ %><option value="<%= c.id %>"><%= c.customer_code %> · <%= c.name %></option><% }) %></select></div><div class="col-md-6"><label class="form-label">Nama Customer Manual</label><input class="form-control" name="customer_name" placeholder="Jika bukan pelanggan"></div><div class="col-md-4"><label class="form-label">Tanggal</label><input class="form-control" type="date" name="invoice_date" required></div><div class="col-md-4"><label class="form-label">Jatuh Tempo</label><input class="form-control" type="date" name="due_date"></div><div class="col-md-4"><label class="form-label">Total</label><input class="form-control" type="number" name="total" required></div><div class="col-12"><label class="form-label">Deskripsi</label><textarea class="form-control" name="description" rows="3"></textarea></div></div></div><div class="modal-footer"><button class="btn-tech primary">Buat Faktur</button></div></form></div></div>
