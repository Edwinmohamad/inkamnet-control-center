<section><div class="module-head"><div><div class="module-kicker">SUPPLY CHAIN</div><h1>Supplier Gudang</h1><p>Data vendor material dan perangkat untuk pembelian stock.</p></div><div class="module-actions"><a href="/inventory" class="btn-tech"><i class="bi bi-box-seam"></i>Stock</a><button class="btn-tech primary" data-bs-toggle="modal" data-bs-target="#supplierModal"><i class="bi bi-plus-lg"></i>Tambah Supplier</button></div></div>
<div class="data-card"><div class="data-card-head"><div><h3>Supplier Directory</h3><small>Kontak supplier dan jumlah item yang terkait.</small></div><div class="warehouse-tabs"><a href="/inventory">Stock</a><a href="/inventory/movements">Movement</a><a href="/inventory/usage">Usage</a><a class="active" href="/inventory/suppliers">Supplier</a></div></div><div class="table-responsive"><table class="app-table"><thead><tr><th>Supplier</th><th>Phone</th><th>Email</th><th>Alamat</th><th>Item</th><th>Status</th><th></th></tr></thead><tbody><% suppliers.forEach(s=>{ %><tr><td><span class="cell-main"><%= s.name %></span><span class="cell-sub"><%= s.notes||'-' %></span></td><td><%= s.phone||'-' %></td><td><%= s.email||'-' %></td><td><%= s.address||'-' %></td><td><%= s.item_count %> SKU</td><td><span class="status-badge <%= s.is_active?'green':'red' %>"><%= statusLabel(s.is_active?'active':'inactive') %></span></td><td><div class="d-flex gap-1"><button class="action-menu" type="button" title="Edit" data-bs-toggle="modal" data-bs-target="#editSupplier<%= s.id %>"><i class="bi bi-pencil-square"></i></button><form method="post" action="/inventory/suppliers/<%= s.id %>/toggle"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="action-menu" title="Aktif/Nonaktif"><i class="bi bi-power"></i></button></form></div></td></tr><% }) %><% if(!suppliers.length){ %><tr><td colspan="7"><div class="empty-state"><i class="bi bi-truck"></i><strong>Belum ada supplier</strong><small>Tambahkan vendor material untuk melengkapi warehouse workflow.</small></div></td></tr><% } %></tbody></table></div></div></section>
<div class="modal fade" id="supplierModal" tabindex="-1"><div class="modal-dialog modal-lg modal-dialog-centered"><form method="post" action="/inventory/suppliers" class="modal-content"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="modal-header"><div><div class="module-kicker">NEW SUPPLIER</div><h5 class="modal-title">Tambah Supplier</h5></div><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="row g-3"><div class="col-md-6"><label class="form-label">Nama Supplier</label><input class="form-control" name="name" required></div><div class="col-md-3"><label class="form-label">Phone</label><input class="form-control" name="phone"></div><div class="col-md-3"><label class="form-label">Email</label><input class="form-control" name="email"></div><div class="col-12"><label class="form-label">Alamat</label><textarea class="form-control" name="address" rows="2"></textarea></div><div class="col-12"><label class="form-label">Catatan</label><textarea class="form-control" name="notes" rows="2"></textarea></div></div></div><div class="modal-footer"><button class="btn-tech" type="button" data-bs-dismiss="modal">Batal</button><button class="btn-tech primary">Simpan Supplier</button></div></form></div></div>
<% suppliers.forEach(s=>{ %><div class="modal fade" id="editSupplier<%= s.id %>" tabindex="-1"><div class="modal-dialog modal-lg modal-dialog-centered"><form method="post" action="/inventory/suppliers/<%= s.id %>/edit" class="modal-content"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="modal-header"><h5 class="modal-title">Edit Supplier · <%= s.name %></h5><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="row g-3"><div class="col-md-6"><label class="form-label">Nama Supplier</label><input class="form-control" name="name" value="<%= s.name %>" required></div><div class="col-md-3"><label class="form-label">Phone</label><input class="form-control" name="phone" value="<%= s.phone||'' %>"></div><div class="col-md-3"><label class="form-label">Email</label><input class="form-control" name="email" value="<%= s.email||'' %>"></div><div class="col-12"><label class="form-label">Alamat</label><textarea class="form-control" name="address" rows="2"><%= s.address||'' %></textarea></div><div class="col-12"><label class="form-label">Catatan</label><textarea class="form-control" name="notes" rows="2"><%= s.notes||'' %></textarea></div></div></div><div class="modal-footer"><button type="button" class="btn-tech" data-bs-dismiss="modal">Batal</button><button class="btn-tech primary">Simpan Perubahan</button></div></form></div></div><% }) %>
