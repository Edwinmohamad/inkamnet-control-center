<section>
  <div class="module-head">
    <div><div class="module-kicker">PAYMENT COLLECTION</div><h1>Pembayaran Pelanggan</h1><p>Kelola pembayaran satu atau banyak faktur, bukti transfer, cash ke tim, dan verifikasi dalam satu alur.</p></div>
    <div class="module-actions"><a class="btn-tech" href="/payments/reconciliation"><i class="bi bi-arrow-left-right"></i>Rekonsiliasi Cash</a><button class="btn-tech primary" data-bs-toggle="modal" data-bs-target="#paymentModal"><i class="bi bi-plus-lg"></i>Catat Pembayaran</button></div>
  </div>

  <div class="metric-grid">
    <article class="metric-card green"><div class="metric-top"><span class="metric-label">Pembayaran Terkonfirmasi</span><span class="metric-icon"><i class="bi bi-patch-check-fill"></i></span></div><strong><%= formatRupiah(summary.confirmed_total||0) %></strong><small>Bulan berjalan</small></article>
    <article class="metric-card orange"><div class="metric-top"><span class="metric-label">Cash di Tim</span><span class="metric-icon"><i class="bi bi-person-badge-fill"></i></span></div><strong><%= formatRupiah(summary.cash_held||0) %></strong><small>Belum disetor ke kas perusahaan</small></article>
    <article class="metric-card red"><div class="metric-top"><span class="metric-label">Transfer Pending</span><span class="metric-icon"><i class="bi bi-bank2"></i></span></div><strong><%= formatRupiah(summary.transfer_pending||0) %></strong><small>Termasuk transfer yang bukti TF belum diupload</small></article>
    <article class="metric-card"><div class="metric-top"><span class="metric-label">Faktur Terbuka</span><span class="metric-icon"><i class="bi bi-hourglass-split"></i></span></div><strong><%= openInvoices.length %></strong><small>Siap menerima pembayaran</small></article>
  </div>

  <form class="filter-card" method="get" action="/payments">
    <div class="toolbar"><div class="toolbar-left"><div class="search-box" style="min-width:min(520px,80vw)"><i class="bi bi-search"></i><input name="q" value="<%= filters.q %>" placeholder="Cari nama pelanggan, Customer ID, faktur, referensi, site atau cluster..."></div><button class="btn-tech primary"><i class="bi bi-search"></i>Cari</button><% if(filters.q){ %><a class="btn-tech" href="/payments"><i class="bi bi-x-lg"></i>Reset</a><% } %></div><div class="toolbar-right"><span class="status-badge purple"><%= payments.length %> hasil</span></div></div>
  </form>

  <div class="data-card">
    <div class="data-card-head"><div><h3>Riwayat Pembayaran</h3><small>Bukti tersimpan privat. Transfer tanpa bukti diberi status “Belum ada bukti TF”.</small></div><div class="legend-inline"><span><i class="dot success"></i>Terkonfirmasi</span><span><i class="dot warning"></i>Menunggu</span><span><i class="dot brand"></i>Cash di staff</span></div></div>
    <div class="table-responsive">
      <table class="app-table">
        <thead><tr><th>Pelanggan</th><th>Site / Cluster</th><th>Faktur</th><th>Nominal</th><th>Metode</th><th>Bukti TF</th><th>Diterima Oleh</th><th>Status Dana</th><th>Waktu</th><th>Aksi</th></tr></thead>
        <tbody>
          <% payments.forEach(p=>{ %>
          <tr>
            <td><span class="cell-main"><%= p.customer_name %></span><span class="cell-sub"><%= p.customer_code %></span></td>
            <td><span class="cell-main"><%= p.site_code %></span><span class="cell-sub">Cluster <%= p.cluster_name||'-' %></span></td>
            <td><a class="invoice-number-link" href="/invoices/<%= p.invoice_id %>/pdf" target="_blank"><i class="bi bi-file-earmark-pdf"></i><%= p.invoice_number %></a><span class="cell-sub"><%= p.reference||'-' %></span></td>
            <td class="money"><%= formatRupiah(p.amount) %></td>
            <td><span class="payment-method <%= p.method %>"><i class="bi <%= p.method==='cash'?'bi-cash-coin':p.method==='transfer'?'bi-bank':'bi-wallet2' %>"></i><%= p.method==='cash'?'CASH':p.method==='transfer'?'TRANSFER':String(p.method).toUpperCase() %></span></td>
            <td>
              <% if(p.proof_path){ %><button type="button" class="proof-chip proof-view-btn" data-bs-toggle="modal" data-bs-target="#proofViewerModal" data-proof-url="/payments/<%= p.id %>/proof" data-proof-mime="<%= p.proof_mime||'' %>" data-customer="<%= p.customer_name %>" data-customer-code="<%= p.customer_code %>" data-invoice="<%= p.invoice_number %>" data-amount="<%= formatRupiah(p.amount) %>" data-bank="<%= p.bank_name||'-' %>" data-reference="<%= p.reference||'-' %>" data-uploader="<%= p.proof_uploader_name||'-' %>" data-uploaded="<%= p.proof_uploaded_at?new Date(p.proof_uploaded_at).toLocaleString('id-ID',{timeZone:'Asia/Jakarta'}):'-' %>" data-status="<%= p.status %>"><span class="proof-chip-icon"><i class="bi <%= p.proof_mime==='application/pdf'?'bi-file-earmark-pdf-fill':'bi-image-fill' %>"></i></span><span><strong>Lihat Bukti</strong><small><%= p.proof_mime==='application/pdf'?'PDF':'Foto' %></small></span></button>
              <% } else if(p.method==='transfer'){ %><span class="proof-missing proof-missing-strong"><i class="bi bi-exclamation-triangle-fill"></i>Belum ada bukti TF</span>
              <% } else { %><span class="text-secondary small">—</span><% } %>
            </td>
            <td><%= p.collector_name||'-' %></td>
            <td><% if(p.status==='pending'){ %><span class="status-badge orange">menunggu verifikasi</span><% } else if(p.method==='cash'&&p.settlement_status==='held_by_staff'){ %><span class="status-badge purple">cash di staff</span><% } else if(p.method==='cash'&&p.settlement_status==='settled'){ %><span class="status-badge green">sudah disetor</span><% } else { %><span class="status-badge green">terkonfirmasi</span><% } %></td>
            <td><span class="cell-main"><%= new Date(p.paid_at).toLocaleDateString('id-ID',{timeZone:'Asia/Jakarta'}) %></span><span class="cell-sub"><%= new Date(p.paid_at).toLocaleTimeString('id-ID',{hour:'2-digit',minute:'2-digit',timeZone:'Asia/Jakarta'}) %></span></td>
            <td><div class="payment-actions"><% if(p.status==='pending'&&user.role==='admin'){ %><form method="post" action="/payments/<%= p.id %>/verify" class="d-inline"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="return_to" value="/payments<%= filters.q?'?q='+encodeURIComponent(filters.q):'' %>"><button class="action-pill success" title="Verifikasi pembayaran" <%= p.method==='transfer'&&!p.proof_path?'disabled':'' %>><i class="bi bi-check2-circle"></i></button></form><% } %><% if((user.role==='admin'||Number(p.received_by)===Number(user.id)||Number(p.collector_user_id)===Number(user.id))&&p.method!=='cash'){ %><button type="button" class="action-pill proof-upload-btn" title="<%= p.proof_path?'Ganti bukti':'Upload bukti TF' %>" data-bs-toggle="modal" data-bs-target="#proofUploadModal" data-payment-id="<%= p.id %>" data-customer="<%= p.customer_name %>" data-invoice="<%= p.invoice_number %>"><i class="bi bi-cloud-arrow-up"></i></button><% } %><% if(p.proof_path){ %><a class="action-pill" href="/payments/<%= p.id %>/proof" target="_blank" rel="noopener" title="Buka bukti"><i class="bi bi-box-arrow-up-right"></i></a><% } %></div></td>
          </tr>
          <% }) %>
          <% if(!payments.length){ %><tr><td colspan="10"><div class="empty-state"><i class="bi bi-wallet2"></i><strong>Data pembayaran tidak ditemukan</strong><small>Ubah kata pencarian atau catat pembayaran baru.</small></div></td></tr><% } %>
        </tbody>
      </table>
    </div>
  </div>
</section>

<%- include('_payment-modal',{openInvoices,staff,preselectedInvoiceId,returnTo:'/payments'+(filters.q?'?q='+encodeURIComponent(filters.q):''),autoOpenPaymentModal:!!preselectedInvoiceId}) %>

<div class="modal fade" id="proofViewerModal" tabindex="-1"><div class="modal-dialog modal-xl modal-dialog-centered"><div class="modal-content proof-viewer-modal"><div class="modal-header"><div><div class="module-kicker">BUKTI PEMBAYARAN</div><h5 class="modal-title">Bukti Pembayaran</h5></div><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body proof-viewer-grid"><div class="proof-stage"><div class="proof-stage-grid"></div><img id="proofViewerImage" alt="Bukti pembayaran" class="d-none"><iframe id="proofViewerPdf" title="Bukti pembayaran PDF" class="d-none"></iframe><div id="proofViewerLoading" class="proof-loading"><span class="proof-scan"></span><i class="bi bi-shield-lock-fill"></i><strong>Secure Payment Evidence</strong><small>Memuat bukti pembayaran...</small></div></div><aside class="proof-meta-panel"><div class="proof-verified-seal" id="proofStatusSeal"><i class="bi bi-patch-check-fill"></i><span>PAYMENT</span><strong>CONFIRMED</strong></div><div class="proof-meta-list"><div><span>Pelanggan</span><strong id="proofMetaCustomer">-</strong><small id="proofMetaCode">-</small></div><div><span>Faktur</span><strong id="proofMetaInvoice">-</strong></div><div><span>Nominal</span><strong id="proofMetaAmount">-</strong></div><div><span>Bank</span><strong id="proofMetaBank">-</strong></div><div><span>Referensi</span><strong id="proofMetaReference">-</strong></div><div><span>Diupload Oleh</span><strong id="proofMetaUploader">-</strong><small id="proofMetaUploaded">-</small></div></div><a id="proofOpenNew" class="btn-tech w-100 justify-content-center" target="_blank" rel="noopener"><i class="bi bi-box-arrow-up-right"></i>Buka File Asli</a></aside></div></div></div></div>

<div class="modal fade" id="proofUploadModal" tabindex="-1"><div class="modal-dialog modal-lg modal-dialog-centered"><form method="post" enctype="multipart/form-data" class="modal-content" id="proofReplaceForm"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="return_to" value="/payments<%= filters.q?'?q='+encodeURIComponent(filters.q):'' %>"><div class="modal-header"><div><div class="module-kicker">UPLOAD BUKTI</div><h5 class="modal-title">Upload / Ganti Bukti TF</h5></div><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="proof-payment-context"><i class="bi bi-receipt-cutoff"></i><div><strong id="proofUploadCustomer">-</strong><small id="proofUploadInvoice">-</small></div></div><label class="proof-dropzone large mt-3"><input id="replacement_proof_file" type="file" name="proof_file" accept="image/jpeg,image/png,image/webp,application/pdf" required><span class="proof-drop-icon"><i class="bi bi-cloud-arrow-up-fill"></i></span><span><strong>Pilih bukti pembayaran</strong><small>JPG, PNG, WEBP, PDF · Maks. 6 MB</small><em id="replacementProofName">Belum ada file dipilih</em></span></label></div><div class="modal-footer"><button type="button" class="btn-tech" data-bs-dismiss="modal">Batal</button><button class="btn-tech primary"><i class="bi bi-cloud-check"></i>Simpan Bukti</button></div></form></div></div>

<script>
(()=>{
  const replaceInput=document.getElementById('replacement_proof_file');const replacementName=document.getElementById('replacementProofName');replaceInput?.addEventListener('change',()=>replacementName.textContent=replaceInput.files?.[0]?.name||'Belum ada file dipilih');
  document.querySelectorAll('.proof-upload-btn').forEach(btn=>btn.addEventListener('click',()=>{const f=document.getElementById('proofReplaceForm');f.action=`/payments/${btn.dataset.paymentId}/proof`;document.getElementById('proofUploadCustomer').textContent=btn.dataset.customer||'-';document.getElementById('proofUploadInvoice').textContent=btn.dataset.invoice||'-';}));
  const img=document.getElementById('proofViewerImage'),pdf=document.getElementById('proofViewerPdf'),loading=document.getElementById('proofViewerLoading');
  document.querySelectorAll('.proof-view-btn').forEach(btn=>btn.addEventListener('click',()=>{const url=btn.dataset.proofUrl,mime=btn.dataset.proofMime||'';img.classList.add('d-none');pdf.classList.add('d-none');loading.classList.remove('d-none');document.getElementById('proofMetaCustomer').textContent=btn.dataset.customer||'-';document.getElementById('proofMetaCode').textContent=btn.dataset.customerCode||'-';document.getElementById('proofMetaInvoice').textContent=btn.dataset.invoice||'-';document.getElementById('proofMetaAmount').textContent=btn.dataset.amount||'-';document.getElementById('proofMetaBank').textContent=btn.dataset.bank||'-';document.getElementById('proofMetaReference').textContent=btn.dataset.reference||'-';document.getElementById('proofMetaUploader').textContent=btn.dataset.uploader||'-';document.getElementById('proofMetaUploaded').textContent=btn.dataset.uploaded||'-';document.getElementById('proofOpenNew').href=url;const seal=document.getElementById('proofStatusSeal');seal.classList.toggle('pending',btn.dataset.status==='pending');seal.querySelector('strong').textContent=btn.dataset.status==='pending'?'PENDING':'CONFIRMED';if(mime==='application/pdf'){pdf.src=url;pdf.classList.remove('d-none');setTimeout(()=>loading.classList.add('d-none'),500);}else{img.src=url;img.onload=()=>loading.classList.add('d-none');img.onerror=()=>loading.querySelector('small').textContent='Bukti gagal dimuat. Coba buka file asli.';img.classList.remove('d-none');}}));
})();
</script>
