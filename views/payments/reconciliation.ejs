<section>
  <div class="module-head">
    <div><div class="module-kicker">CASH RECONCILIATION</div><h1>Rekonsiliasi Pembayaran</h1><p>Pisahkan pembayaran pelanggan dari uang yang benar-benar sudah masuk ke kas perusahaan.</p></div>
    <div class="module-actions"><a href="/payments" class="btn-tech"><i class="bi bi-arrow-left"></i>Kembali ke Pembayaran</a></div>
  </div>
  <div class="metric-grid">
    <article class="metric-card orange"><div class="metric-top"><span class="metric-label">Cash Masih di Tim</span><span class="metric-icon"><i class="bi bi-person-vcard"></i></span></div><strong><%= formatRupiah(summary.held_total||0) %></strong><small>Belum masuk kas perusahaan</small></article>
    <article class="metric-card green"><div class="metric-top"><span class="metric-label">Setoran Cash Hari Ini</span><span class="metric-icon"><i class="bi bi-safe2-fill"></i></span></div><strong><%= formatRupiah(summary.settled_today||0) %></strong><small>Sudah direkonsiliasi</small></article>
    <article class="metric-card"><div class="metric-top"><span class="metric-label">Transfer Hari Ini</span><span class="metric-icon"><i class="bi bi-bank"></i></span></div><strong><%= formatRupiah(summary.transfer_today||0) %></strong><small>Confirmed transfer</small></article>
    <article class="metric-card"><div class="metric-top"><span class="metric-label">Collector Aktif</span><span class="metric-icon"><i class="bi bi-people-fill"></i></span></div><strong><%= staffBalances.length %></strong><small>Memegang cash pelanggan</small></article>
  </div>

  <div class="collector-grid mb-3">
    <% staffBalances.forEach((s,index)=>{ %>
    <article class="collector-card reveal-item" style="--enter-delay:<%= index*45 %>ms"><div class="collector-avatar"><%= String(s.collector_name).charAt(0).toUpperCase() %></div><div><span>Cash di <%= s.collector_name %></span><strong><%= formatRupiah(s.amount) %></strong><small><%= s.transactions %> transaksi belum disetor</small></div><div class="collector-signal"></div></article>
    <% }) %>
    <% if(!staffBalances.length){ %><div class="success-banner"><i class="bi bi-check2-circle"></i><div><strong>Semua cash sudah clear</strong><small>Tidak ada setoran staff yang tertunda.</small></div></div><% } %>
  </div>

  <form class="filter-card" method="get" action="/payments/reconciliation"><div class="filter-grid payment-filter-grid"><div class="filter-group"><label>CARI</label><div class="search-box"><i class="bi bi-search"></i><input name="q" value="<%= q %>" placeholder="Pelanggan, Customer ID, faktur, collector..."></div></div><div class="filter-group"><label>SITE / POP</label><select class="form-select" name="site"><option value="">Semua Site</option><% sites.forEach(s=>{ %><option value="<%= s.code %>" <%= site===s.code?'selected':'' %>><%= s.code %> · <%= s.name %></option><% }) %></select></div><div class="filter-group"><label>CLUSTER / ODP</label><select class="form-select" name="cluster"><option value="">Semua Cluster</option><% clusters.forEach(c=>{ %><option value="<%= c.id %>" <%= String(cluster)===String(c.id)?'selected':'' %>><%= c.site_code %> · <%= c.name %></option><% }) %></select></div><div class="filter-group d-flex align-items-end gap-2"><button class="btn-tech primary flex-fill"><i class="bi bi-search"></i>Cari</button><a class="btn-tech" href="/payments/reconciliation"><i class="bi bi-x-lg"></i></a></div></div></form>

  <div class="data-card">
    <div class="data-card-head"><div><h3>Cash Belum Disetor</h3><small>Konfirmasi setelah uang fisik sudah diterima admin/kas perusahaan.</small></div></div>
    <div class="table-responsive"><table class="app-table"><thead><tr><th class="app-seq-col">No.</th><th>Collector</th><th>Pelanggan</th><th>Invoice</th><th>Site</th><th>Nominal</th><th>Diterima</th><th>Status</th><th>Aksi</th></tr></thead><tbody>
      <% held.forEach((p,index)=>{ %><tr><td><span class="cell-main"><%= index+1 %></span></td><td><span class="cell-main"><%= p.collector_name||'Tidak diketahui' %></span><span class="cell-sub">Cash holder</span></td><td><span class="cell-main"><%= p.customer_name %></span><span class="cell-sub"><%= p.customer_code %></span></td><td><%= p.invoice_number %></td><td><span class="status-badge purple"><%= p.site_code %><%= p.cluster_name?` · Cluster ${p.cluster_name}`:'' %></span></td><td class="money"><%= formatRupiah(p.amount) %></td><td><%= new Date(p.paid_at).toLocaleString('id-ID',{timeZone:'Asia/Jakarta'}) %></td><td><span class="status-badge orange">belum disetor</span></td><td><form method="post" action="/payments/<%= p.id %>/settle"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn-tech success btn-sm"><i class="bi bi-check2"></i>Konfirmasi Setoran</button></form></td></tr><% }) %>
      <% if(!held.length){ %><tr><td colspan="9"><div class="empty-state"><i class="bi bi-safe2"></i><strong>Tidak ada cash tertahan</strong><small>Semua uang pelanggan sudah masuk ke kas perusahaan.</small></div></td></tr><% } %>
    </tbody></table></div>
  </div>
</section>
