<% const paymentReturnTo = typeof returnTo!=='undefined' ? returnTo : '/payments'; const paymentAutoOpen = typeof autoOpenPaymentModal!=='undefined' ? autoOpenPaymentModal : false; %>
<div class="modal fade" id="paymentModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
    <form method="post" action="/payments" enctype="multipart/form-data" class="modal-content" id="paymentForm">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="return_to" value="<%= paymentReturnTo %>">
      <div class="modal-header"><div><div class="module-kicker">PEMBAYARAN PELANGGAN</div><h5 class="modal-title">Catat Pembayaran</h5><small class="text-secondary">Pilih satu atau banyak faktur sekaligus.</small></div><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
      <div class="modal-body">
        <div class="payment-mode-picker mb-3">
          <label><input type="radio" name="method" value="transfer" checked><span><i class="bi bi-bank2"></i><strong>Transfer</strong><small>Bukti bisa diupload sekarang atau menyusul</small></span></label>
          <label><input type="radio" name="method" value="cash"><span><i class="bi bi-cash-stack"></i><strong>Cash ke Tim</strong><small>Uang fisik diterima staff</small></span></label>
          <label><input type="radio" name="method" value="qris"><span><i class="bi bi-qr-code"></i><strong>QRIS</strong><small>Pembayaran QR</small></span></label>
        </div>

        <div class="invoice-picker-panel">
          <div class="invoice-picker-head">
            <div><strong>Pilih Faktur</strong><small>Centang sebanyak yang diperlukan. Nominal per faktur dapat diubah untuk pembayaran sebagian.</small></div>
            <div class="search-box invoice-picker-search"><i class="bi bi-search"></i><input type="search" id="paymentCustomerSearch" placeholder="Cari nama pelanggan, Customer ID, faktur, site, cluster..."></div>
          </div>
          <div class="bulk-payment-tools"><button class="btn-tech compact" type="button" id="selectVisibleInvoices"><i class="bi bi-check2-square"></i>Centang Hasil Pencarian</button><button class="btn-tech compact" type="button" id="clearSelectedInvoices"><i class="bi bi-square"></i>Kosongkan</button><span><b id="selectedInvoiceCount">0</b> faktur dipilih</span><strong id="selectedInvoiceTotal">Rp 0</strong></div>
          <div class="invoice-picker-list" id="invoicePickerList">
            <% openInvoices.forEach(i=>{ const searchText=[i.customer_name,i.customer_code,i.invoice_number,i.site_code,i.cluster_name||''].join(' ').toLowerCase(); %>
            <label class="invoice-picker-row" data-invoice-row data-search="<%= searchText %>" data-invoice-id="<%= i.id %>">
              <input class="form-check-input payment-invoice-check" type="checkbox" name="invoice_ids" value="<%= i.id %>" <%= Number(preselectedInvoiceId)===Number(i.id)?'checked':'' %>>
              <span class="invoice-picker-customer"><strong><%= i.customer_name %></strong><small><%= i.customer_code %> · <%= i.invoice_number %></small></span>
              <span class="invoice-picker-site"><b><%= i.site_code %></b><small>Cluster <%= i.cluster_name||'-' %></small></span>
              <span class="invoice-picker-amount"><small>Sisa Tagihan</small><b><%= formatRupiah(i.outstanding) %></b></span>
              <span class="invoice-picker-input"><label>Nominal Bayar</label><input class="form-control payment-allocation" type="number" min="1" max="<%= Number(i.outstanding) %>" step="1" name="amount_<%= i.id %>" value="<%= Number(i.outstanding) %>" data-outstanding="<%= Number(i.outstanding) %>" <%= Number(preselectedInvoiceId)===Number(i.id)?'':'disabled' %>></span>
            </label>
            <% }) %>
            <% if(!openInvoices.length){ %><div class="empty-state"><i class="bi bi-check2-circle"></i><strong>Tidak ada faktur terbuka</strong><small>Semua faktur sudah lunas atau belum dibuat.</small></div><% } %>
          </div>
        </div>

        <div class="row g-3 mt-1">
          <div class="col-md-6 transfer-fields"><label class="form-label">Bank Tujuan</label><input class="form-control" name="bank_name" placeholder="BCA / BRI / Mandiri / lainnya"></div>
          <div class="col-md-6 transfer-fields"><label class="form-label">Status Transfer</label><% if(user.role==='admin'){ %><select class="form-select" name="payment_status"><option value="pending" selected>Menunggu Verifikasi</option><option value="confirmed">Konfirmasi Sekarang (wajib ada bukti)</option></select><% } else { %><input type="hidden" name="payment_status" value="pending"><div class="collector-self"><i class="bi bi-hourglass-split"></i><span><strong>Menunggu Verifikasi</strong><small>Admin akan memverifikasi setelah bukti tersedia.</small></span></div><% } %></div>
          <div class="col-md-6 cash-fields d-none"><label class="form-label">Cash Diterima Oleh</label><% if(user.role==='admin'){ %><select class="form-select" name="collector_user_id"><% staff.forEach(u=>{ %><option value="<%= u.id %>" <%= Number(u.id)===Number(user.id)?'selected':'' %>><%= u.name %> · <%= u.role %></option><% }) %></select><% } else { %><input type="hidden" name="collector_user_id" value="<%= user.id %>"><div class="collector-self"><i class="bi bi-person-check-fill"></i><span><strong><%= user.name %></strong><small>Cash tercatat atas nama akun yang login.</small></span></div><% } %><div class="form-help">Faktur diperbarui, tetapi uang tetap berstatus <b>Cash di Staff</b> sampai disetor.</div></div>
          <div class="col-md-6 proof-upload-field">
            <label class="form-label">Bukti Transfer <span class="text-secondary">(opsional / bisa menyusul)</span></label>
            <label class="proof-dropzone" for="proof_file"><input id="proof_file" type="file" name="proof_file" accept="image/jpeg,image/png,image/webp,application/pdf"><span class="proof-drop-icon"><i class="bi bi-cloud-arrow-up"></i></span><span><strong>Upload bukti pembayaran</strong><small>JPG, PNG, WEBP, PDF · Maks. 6 MB</small><em id="proofFileName">Belum ada bukti TF</em></span></label>
            <div class="form-help">Transfer tanpa bukti tetap boleh dicatat, tetapi statusnya <b>Menunggu Verifikasi</b> sampai bukti diupload.</div>
          </div>
          <div class="col-md-6"><label class="form-label">No. Referensi Transaksi</label><input class="form-control" name="reference" placeholder="TRX-123 / nomor referensi bank"></div>
          <div class="col-12"><label class="form-label">Catatan</label><textarea class="form-control" name="notes" rows="3" placeholder="Catatan pembayaran..."></textarea></div>
        </div>
      </div>
      <div class="modal-footer"><div class="payment-modal-total"><small>TOTAL PEMBAYARAN</small><strong id="paymentModalTotal">Rp 0</strong></div><button type="button" class="btn-tech" data-bs-dismiss="modal">Batal</button><button class="btn-tech primary"><i class="bi bi-shield-check"></i>Simpan Pembayaran</button></div>
    </form>
  </div>
</div>
<script>
(()=>{
  const modal=document.getElementById('paymentModal');
  const form=document.getElementById('paymentForm');
  if(!modal||!form)return;
  const rupiah=n=>'Rp '+new Intl.NumberFormat('id-ID',{maximumFractionDigits:0}).format(Number(n||0));
  const checks=[...form.querySelectorAll('.payment-invoice-check')];
  const search=document.getElementById('paymentCustomerSearch');
  const count=document.getElementById('selectedInvoiceCount');
  const total=document.getElementById('selectedInvoiceTotal');
  const modalTotal=document.getElementById('paymentModalTotal');
  const proofInput=document.getElementById('proof_file');
  const proofFileName=document.getElementById('proofFileName');
  function syncRow(check){const row=check.closest('[data-invoice-row]');const amount=row?.querySelector('.payment-allocation');if(amount)amount.disabled=!check.checked;row?.classList.toggle('selected',check.checked);}
  function updateTotal(){let sum=0,c=0;checks.forEach(ch=>{syncRow(ch);if(ch.checked){c++;const input=ch.closest('[data-invoice-row]')?.querySelector('.payment-allocation');sum+=Number(input?.value||0);}});count.textContent=c;total.textContent=rupiah(sum);modalTotal.textContent=rupiah(sum);}
  checks.forEach(ch=>{ch.addEventListener('change',updateTotal);const amount=ch.closest('[data-invoice-row]')?.querySelector('.payment-allocation');amount?.addEventListener('input',updateTotal);});
  search?.addEventListener('input',()=>{const q=search.value.trim().toLowerCase();form.querySelectorAll('[data-invoice-row]').forEach(row=>row.classList.toggle('d-none',!!q&&!row.dataset.search.includes(q)));});
  document.getElementById('selectVisibleInvoices')?.addEventListener('click',()=>{form.querySelectorAll('[data-invoice-row]:not(.d-none) .payment-invoice-check').forEach(ch=>ch.checked=true);updateTotal();});
  document.getElementById('clearSelectedInvoices')?.addEventListener('click',()=>{checks.forEach(ch=>ch.checked=false);updateTotal();});
  form.querySelectorAll('input[name="method"]').forEach(r=>r.addEventListener('change',()=>{const m=form.querySelector('input[name="method"]:checked')?.value;form.querySelectorAll('.cash-fields').forEach(x=>x.classList.toggle('d-none',m!=='cash'));form.querySelectorAll('.transfer-fields').forEach(x=>x.classList.toggle('d-none',m==='cash'));form.querySelectorAll('.proof-upload-field').forEach(x=>x.classList.toggle('d-none',m==='cash'));}));
  proofInput?.addEventListener('change',()=>{proofFileName.textContent=proofInput.files?.[0]?.name||'Belum ada bukti TF';});
  document.querySelectorAll('[data-payment-invoice-id]').forEach(btn=>btn.addEventListener('click',()=>{const id=String(btn.dataset.paymentInvoiceId||'');checks.forEach(ch=>ch.checked=String(ch.value)===id);const target=checks.find(ch=>String(ch.value)===id);target?.closest('[data-invoice-row]')?.scrollIntoView({block:'nearest'});updateTotal();}));
  form.addEventListener('submit',e=>{if(!checks.some(x=>x.checked)){e.preventDefault();alert('Pilih minimal satu faktur yang akan dibayar.');}});
  updateTotal();
  <% if(paymentAutoOpen || preselectedInvoiceId){ %>setTimeout(()=>bootstrap.Modal.getOrCreateInstance(modal).show(),120);<% } %>
})();
</script>
