<section>
<div class="module-head"><div><div class="module-kicker">FIELD OPERATIONS</div><h1>Jadwal Teknisi</h1><p>PSB, gangguan, migrasi, dan maintenance dalam timeline harian.</p></div><div class="module-actions"><form method="get" class="d-flex gap-2"><input class="form-control compact-control" type="date" name="date" value="<%= date %>"><div class="search-box"><i class="bi bi-search"></i><input name="q" value="<%= q %>" placeholder="Cari pelanggan / teknisi / site / cluster..."></div><button class="btn-tech"><i class="bi bi-search"></i>Cari</button></form><button class="btn-tech primary" data-bs-toggle="modal" data-bs-target="#scheduleModal"><i class="bi bi-plus-lg"></i>Tambah Jadwal</button></div></div>
<div class="timeline-board"><div class="timeline-date"><span><%= new Date(date+'T00:00:00').toLocaleDateString('id-ID',{weekday:'long'}) %></span><strong><%= new Date(date+'T00:00:00').toLocaleDateString('id-ID',{day:'2-digit',month:'long',year:'numeric'}) %></strong></div><div class="timeline-list"><% schedules.forEach((s,index)=>{ %><article class="timeline-job reveal-item" style="--enter-delay:<%= index*45 %>ms"><div class="timeline-time"><%= s.schedule_time?String(s.schedule_time).slice(0,5):'--:--' %></div><div class="timeline-rail"><i></i></div><div class="timeline-card"><div class="timeline-card-top"><div><span class="status-badge purple"><%= s.site_code||'FIELD' %> · Cluster <%= s.cluster_name||'-' %></span><h3><%= s.title %></h3></div><span class="status-badge <%= s.status==='done'?'green':s.status==='working'?'orange':s.status==='cancelled'?'red':'purple' %>"><%= s.status %></span></div><div class="timeline-meta"><span><i class="bi bi-person-badge"></i><%= s.technician_name %></span><span><i class="bi bi-person"></i><%= s.customer_name||'-' %><%= s.customer_code?` · ${s.customer_code}`:'' %></span><span><i class="bi bi-ticket"></i><%= s.ticket_code||'-' %></span></div><% if(s.notes){ %><p><%= s.notes %></p><% } %><form method="post" action="/schedules/<%= s.id %>/status" class="timeline-actions"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="date" value="<%= date %>"><input type="hidden" name="q" value="<%= q %>"><select class="form-select form-select-sm" name="status" onchange="this.form.submit()"><% ['scheduled','on_the_way','working','done','cancelled'].forEach(st=>{ %><option value="<%= st %>" <%= s.status===st?'selected':'' %>><%= st.replaceAll('_',' ') %></option><% }) %></select></form></div></article><% }) %><% if(!schedules.length){ %><div class="empty-state large"><i class="bi bi-calendar2-check"></i><strong>Tidak ada pekerjaan pada filter ini</strong><small>Ubah pencarian atau tambah jadwal baru.</small></div><% } %></div></div>
</section>
<div class="modal fade" id="scheduleModal" tabindex="-1"><div class="modal-dialog modal-lg modal-dialog-centered"><form class="modal-content" method="post" action="/schedules"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="modal-header"><div><div class="module-kicker">NEW FIELD JOB</div><h5 class="modal-title">Tambah Jadwal Teknisi</h5></div><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="row g-3"><div class="col-md-4"><label class="form-label">Tanggal</label><input class="form-control" type="date" name="schedule_date" value="<%= date %>" required></div><div class="col-md-3"><label class="form-label">Jam</label><input class="form-control" type="time" name="schedule_time"></div><div class="col-md-5"><label class="form-label">Teknisi</label><select class="form-select" name="technician_employee_id" required><% staff.forEach(e=>{ %><option value="<%= e.id %>"><%= e.employee_code %> · <%= e.name %><%= e.position_name?' · '+e.position_name:'' %></option><% }) %></select></div><div class="col-md-8"><label class="form-label">Pekerjaan</label><input class="form-control" name="title" placeholder="PSB / LOS / Migrasi / Maintenance" required></div><div class="col-md-4"><label class="form-label">Site</label><select class="form-select" name="site_id"><option value="">-</option><% sites.forEach(s=>{ %><option value="<%= s.id %>"><%= s.code %></option><% }) %></select></div><div class="col-md-6"><label class="form-label">Pelanggan</label><input class="form-control mb-2" type="search" data-customer-option-search="scheduleCustomerSelect" placeholder="Cari nama / ID / site / cluster..."><select class="form-select" name="customer_id" id="scheduleCustomerSelect"><option value="">-</option><% customers.forEach(c=>{ %><option value="<%= c.id %>"><%= c.site_code %> · Cluster <%= c.cluster_name||'-' %> · <%= c.customer_code %> · <%= c.name %></option><% }) %></select></div><div class="col-md-6"><label class="form-label">Ticket</label><select class="form-select" name="ticket_id"><option value="">-</option><% tickets.forEach(t=>{ %><option value="<%= t.id %>"><%= t.ticket_code %> · <%= t.subject %></option><% }) %></select></div><div class="col-12"><label class="form-label">Catatan</label><textarea class="form-control" name="notes" rows="3"></textarea></div></div></div><div class="modal-footer"><button class="btn-tech" type="button" data-bs-dismiss="modal">Batal</button><button class="btn-tech primary">Simpan Jadwal</button></div></form></div></div>
<script>(()=>{document.querySelectorAll('[data-customer-option-search]').forEach(input=>{const select=document.getElementById(input.dataset.customerOptionSearch);if(!select)return;input.addEventListener('input',()=>{const q=input.value.trim().toLowerCase();[...select.options].forEach((o,i)=>{if(i===0){o.hidden=false;return;}o.hidden=!!q&&!o.text.toLowerCase().includes(q);});});});})();</script>
