<section><div class="module-head"><div><div class="module-kicker">FIELD OPERATIONS</div><h1>Jadwal Teknisi</h1><p>PSB, gangguan, migrasi, dan maintenance dalam timeline harian.</p></div><div class="module-actions"><form method="get" class="d-flex gap-2"><input class="form-control compact-control" type="date" name="date" value="<%= date %>" onchange="this.form.submit()"></form><button class="btn-tech primary" data-bs-toggle="modal" data-bs-target="#scheduleModal"><i class="bi bi-plus-lg"></i>Tambah Jadwal</button></div></div>
<div class="timeline-board"><div class="timeline-date"><span><%= new Date(date+'T00:00:00').toLocaleDateString('id-ID',{weekday:'long'}) %></span><strong><%= new Date(date+'T00:00:00').toLocaleDateString('id-ID',{day:'2-digit',month:'long',year:'numeric'}) %></strong></div><div class="timeline-list"><% schedules.forEach((s,index)=>{ %><article class="timeline-job reveal-item" style="--enter-delay:<%= index*45 %>ms"><div class="timeline-time"><%= s.schedule_time?String(s.schedule_time).slice(0,5):'--:--' %></div><div class="timeline-rail"><i></i></div><div class="timeline-card"><div class="timeline-card-top"><div><span class="status-badge purple"><%= s.site_code||'FIELD' %></span><h3><%= s.title %></h3></div><span class="status-badge <%= s.status==='done'?'green':s.status==='working'?'orange':s.status==='cancelled'?'red':'purple' %>"><%= s.status %></span></div><div class="timeline-meta"><span><i class="bi bi-person-badge"></i><%= s.technician_name %></span><span><i class="bi bi-person"></i><%= s.customer_name||'-' %></span><span><i class="bi bi-ticket"></i><%= s.ticket_code||'-' %></span></div><% if(s.notes){ %><p><%= s.notes %></p><% } %><form method="post" action="/schedules/<%= s.id %>/status" class="timeline-actions"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="date" value="<%= date %>"><select class="form-select form-select-sm" name="status" onchange="this.form.submit()"><% ['scheduled','on_the_way','working','done','cancelled'].forEach(st=>{ %><option value="<%= st %>" <%= s.status===st?'selected':'' %>><%= st.replaceAll('_',' ') %></option><% }) %></select></form></div></article><% }) %><% if(!schedules.length){ %><div class="empty-state large"><i class="bi bi-calendar2-check"></i><strong>Belum ada pekerjaan terjadwal</strong><small>Tambahkan PSB, ticket, migrasi, atau maintenance untuk hari ini.</small></div><% } %></div></div></section>
<div class="modal fade" id="scheduleModal" tabindex="-1"><div class="modal-dialog modal-lg modal-dialog-centered"><form class="modal-content" method="post" action="/schedules"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="modal-header"><div><div class="module-kicker">NEW FIELD JOB</div><h5 class="modal-title">Tambah Jadwal Teknisi</h5></div><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="row g-3"><div class="col-md-4"><label class="form-label">Tanggal</label><input class="form-control" type="date" name="schedule_date" value="<%= date %>" required></div><div class="col-md-3"><label class="form-label">Jam</label><input class="form-control" type="time" name="schedule_time"></div><div class="col-md-5"><label class="form-label">Teknisi</label><select class="form-select" name="technician_id" required><% staff.forEach(u=>{ %><option value="<%= u.id %>"><%= u.name %></option><% }) %></select></div><div class="col-md-8"><label class="form-label">Pekerjaan</label><input class="form-control" name="title" placeholder="PSB / LOS / Migrasi / Maintenance" required></div><div class="col-md-4"><label class="form-label">Site</label><select class="form-select" name="site_id"><option value="">-</option><% sites.forEach(s=>{ %><option value="<%= s.id %>"><%= s.code %></option><% }) %></select></div><div class="col-md-6"><label class="form-label">Pelanggan</label><select class="form-select" name="customer_id"><option value="">-</option><% customers.forEach(c=>{ %><option value="<%= c.id %>"><%= c.customer_code %> · <%= c.name %></option><% }) %></select></div><div class="col-md-6"><label class="form-label">Ticket</label><select class="form-select" name="ticket_id"><option value="">-</option><% tickets.forEach(t=>{ %><option value="<%= t.id %>"><%= t.ticket_code %> · <%= t.subject %></option><% }) %></select></div><div class="col-12"><label class="form-label">Catatan</label><textarea class="form-control" name="notes" rows="3"></textarea></div></div></div><div class="modal-footer"><button class="btn-tech" type="button" data-bs-dismiss="modal">Batal</button><button class="btn-tech primary">Simpan Jadwal</button></div></form></div></div>
