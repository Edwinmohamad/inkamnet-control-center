<section><div class="module-head"><div><div class="module-kicker">NETWORK INTEGRATION</div><h1>Router MikroTik</h1><p>REST API connector untuk test router, PPPoE, isolir, buka isolir, dan automation.</p></div><div class="module-actions"><button class="btn-tech primary" data-bs-toggle="modal" data-bs-target="#routerModal"><i class="bi bi-router-fill"></i>Tambah Router</button></div></div>
<% const online=routers.filter(r=>r.last_status==='online').length; %><div class="metric-grid"><article class="metric-card"><div class="metric-top"><span class="metric-label">Total Router</span><span class="metric-icon"><i class="bi bi-router-fill"></i></span></div><strong><%= routers.length %></strong><small>Router terdaftar</small></article><article class="metric-card green"><div class="metric-top"><span class="metric-label">Online</span><span class="metric-icon"><i class="bi bi-wifi"></i></span></div><strong><%= online %></strong><small>Last health check</small></article><article class="metric-card red"><div class="metric-top"><span class="metric-label">Offline</span><span class="metric-icon"><i class="bi bi-wifi-off"></i></span></div><strong><%= routers.filter(r=>r.last_status==='offline').length %></strong><small>Perlu dicek</small></article><article class="metric-card"><div class="metric-top"><span class="metric-label">REST Security</span><span class="metric-icon"><i class="bi bi-shield-lock-fill"></i></span></div><strong>HTTPS</strong><small>Recommended for production</small></article></div>
<div class="data-card"><div class="data-card-head"><div><h3>Router Registry</h3><small>Credentials tersimpan terenkripsi</small></div></div><div class="table-responsive"><table class="app-table"><thead><tr><th>Site</th><th>Router</th><th>REST Endpoint</th><th>TLS</th><th>Status</th><th>Last Seen</th><th>Action</th></tr></thead><tbody><% routers.forEach(r=>{ %><tr><td><span class="status-badge purple"><%= r.site_code %></span></td><td class="cell-main"><%= r.name %></td><td><code class="text-purple"><%= r.base_url %></code></td><td><%= r.verify_tls?'Verify':'Skip' %></td><td><span class="status-badge <%= r.last_status==='online'?'green':r.last_status==='offline'?'red':'gray' %>"><%= r.last_status %></span><% if(r.last_error){ %><span class="cell-sub text-danger-soft"><%= r.last_error %></span><% } %></td><td><%= r.last_seen_at?new Date(r.last_seen_at).toLocaleString('id-ID',{timeZone:'Asia/Jakarta'}):'-' %></td><td><form method="post" action="/routers/<%= r.id %>/test"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn-tech"><i class="bi bi-activity"></i>Test</button></form></td></tr><% }) %></tbody></table></div></div></section>
<div class="modal fade" id="routerModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><form class="modal-content" method="post" action="/routers"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="modal-header"><h5 class="modal-title">Tambah Router MikroTik</h5><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="row g-3"><div class="col-12"><label class="form-label">Site</label><select class="form-select" name="site_id" required><% sites.forEach(s=>{ %><option value="<%= s.id %>"><%= s.code %> · <%= s.name %></option><% }) %></select></div><div class="col-12"><label class="form-label">Nama Router</label><input class="form-control" name="name" required placeholder="MikroTik KRW"></div><div class="col-12"><label class="form-label">REST Base URL</label><input class="form-control" name="base_url" required placeholder="https://192.168.77.1/rest"></div><div class="col-6"><label class="form-label">Username</label><input class="form-control" name="username" required></div><div class="col-6"><label class="form-label">Password</label><input class="form-control" type="password" name="password" required></div><div class="col-12"><div class="form-check form-switch"><input class="form-check-input" type="checkbox" name="verify_tls" id="tls" checked><label class="form-check-label" for="tls">Verifikasi sertifikat TLS</label></div></div></div></div><div class="modal-footer"><button class="btn-tech primary">Simpan Router</button></div></form></div></div>
