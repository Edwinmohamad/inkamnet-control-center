<section class="settings-center">
  <div class="module-head"><div><div class="module-kicker">SYSTEM CONFIGURATION</div><h1><%= language==='en'?'Settings':'Pengaturan' %></h1><p><%= language==='en'?'Company, application, employees, payments and access management.':'Perusahaan, aplikasi, karyawan, pembayaran, dan pengelolaan akses.' %></p></div></div>
  <div class="settings-layout">
    <aside class="settings-nav-card">
      <% const menus=[['company','Perusahaan','bi-buildings'],['invoice','Identitas Invoice','bi-receipt-cutoff'],['application','Tampilan & Aplikasi','bi-palette2'],['accounts','Config Akun','bi-person-gear'],['employees','Karyawan','bi-people'],['departments','Departemen','bi-diagram-3'],['positions','Posisi','bi-person-badge'],['banks','Bank','bi-bank'],['gateways','Payment Gateway','bi-credit-card']]; %>
      <% menus.forEach(m=>{ %><a class="settings-nav-link <%= tab===m[0]?'active':'' %>" href="/settings?tab=<%= m[0] %>"><i class="bi <%= m[2] %>"></i><span><%= m[1] %></span></a><% }) %>
    </aside>
    <div class="settings-content">
      <% if(tab==='company'){ %>
      <form method="post" action="/settings" class="data-card"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="return_tab" value="company">
        <div class="data-card-head"><div><h3>Perusahaan</h3><small>Identitas yang dipakai pada sistem, laporan, dan faktur.</small></div><span class="status-badge purple">INKAMNET</span></div>
        <div class="data-card-body"><div class="row g-3"><div class="col-md-8"><label class="form-label">Nama Perusahaan</label><input class="form-control" name="company_name" value="<%= settings.company_name %>" required></div><div class="col-md-4"><label class="form-label">Telepon</label><input class="form-control" name="company_phone" value="<%= settings.company_phone||'' %>"></div><div class="col-md-6"><label class="form-label">Email</label><input class="form-control" type="email" name="company_email" value="<%= settings.company_email||'' %>"></div><div class="col-md-6"><label class="form-label">Website</label><input class="form-control" name="company_website" value="<%= settings.company_website||'' %>"></div><div class="col-12"><label class="form-label">Tagline</label><input class="form-control" name="company_tagline" value="<%= settings.company_tagline||'' %>"></div><div class="col-12"><label class="form-label">Alamat</label><textarea class="form-control" name="company_address" rows="4"><%= settings.company_address||'' %></textarea></div></div>
        <input type="hidden" name="default_due_day" value="<%= settings.default_due_day %>"><input type="hidden" name="default_grace_days" value="<%= settings.default_grace_days %>"><input type="hidden" name="invoice_generate_days" value="<%= settings.invoice_generate_days %>"><input type="hidden" name="default_theme" value="<%= settings.default_theme %>"><input type="hidden" name="default_language" value="<%= settings.default_language||'id' %>"><div class="mt-4"><button class="btn-tech primary"><i class="bi bi-check2-circle"></i>Simpan Perusahaan</button></div></div>
      </form>
      <% } %>

      <% if(tab==='invoice'){ %>
      <form method="post" action="/settings/invoice-branding" enctype="multipart/form-data" class="data-card invoice-branding-card">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="data-card-head"><div><h3>Identitas Invoice</h3><small>Satu sumber identitas untuk invoice versi cetak dan PDF.</small></div><span class="status-badge green"><i class="bi bi-arrow-repeat"></i> TERSINKRON</span></div>
        <div class="data-card-body">
          <div class="invoice-branding-layout">
            <div class="invoice-logo-editor">
              <span>LOGO INVOICE</span>
              <div class="invoice-logo-preview"><% if(settings.invoice_logo_path){ %><img src="/invoices/branding/logo/<%= encodeURIComponent(settings.invoice_logo_path) %>" alt="Logo invoice"><% }else{ %><img src="/img/inkamnet-wordmark-hq.png" alt="Logo default"><% } %></div>
              <label class="proof-dropzone"><input type="file" name="invoice_logo" accept="image/png,image/jpeg"><span class="proof-drop-icon"><i class="bi bi-cloud-arrow-up"></i></span><span><strong>Upload Logo</strong><small>PNG/JPG · maks. 3 MB</small></span></label>
              <% if(settings.invoice_logo_path){ %><label class="form-check mt-2"><input class="form-check-input" type="checkbox" name="remove_logo" value="1"><span class="form-check-label">Hapus logo khusus, gunakan logo bawaan</span></label><% } %>
            </div>
            <div class="row g-3">
              <div class="col-md-8"><label class="form-label">Nama PT / Perusahaan *</label><input class="form-control" name="invoice_company_name" value="<%= settings.invoice_company_name||settings.company_name||'' %>" required></div>
              <div class="col-md-4"><label class="form-label">NPWP / Identitas Pajak</label><input class="form-control" name="invoice_tax_id" value="<%= settings.invoice_tax_id||'' %>"></div>
              <div class="col-md-6"><label class="form-label">No. Telepon</label><input class="form-control" name="invoice_phone" value="<%= settings.invoice_phone||settings.company_phone||'' %>"></div>
              <div class="col-md-6"><label class="form-label">Email</label><input class="form-control" type="email" name="invoice_email" value="<%= settings.invoice_email||settings.company_email||'' %>"></div>
              <div class="col-md-6"><label class="form-label">Website</label><input class="form-control" name="invoice_website" value="<%= settings.invoice_website||settings.company_website||'' %>"></div>
              <div class="col-12"><label class="form-label">Alamat Invoice</label><textarea class="form-control" name="invoice_address" rows="3"><%= settings.invoice_address||settings.company_address||'' %></textarea></div>
              <div class="col-12"><label class="form-label">Catatan Footer</label><textarea class="form-control" name="invoice_footer" rows="2" placeholder="Contoh: Dokumen digital resmi..."><%= settings.invoice_footer||'' %></textarea></div>
            </div>
          </div>
          <div class="secure-file-note mt-3"><i class="bi bi-receipt-cutoff"></i><span>Perubahan langsung digunakan saat invoice dibuka, dicetak, atau diunduh. Data invoice lama tidak perlu digenerate ulang.</span></div>
          <button class="btn-tech primary mt-4"><i class="bi bi-check2-circle"></i>Simpan Identitas Invoice</button>
        </div>
      </form>
      <% } %>

      <% if(tab==='application'){ %>
      <form method="post" action="/settings/application" class="data-card mb-3"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="data-card-head"><div><h3>Tampilan & Aplikasi</h3><small>Pilih mode, kombinasi warna, bahasa, dan default billing.</small></div><span class="status-badge purple"><i class="bi bi-stars"></i> LIVE PREVIEW</span></div>
        <div class="data-card-body">
          <div class="row g-3"><div class="col-md-4"><label class="form-label">Bahasa Default</label><select class="form-select" name="default_language"><option value="id" <%= (settings.default_language||'id')==='id'?'selected':'' %>>Indonesia</option><option value="en" <%= settings.default_language==='en'?'selected':'' %>>English</option></select></div><div class="col-md-4"><label class="form-label">Mode Cahaya</label><select class="form-select" name="default_theme"><option value="dark" <%= settings.default_theme==='dark'?'selected':'' %>>Dark</option><option value="light" <%= settings.default_theme==='light'?'selected':'' %>>Light</option><option value="system" <%= settings.default_theme==='system'?'selected':'' %>>Ikuti Sistem</option></select></div><div class="col-md-4"><label class="form-label">Jatuh Tempo Default</label><input class="form-control" type="number" min="1" max="28" name="default_due_day" value="<%= settings.default_due_day %>"></div></div>
          <div class="ui-palette-settings"><div><span>PALET WARNA DEFAULT</span><small>Enam kombinasi warna. User juga dapat menggantinya langsung dari header.</small></div><div class="ui-palette-grid"><% const palettes=[['nebula','Nebula','Ungu · Merah'],['ocean','Ocean','Biru · Cyan'],['emerald','Emerald','Hijau · Emas'],['sunset','Sunset','Oranye · Magenta'],['rose','Rose','Pink · Violet'],['ice','Ice','Cyan · Indigo']]; palettes.forEach(p=>{ %><label class="ui-palette-option" data-palette-preview="<%= p[0] %>"><input type="radio" name="ui_palette" value="<%= p[0] %>" <%= (settings.ui_palette||'nebula')===p[0]?'checked':'' %>><i><b></b><b></b><b></b></i><span><strong><%= p[1] %></strong><small><%= p[2] %></small></span><em class="bi bi-check2"></em></label><% }) %></div></div>
          <div class="row g-3 mt-1"><div class="col-md-4"><label class="form-label">Grace Period</label><input class="form-control" type="number" min="0" max="30" name="default_grace_days" value="<%= settings.default_grace_days %>"></div><div class="col-md-4"><label class="form-label">Generate Tagihan H-</label><input class="form-control" type="number" min="0" max="30" name="invoice_generate_days" value="<%= settings.invoice_generate_days %>"></div><div class="col-md-4 d-flex align-items-end"><div class="form-check form-switch mb-2"><input class="form-check-input" type="checkbox" name="auto_isolate" id="autoIsolate" <%= settings.auto_isolate?'checked':'' %>><label class="form-check-label" for="autoIsolate">Auto Isolir</label></div></div></div>
          <button class="btn-tech primary mt-4"><i class="bi bi-palette2"></i>Simpan Tampilan & Aplikasi</button>
        </div>
      </form>
      <div class="data-card"><div class="data-card-head"><div><h3>Default per Site / POP</h3><small>Override due date dan grace per site.</small></div></div><div class="data-card-body"><div class="row g-3"><% sites.forEach(s=>{ %><div class="col-lg-4"><form class="form-card p-3" method="post" action="/settings/sites/<%= s.id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><span class="status-badge purple"><%= s.code %></span><label class="form-label mt-3">Nama Site</label><input class="form-control mb-2" name="name" value="<%= s.name %>"><div class="row g-2"><div class="col-4"><label class="form-label">Due</label><input class="form-control" name="default_due_day" value="<%= s.default_due_day??'' %>"></div><div class="col-4"><label class="form-label">Grace</label><input class="form-control" name="default_grace_days" value="<%= s.default_grace_days??'' %>"></div><div class="col-4"><label class="form-label">H-</label><input class="form-control" name="invoice_generate_days" value="<%= s.invoice_generate_days??'' %>"></div></div><button class="btn-tech mt-3 w-100">Update</button></form></div><% }) %></div></div></div>
      <% } %>

      <% if(tab==='employees'){ %>
      <div class="data-card"><div class="data-card-head"><div><h3>Data Karyawan</h3><small>Sales, Technical Support, Admin, Finance, NOC, dan bagian lain.</small></div><button class="btn-tech primary" data-bs-toggle="modal" data-bs-target="#employeeModal"><i class="bi bi-person-plus"></i>Tambah Karyawan</button></div><div class="table-responsive"><table class="app-table"><thead><tr><th>Kode</th><th>Nama</th><th>Departemen</th><th>Posisi</th><th>Kontak</th><th>Akun</th><th>Status</th><th></th></tr></thead><tbody><% employees.forEach(e=>{ %><tr><td class="text-purple"><%= e.employee_code %></td><td class="cell-main"><%= e.name %></td><td><%= e.department_name||'-' %></td><td><span class="status-badge purple"><%= e.position_name||'Belum diatur' %></span></td><td><%= e.phone||'-' %><span class="cell-sub"><%= e.email||'' %></span></td><td><%= e.username||'-' %></td><td><span class="status-badge <%= e.is_active?'green':'gray' %>"><%= e.is_active?'Aktif':'Nonaktif' %></span></td><td><div class="d-flex gap-1"><button class="action-menu" type="button" data-bs-toggle="modal" data-bs-target="#editEmployee<%= e.id %>" title="Edit"><i class="bi bi-pencil-square"></i></button><form method="post" action="/settings/employees/<%= e.id %>/toggle"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="action-menu" title="Aktif / Nonaktif"><i class="bi bi-power"></i></button></form></div></td></tr><% }) %></tbody></table></div></div>
      <% } %>

      <% if(tab==='accounts'||tab==='roles'){ %>
      <div class="account-command-card mb-3"><div><span><i class="bi bi-shield-check"></i> ACCESS CONTROL CENTER</span><h2>Config Akun & Role Permission</h2><p>Create akun, ubah role, reset password, dan atur akses menu dari satu tempat.</p></div><button class="btn-tech primary" data-bs-toggle="modal" data-bs-target="#accountModal"><i class="bi bi-person-plus-fill"></i>Create Akun</button></div>
      <div class="data-card mb-3 account-registry"><div class="data-card-head"><div><h3>Daftar Akun</h3><small><%= users.length %> akun terdaftar · perubahan sensitif tercatat di Log Aktivitas.</small></div><span class="status-badge green"><%= users.filter(u=>u.is_active).length %> AKTIF</span></div><div class="table-responsive"><table class="app-table"><thead><tr><th>User</th><th>Username</th><th>Role</th><th>Status</th><th>Dibuat</th><th>Action</th></tr></thead><tbody><% users.forEach(u=>{ const protectedMaster=u.role==='master_admin'&&!isMasterAdmin; const currentUser=Number(u.id)===Number(user?.id); %><tr class="<%= currentUser?'current-account-row':'' %>"><td><div class="account-user-cell"><span class="avatar"><% if(u.profile_photo){ %><img src="/profile/photo/<%= encodeURIComponent(u.profile_photo) %>" alt=""><% }else{ %><%= u.name.charAt(0).toUpperCase() %><% } %></span><div><strong><%= u.name %></strong><small><%= currentUser?'Akun yang sedang login':'ID #'+u.id %></small></div></div></td><td><code><%= u.username %></code></td><td><span class="account-role <%= u.role %>"><i class="bi <%= u.role==='master_admin'?'bi-shield-fill-check':u.role==='admin'?'bi-person-fill-gear':'bi-person-fill' %>"></i><%= u.role==='master_admin'?'Master Admin':u.role %></span></td><td><span class="status-badge <%= u.is_active?'green':'gray' %>"><%= u.is_active?'Aktif':'Nonaktif' %></span></td><td><%= formatDate(u.created_at) %></td><td><div class="account-actions"><button class="action-menu" type="button" data-bs-toggle="modal" data-bs-target="#editAccount<%= u.id %>" title="Edit akun" <%= protectedMaster?'disabled':'' %>><i class="bi bi-pencil-square"></i></button><button class="action-menu" type="button" data-bs-toggle="modal" data-bs-target="#passwordAccount<%= u.id %>" title="Reset password" <%= protectedMaster?'disabled':'' %>><i class="bi bi-key-fill"></i></button><form method="post" action="/settings/users/<%= u.id %>/toggle"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="action-menu <%= u.is_active?'danger':'success' %>" title="<%= u.is_active?'Nonaktifkan':'Aktifkan' %>" <%= currentUser||protectedMaster?'disabled':'' %>><i class="bi bi-power"></i></button></form></div></td></tr><% }) %></tbody></table></div></div>
      <% } %>

      <% if(tab==='departments'){ %>
      <div class="data-card"><div class="data-card-head"><div><h3>Departemen</h3><small>Struktur bagian perusahaan.</small></div><button class="btn-tech primary" data-bs-toggle="modal" data-bs-target="#departmentModal"><i class="bi bi-plus-lg"></i>Tambah</button></div><div class="table-responsive"><table class="app-table"><thead><tr><th>Kode</th><th>Departemen</th><th>Deskripsi</th><th>Status</th><th></th></tr></thead><tbody><% departments.forEach(d=>{ %><tr><td class="text-purple"><%= d.code %></td><td class="cell-main"><%= d.name %></td><td><%= d.description||'-' %></td><td><span class="status-badge <%= d.is_active?'green':'gray' %>"><%= d.is_active?'Aktif':'Nonaktif' %></span></td><td><form method="post" action="/settings/departments/<%= d.id %>/toggle"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="action-menu"><i class="bi bi-power"></i></button></form></td></tr><% }) %></tbody></table></div></div>
      <% } %>

      <% if(tab==='positions'){ %>
      <div class="data-card"><div class="data-card-head"><div><h3>Posisi</h3><small>Kategori posisi dipakai untuk integrasi sales dan teknisi.</small></div><button class="btn-tech primary" data-bs-toggle="modal" data-bs-target="#positionModal"><i class="bi bi-plus-lg"></i>Tambah</button></div><div class="table-responsive"><table class="app-table"><thead><tr><th>Kode</th><th>Posisi</th><th>Departemen</th><th>Kategori</th><th>Status</th><th></th></tr></thead><tbody><% positions.forEach(p=>{ %><tr><td class="text-purple"><%= p.code %></td><td class="cell-main"><%= p.name %></td><td><%= p.department_name||'-' %></td><td><span class="status-badge purple"><%= p.category %></span></td><td><span class="status-badge <%= p.is_active?'green':'gray' %>"><%= p.is_active?'Aktif':'Nonaktif' %></span></td><td><form method="post" action="/settings/positions/<%= p.id %>/toggle"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="action-menu"><i class="bi bi-power"></i></button></form></td></tr><% }) %></tbody></table></div></div>
      <% } %>

      <% if(tab==='banks'){ %>
      <div class="data-card"><div class="data-card-head"><div><h3>Bank</h3><small>Rekening perusahaan untuk pembayaran pelanggan dan faktur.</small></div><button class="btn-tech primary" data-bs-toggle="modal" data-bs-target="#bankModal"><i class="bi bi-plus-lg"></i>Tambah Bank</button></div><div class="table-responsive"><table class="app-table"><thead><tr><th>Nama Bank</th><th>Nama Akun</th><th>Nomor Akun</th><th>Jenis</th><th>Status</th><th></th></tr></thead><tbody><% banks.forEach(b=>{ %><tr><td class="cell-main"><%= b.bank_name %></td><td><%= b.account_name %></td><td class="text-purple"><%= b.account_number %></td><td><%= b.type %></td><td><span class="status-badge <%= b.is_active?'green':'gray' %>"><%= b.is_active?'Aktif':'Nonaktif' %></span></td><td><form method="post" action="/settings/banks/<%= b.id %>/toggle"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="action-menu"><i class="bi bi-power"></i></button></form></td></tr><% }) %><% if(!banks.length){ %><tr><td colspan="6"><div class="empty-state">Belum ada rekening bank.</div></td></tr><% } %></tbody></table></div></div>
      <% } %>

      <% if(tab==='gateways'){ %>
      <div class="data-card"><div class="data-card-head"><div><h3>Payment Gateway</h3><small>Daftar provider pembayaran. Secret/API key tetap disimpan di environment, bukan di halaman ini.</small></div><button class="btn-tech primary" data-bs-toggle="modal" data-bs-target="#gatewayModal"><i class="bi bi-plus-lg"></i>Tambah</button></div><div class="table-responsive"><table class="app-table"><thead><tr><th>Nama</th><th>Provider</th><th>Channel</th><th>Status</th><th>Catatan</th><th></th></tr></thead><tbody><% gateways.forEach(g=>{ %><tr><td class="cell-main"><%= g.name %></td><td><%= g.provider||'-' %></td><td><%= g.channel||'-' %></td><td><span class="status-badge <%= g.status==='active'?'green':g.status==='testing'?'orange':'gray' %>"><%= statusLabel(g.status) %></span></td><td><%= g.notes||'-' %></td><td><form method="post" action="/settings/gateways/<%= g.id %>/toggle"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="action-menu"><i class="bi bi-power"></i></button></form></td></tr><% }) %></tbody></table></div></div>
      <% } %>

      <% if(tab==='accounts'||tab==='roles'){ %>
      <div class="data-card"><div class="data-card-head"><div><h3>Roles & Permissions</h3><small>Atur menu dan route yang dapat dibuka oleh setiap role.</small></div><span class="status-badge green">EDITABLE</span></div><div class="data-card-body">
        <div class="role-grid editable"><% roles.forEach(r=>{ let perms=[];try{perms=typeof r.permissions_json==='string'?JSON.parse(r.permissions_json):(r.permissions_json||[]);}catch(e){} %>
          <form class="role-card role-editor" method="post" action="/settings/roles/<%= encodeURIComponent(r.role_key) %>">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="role-editor-head"><span class="status-badge purple"><%= r.role_key %></span><input class="form-control" name="role_name" value="<%= r.role_name %>" aria-label="Nama role <%= r.role_key %>"></div>
            <div class="permission-check-grid"><% permissionCatalog.forEach(permission=>{ const master=r.role_key==='master_admin'; const lockedOn=master||permission.key==='dashboard'||(r.role_key==='admin'&&permission.key==='settings'); const lockedOff=!['admin','master_admin'].includes(r.role_key)&&permission.key==='settings'; %>
              <label class="permission-check <%= perms.includes(permission.key)||lockedOn?'selected':'' %> <%= lockedOff?'disabled':'' %>"><input type="checkbox" name="permissions" value="<%= permission.key %>" <%= perms.includes(permission.key)||lockedOn?'checked':'' %> <%= lockedOn||lockedOff?'disabled':'' %>><i class="bi bi-check2"></i><span><strong><%= permission.label %></strong><small><%= lockedOff?'khusus admin':permission.key %></small></span></label>
              <% if(lockedOn){ %><input type="hidden" name="permissions" value="<%= permission.key %>"><% } %>
            <% }) %></div>
            <button class="btn-tech primary w-100"><i class="bi bi-floppy"></i>Simpan Permission <%= r.role_name %></button>
          </form>
        <% }) %></div>
        <div class="secure-file-note mt-3"><i class="bi bi-shield-lock"></i><span>Dashboard selalu aktif agar akun tidak kehilangan halaman awal. Pengaturan hanya tersedia untuk admin supaya akses pengelolaan role tetap dapat dipulihkan.</span></div>
      </div></div>
      <% } %>
    </div>
  </div>
</section>

<!-- MODALS -->
<div class="modal fade" id="employeeModal" tabindex="-1"><div class="modal-dialog modal-lg modal-dialog-centered"><form class="modal-content" method="post" action="/settings/employees"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="modal-header"><h5 class="modal-title">Tambah Karyawan</h5><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="row g-3"><div class="col-md-4"><label class="form-label">Kode Karyawan</label><input class="form-control" name="employee_code" placeholder="Kosong = otomatis"></div><div class="col-md-8"><label class="form-label">Nama</label><input class="form-control" name="name" required></div><div class="col-md-6"><label class="form-label">Email</label><input class="form-control" type="email" name="email"></div><div class="col-md-6"><label class="form-label">Telepon</label><input class="form-control" name="phone"></div><div class="col-md-6"><label class="form-label">Departemen</label><select class="form-select" name="department_id"><option value="">Belum dipilih</option><% departments.forEach(d=>{ %><option value="<%= d.id %>"><%= d.name %></option><% }) %></select></div><div class="col-md-6"><label class="form-label">Posisi</label><select class="form-select" name="position_id"><option value="">Belum dipilih</option><% positions.forEach(p=>{ %><option value="<%= p.id %>"><%= p.name %> · <%= p.category %></option><% }) %></select></div><div class="col-md-6"><label class="form-label">Hubungkan Akun</label><select class="form-select" name="user_id"><option value="">Tanpa akun login</option><% users.forEach(u=>{ %><option value="<%= u.id %>"><%= u.name %> · <%= u.username %></option><% }) %></select></div><div class="col-md-6"><label class="form-label">Tanggal Bergabung</label><input class="form-control" type="date" name="joined_at"></div><div class="col-12"><label class="form-label">Catatan</label><textarea class="form-control" name="notes" rows="3"></textarea></div></div></div><div class="modal-footer"><button class="btn-tech primary">Simpan Karyawan</button></div></form></div></div>
<div class="modal fade" id="accountModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><form class="modal-content" method="post" action="/settings/users"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="modal-header"><div><div class="module-kicker">ACCOUNT PROVISIONING</div><h5 class="modal-title">Create Akun Login</h5><small class="text-secondary">Akun langsung aktif dan masuk ke direktori karyawan.</small></div><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="row g-3"><div class="col-12"><label class="form-label">Nama</label><input class="form-control" name="name" required maxlength="120"></div><div class="col-12"><label class="form-label">Username</label><input class="form-control" name="username" pattern="[-A-Za-z0-9._]{3,50}" autocomplete="off" required></div><div class="col-6"><label class="form-label">Role</label><select class="form-select" name="role"><option value="staff">Staff</option><option value="admin">Admin</option><% if(isMasterAdmin){ %><option value="master_admin">Master Admin</option><% } %></select></div><div class="col-6"><label class="form-label">Password Awal</label><input class="form-control" type="password" name="password" minlength="8" autocomplete="new-password" required></div></div><div class="secure-file-note mt-3"><i class="bi bi-shield-lock"></i><span>Password disimpan sebagai bcrypt hash. Minta user mengganti password awal dari Profil Saya.</span></div></div><div class="modal-footer"><button class="btn-tech primary"><i class="bi bi-person-check-fill"></i>Create Akun</button></div></form></div></div>
<% users.forEach(u=>{ const protectedMaster=u.role==='master_admin'&&!isMasterAdmin; if(!protectedMaster){ %>
<div class="modal fade" id="editAccount<%= u.id %>" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><form class="modal-content" method="post" action="/settings/users/<%= u.id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="modal-header"><div><div class="module-kicker">ACCOUNT CONFIGURATION</div><h5 class="modal-title">Edit <%= u.name %></h5></div><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="row g-3"><div class="col-12"><label class="form-label">Nama</label><input class="form-control" name="name" value="<%= u.name %>" required maxlength="120"></div><div class="col-12"><label class="form-label">Username</label><input class="form-control" name="username" value="<%= u.username %>" pattern="[-A-Za-z0-9._]{3,50}" required></div><div class="col-12"><label class="form-label">Role</label><select class="form-select" name="role" <%= Number(u.id)===Number(user?.id)?'disabled':'' %>><option value="staff" <%= u.role==='staff'?'selected':'' %>>Staff</option><option value="admin" <%= u.role==='admin'?'selected':'' %>>Admin</option><% if(isMasterAdmin){ %><option value="master_admin" <%= u.role==='master_admin'?'selected':'' %>>Master Admin</option><% } %></select><% if(Number(u.id)===Number(user?.id)){ %><input type="hidden" name="role" value="<%= u.role %>"><small class="form-help">Role akun yang sedang digunakan dilindungi dari perubahan sendiri.</small><% } %></div></div></div><div class="modal-footer"><button type="button" class="btn-tech" data-bs-dismiss="modal">Batal</button><button class="btn-tech primary"><i class="bi bi-floppy-fill"></i>Simpan Akun</button></div></form></div></div>
<div class="modal fade" id="passwordAccount<%= u.id %>" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><form class="modal-content" method="post" action="/settings/users/<%= u.id %>/password"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="modal-header"><div><div class="module-kicker">SECURITY RESET</div><h5 class="modal-title">Reset Password · <%= u.username %></h5></div><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div><div class="modal-body"><label class="form-label">Password Baru</label><input class="form-control" type="password" name="password" minlength="8" autocomplete="new-password" required><div class="secure-file-note mt-3"><i class="bi bi-exclamation-triangle"></i><span>User harus memakai password baru ini pada login berikutnya.</span></div></div><div class="modal-footer"><button type="button" class="btn-tech" data-bs-dismiss="modal">Batal</button><button class="btn-tech primary"><i class="bi bi-key-fill"></i>Reset Password</button></div></form></div></div>
<% } }) %>
<% employees.forEach(e=>{ %><div class="modal fade" id="editEmployee<%= e.id %>" tabindex="-1"><div class="modal-dialog modal-lg modal-dialog-centered"><form class="modal-content" method="post" action="/settings/employees/<%= e.id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="modal-header"><h5 class="modal-title">Edit Karyawan · <%= e.name %></h5><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="row g-3"><div class="col-md-4"><label class="form-label">Kode Karyawan</label><input class="form-control" name="employee_code" value="<%= e.employee_code %>" required></div><div class="col-md-8"><label class="form-label">Nama</label><input class="form-control" name="name" value="<%= e.name %>" required></div><div class="col-md-6"><label class="form-label">Email</label><input class="form-control" type="email" name="email" value="<%= e.email||'' %>"></div><div class="col-md-6"><label class="form-label">Telepon</label><input class="form-control" name="phone" value="<%= e.phone||'' %>"></div><div class="col-md-6"><label class="form-label">Departemen</label><select class="form-select" name="department_id"><option value="">Belum dipilih</option><% departments.forEach(d=>{ %><option value="<%= d.id %>" <%= String(e.department_id||'')===String(d.id)?'selected':'' %>><%= d.name %></option><% }) %></select></div><div class="col-md-6"><label class="form-label">Posisi</label><select class="form-select" name="position_id"><option value="">Belum dipilih</option><% positions.forEach(p=>{ %><option value="<%= p.id %>" <%= String(e.position_id||'')===String(p.id)?'selected':'' %>><%= p.name %> · <%= p.category %></option><% }) %></select></div><div class="col-md-6"><label class="form-label">Akun Login</label><select class="form-select" name="user_id"><option value="">Tanpa akun</option><% users.forEach(u=>{ %><option value="<%= u.id %>" <%= String(e.user_id||'')===String(u.id)?'selected':'' %>><%= u.name %> · <%= u.username %></option><% }) %></select></div><div class="col-md-6"><label class="form-label">Tanggal Bergabung</label><input class="form-control" type="date" name="joined_at" value="<%= e.joined_at?new Date(e.joined_at).toISOString().slice(0,10):'' %>"></div><div class="col-12"><label class="form-label">Catatan</label><textarea class="form-control" name="notes" rows="3"><%= e.notes||'' %></textarea></div></div></div><div class="modal-footer"><button class="btn-tech primary">Simpan Perubahan</button></div></form></div></div><% }) %>
<div class="modal fade" id="departmentModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><form class="modal-content" method="post" action="/settings/departments"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="modal-header"><h5 class="modal-title">Tambah Departemen</h5><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div><div class="modal-body"><label class="form-label">Kode</label><input class="form-control mb-3" name="code" required><label class="form-label">Nama</label><input class="form-control mb-3" name="name" required><label class="form-label">Deskripsi</label><textarea class="form-control" name="description"></textarea></div><div class="modal-footer"><button class="btn-tech primary">Simpan</button></div></form></div></div>
<div class="modal fade" id="positionModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><form class="modal-content" method="post" action="/settings/positions"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="modal-header"><h5 class="modal-title">Tambah Posisi</h5><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="row g-3"><div class="col-6"><label class="form-label">Kode</label><input class="form-control" name="code" required></div><div class="col-6"><label class="form-label">Nama</label><input class="form-control" name="name" required></div><div class="col-6"><label class="form-label">Departemen</label><select class="form-select" name="department_id"><option value="">-</option><% departments.forEach(d=>{ %><option value="<%= d.id %>"><%= d.name %></option><% }) %></select></div><div class="col-6"><label class="form-label">Kategori</label><select class="form-select" name="category"><option value="sales">Sales</option><option value="technical">Technical Support</option><option value="admin">Admin</option><option value="finance">Finance</option><option value="management">Management</option><option value="other">Other</option></select></div><div class="col-12"><label class="form-label">Deskripsi</label><textarea class="form-control" name="description"></textarea></div></div></div><div class="modal-footer"><button class="btn-tech primary">Simpan</button></div></form></div></div>
<div class="modal fade" id="bankModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><form class="modal-content" method="post" action="/settings/banks"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="modal-header"><h5 class="modal-title">Tambah Bank</h5><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="row g-3"><div class="col-12"><label class="form-label">Nama Bank</label><input class="form-control" name="bank_name" required></div><div class="col-12"><label class="form-label">Nama Akun</label><input class="form-control" name="account_name" required></div><div class="col-8"><label class="form-label">Nomor Akun</label><input class="form-control" name="account_number" required></div><div class="col-4"><label class="form-label">Jenis</label><select class="form-select" name="type"><option value="bank_transfer">Bank Transfer</option><option value="virtual_account">Virtual Account</option><option value="cash">Cash</option><option value="other">Other</option></select></div><div class="col-12"><label class="form-label">Catatan</label><textarea class="form-control" name="notes"></textarea></div></div></div><div class="modal-footer"><button class="btn-tech primary">Simpan Bank</button></div></form></div></div>
<div class="modal fade" id="gatewayModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><form class="modal-content" method="post" action="/settings/gateways"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="modal-header"><h5 class="modal-title">Tambah Payment Gateway</h5><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="row g-3"><div class="col-12"><label class="form-label">Nama</label><input class="form-control" name="name" required></div><div class="col-6"><label class="form-label">Provider</label><input class="form-control" name="provider"></div><div class="col-6"><label class="form-label">Channel</label><input class="form-control" name="channel" placeholder="QRIS / VA / Transfer"></div><div class="col-6"><label class="form-label">Status</label><select class="form-select" name="status"><option value="inactive">Inactive</option><option value="testing">Testing</option><option value="active">Active</option></select></div><div class="col-12"><label class="form-label">Catatan</label><textarea class="form-control" name="notes"></textarea></div></div></div><div class="modal-footer"><button class="btn-tech primary">Simpan Gateway</button></div></form></div></div>
