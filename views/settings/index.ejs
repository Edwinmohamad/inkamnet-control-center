<section>
  <div class="module-head"><div><div class="module-kicker">SYSTEM CONFIGURATION</div><h1>Pengaturan</h1><p>Branding perusahaan, default billing, multi-site, akun staff, keamanan, dan preferensi aplikasi.</p></div></div>
  <div class="row g-3">
    <div class="col-xl-8">
      <form method="post" action="/settings" class="data-card" id="company"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="data-card-head"><div><h3>Perusahaan & Branding</h3><small>Identitas yang dipakai di sistem dan invoice</small></div><span class="status-badge purple">INKAMNET</span></div>
        <div class="data-card-body">
          <div class="row g-3 align-items-start">
            <div class="col-lg-4"><div style="background:#fff;border-radius:14px;padding:14px;border:1px solid #e8ebf0"><img src="/img/inkamnet-wordmark-hq.png" alt="INKAMNET" style="width:100%;height:auto"></div><div class="text-secondary small mt-2">Logo utama pada login cover dan sidebar.</div></div>
            <div class="col-lg-8"><div class="row g-3"><div class="col-12"><label class="form-label">Nama Perusahaan</label><input class="form-control" name="company_name" value="<%= settings.company_name %>" required></div><div class="col-12"><label class="form-label">Tagline</label><input class="form-control" name="company_tagline" value="<%= settings.company_tagline||'From the Village, Online Everywhere' %>"></div><div class="col-md-6"><label class="form-label">Telepon</label><input class="form-control" name="company_phone" value="<%= settings.company_phone||'' %>"></div><div class="col-md-6"><label class="form-label">Email</label><input class="form-control" type="email" name="company_email" value="<%= settings.company_email||'' %>"></div><div class="col-12"><label class="form-label">Website</label><input class="form-control" name="company_website" value="<%= settings.company_website||'' %>" placeholder="https://..."></div><div class="col-12"><label class="form-label">Alamat</label><textarea class="form-control" name="company_address" rows="3"><%= settings.company_address||'' %></textarea></div></div></div>
          </div>
          <hr style="border-color:var(--line);margin:24px 0">
          <div class="module-kicker">BILLING DEFAULT</div>
          <div class="row g-3"><div class="col-md-3"><label class="form-label">Default Due Day</label><input class="form-control" type="number" min="1" max="28" name="default_due_day" value="<%= settings.default_due_day %>" required></div><div class="col-md-3"><label class="form-label">Grace Period</label><input class="form-control" type="number" min="0" max="30" name="default_grace_days" value="<%= settings.default_grace_days %>" required></div><div class="col-md-3"><label class="form-label">Generate H-</label><input class="form-control" type="number" min="0" max="30" name="invoice_generate_days" value="<%= settings.invoice_generate_days %>" required></div><div class="col-md-3"><label class="form-label">Default Theme</label><select class="form-select" name="default_theme"><option value="dark" <%= settings.default_theme==='dark'?'selected':'' %>>Dark</option><option value="light" <%= settings.default_theme==='light'?'selected':'' %>>Light</option><option value="system" <%= settings.default_theme==='system'?'selected':'' %>>System</option></select></div></div>
          <div class="form-check form-switch mt-4"><input class="form-check-input" type="checkbox" name="auto_isolate" id="ai" <%= settings.auto_isolate?'checked':'' %>><label class="form-check-label fw-semibold" for="ai">Aktifkan Auto Isolir MikroTik</label><div class="cell-sub text-danger-soft">Aktifkan hanya setelah router dan PPPoE pelanggan terverifikasi.</div></div>
          <div class="mt-4"><button class="btn-tech primary"><i class="bi bi-check2-circle"></i>Simpan Pengaturan</button></div>
        </div>
      </form>
    </div>
    <div class="col-xl-4">
      <div class="data-card mb-3"><div class="data-card-head"><div><h3>System Experience</h3><small>Preferensi UI modern</small></div></div><div class="data-card-body"><div class="d-grid gap-2"><div class="d-flex justify-content-between"><span class="text-secondary">Dark Mode</span><span class="status-badge green">ACTIVE</span></div><div class="d-flex justify-content-between"><span class="text-secondary">Loading Animation</span><span class="status-badge green">ACTIVE</span></div><div class="d-flex justify-content-between"><span class="text-secondary">Quick Command</span><span class="status-badge green">CTRL K</span></div><div class="d-flex justify-content-between"><span class="text-secondary">Mobile Responsive</span><span class="status-badge green">READY</span></div></div></div></div>
      <div class="data-card"><div class="data-card-head"><div><h3>Safety</h3><small>Protection untuk production</small></div></div><div class="data-card-body"><div class="d-grid gap-3"><div><span class="cell-main">Auto Isolate Default</span><span class="cell-sub"><%= settings.auto_isolate?'ON':'OFF' %></span></div><div><span class="cell-main">Session</span><span class="cell-sub">Server-side stored</span></div><div><span class="cell-main">Router Credentials</span><span class="cell-sub">Encrypted at rest</span></div></div></div></div>
    </div>
  </div>

  <div class="data-card mt-3" id="sites"><div class="data-card-head"><div><h3>Default per Site / POP</h3><small>Override setting company untuk KRW / CLM / KBG</small></div></div><div class="data-card-body"><div class="row g-3"><% sites.forEach(s=>{ %><div class="col-lg-4"><form class="form-card p-3" method="post" action="/settings/sites/<%= s.id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="d-flex align-items-center justify-content-between mb-3"><span class="status-badge purple"><%= s.code %></span><span class="cell-sub">Site override</span></div><label class="form-label">Nama</label><input class="form-control mb-2" name="name" value="<%= s.name %>"><div class="row g-2"><div class="col-4"><label class="form-label">Due</label><input class="form-control" type="number" name="default_due_day" value="<%= s.default_due_day??'' %>"></div><div class="col-4"><label class="form-label">Grace</label><input class="form-control" type="number" name="default_grace_days" value="<%= s.default_grace_days??'' %>"></div><div class="col-4"><label class="form-label">H-</label><input class="form-control" type="number" name="invoice_generate_days" value="<%= s.invoice_generate_days??'' %>"></div></div><button class="btn-tech mt-3 w-100">Update <%= s.code %></button></form></div><% }) %></div></div></div>

  <div class="data-card mt-3" id="users"><div class="data-card-head"><div><h3>Akun & Staff</h3><small>Buat akun, role, nonaktifkan user, dan reset password</small></div><button class="btn-tech primary" data-bs-toggle="modal" data-bs-target="#userModal"><i class="bi bi-person-plus-fill"></i>Tambah Akun</button></div><div class="table-responsive"><table class="app-table"><thead><tr><th>Nama</th><th>Username</th><th>Role</th><th>Status</th><th>Dibuat</th><th>Action</th></tr></thead><tbody><% users.forEach(u=>{ %><tr><td class="cell-main"><%= u.name %></td><td class="text-purple"><%= u.username %></td><td><span class="status-badge purple"><%= u.role %></span></td><td><span class="status-badge <%= u.is_active?'green':'gray' %>"><%= u.is_active?'aktif':'nonaktif' %></span></td><td><%= formatDate(u.created_at) %></td><td><div class="d-flex gap-1"><form method="post" action="/settings/users/<%= u.id %>/toggle"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="action-menu" title="Toggle aktif"><i class="bi bi-power"></i></button></form><button class="action-menu" data-bs-toggle="modal" data-bs-target="#pass<%= u.id %>" title="Reset password"><i class="bi bi-key-fill"></i></button></div></td></tr><% }) %></tbody></table></div></div>
</section>
<div class="modal fade" id="userModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><form class="modal-content" method="post" action="/settings/users"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="modal-header"><h5 class="modal-title">Tambah Akun Staff</h5><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="row g-3"><div class="col-12"><label class="form-label">Nama</label><input class="form-control" name="name" required></div><div class="col-12"><label class="form-label">Username</label><input class="form-control" name="username" required></div><div class="col-6"><label class="form-label">Role</label><select class="form-select" name="role"><option value="staff">Staff</option><option value="admin">Admin</option></select></div><div class="col-6"><label class="form-label">Password</label><input class="form-control" type="password" name="password" minlength="8" required></div></div></div><div class="modal-footer"><button class="btn-tech primary">Buat Akun</button></div></form></div></div>
<% users.forEach(u=>{ %><div class="modal fade" id="pass<%= u.id %>" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><form class="modal-content" method="post" action="/settings/users/<%= u.id %>/password"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="modal-header"><h5 class="modal-title">Reset Password · <%= u.name %></h5><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div><div class="modal-body"><label class="form-label">Password Baru</label><input class="form-control" type="password" name="password" minlength="8" required></div><div class="modal-footer"><button class="btn-tech primary">Reset Password</button></div></form></div></div><% }) %>
