<section class="team-kpi-page">
  <div class="module-head">
    <div><div class="module-kicker">TEAM PERFORMANCE</div><h1>KPI Tim</h1><p>Penilaian dipisahkan sesuai bagian kerja: teknisi, staff/admin, sales, finance, dan management.</p></div>
    <form class="kpi-period-filter" method="get"><select class="form-select" name="month"><% monthNames.forEach((m,i)=>{ %><option value="<%= i+1 %>" <%= month===i+1?'selected':'' %>><%= m %></option><% }) %></select><input class="form-control" type="number" name="year" min="2020" max="2100" value="<%= year %>"><button class="btn-tech primary"><i class="bi bi-funnel"></i>Terapkan</button></form>
  </div>

  <div class="team-kpi-summary">
    <article><span><i class="bi bi-people-fill"></i></span><div><small>Tim Aktif</small><strong><%= summary.people %></strong></div></article>
    <article><span><i class="bi bi-speedometer2"></i></span><div><small>Rata-rata Skor</small><strong><%= summary.avgScore %></strong></div></article>
    <article><span><i class="bi bi-check2-circle"></i></span><div><small>Tiket Closed</small><strong><%= summary.closed %></strong></div></article>
    <article><span><i class="bi bi-shield-check"></i></span><div><small>Piket Hadir</small><strong><%= summary.dutyPresent %></strong></div></article>
    <article><span><i class="bi bi-person-plus-fill"></i></span><div><small>PSB</small><strong><%= summary.psb %></strong></div></article>
    <article><span><i class="bi bi-tools"></i></span><div><small>Job Selesai</small><strong><%= summary.jobsDone %></strong></div></article>
  </div>

  <div class="data-card">
    <div class="data-card-head"><div><h3>Penilaian <%= monthNames[month-1] %> <%= year %></h3><small>Skor dihitung dari aktivitas yang tercatat di sistem, bukan target manual.</small></div><span class="status-badge purple"><%= team.length %> orang</span></div>
    <div class="table-responsive"><table class="app-table team-kpi-table"><thead><tr><th>#</th><th>Karyawan</th><th>Bagian</th><th>Tiket</th><th>Update</th><th>Job</th><th>Piket</th><th>PSB</th><th>Skor</th></tr></thead><tbody>
      <% team.forEach((x,idx)=>{ const tone=x.score>=85?'green':x.score>=70?'purple':x.score>=55?'orange':'red'; %>
      <tr>
        <td><span class="kpi-rank"><%= idx+1 %></span></td>
        <td><span class="cell-main"><%= x.name %></span><span class="cell-sub"><%= x.employee_code %></span></td>
        <td><span class="cell-main"><%= x.position_name %></span><span class="cell-sub"><%= x.department_name %> · <%= x.position_category %></span></td>
        <td><span class="cell-main"><%= x.closed_tickets %>/<%= x.assigned_tickets %></span><span class="cell-sub"><%= x.ticket_close_rate %>% close rate</span></td>
        <td><span class="cell-main"><%= x.ticket_updates %></span><span class="cell-sub"><%= x.update_rate %>% discipline</span></td>
        <td><span class="cell-main"><%= x.done_jobs %>/<%= x.assigned_jobs %></span><span class="cell-sub"><%= x.job_done_rate %>% selesai</span></td>
        <td><span class="cell-main"><%= x.present_duties %>/<%= x.assigned_duties %></span><span class="cell-sub"><%= x.duty_rate %>% hadir</span></td>
        <td><span class="cell-main"><%= x.psb_count %></span><span class="cell-sub"><%= x.position_category==='sales'?x.psb_activity+'% kontribusi':'data pendukung' %></span></td>
        <td><div class="kpi-score-block"><span class="status-badge <%= tone %>"><%= x.score %></span><div class="kpi-score-bar"><i style="width:<%= x.score %>%"></i></div><small><%= x.formula %></small></div></td>
      </tr>
      <% }) %>
      <% if(!team.length){ %><tr><td colspan="9"><div class="empty-state"><i class="bi bi-bar-chart-steps"></i><strong>Belum ada data KPI</strong><small>Tambahkan data karyawan dan aktivitas operasional terlebih dahulu.</small></div></td></tr><% } %>
    </tbody></table></div>
  </div>
  <div class="kpi-method-note"><i class="bi bi-info-circle-fill"></i><div><strong>Metode penilaian transparan</strong><small>Teknisi menitikberatkan ticket close, update harian, job teknisi dan piket. Staff/Admin/Finance lebih berat ke dukungan ticket dan piket. Sales dinilai dari kontribusi PSB tim dan piket. Management menggunakan penyelesaian ticket, update, dan piket.</small></div></div>
</section>
