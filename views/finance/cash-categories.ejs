<section>
  <div class="module-head">
    <div>
      <div class="module-kicker">CASH FLOW CONFIG</div>
      <h1>Kategori Kas</h1>
      <p>Kategori dibuat manual. Tentukan sendiri nama, jenis, site, dan kode prefix transaksi.</p>
    </div>
    <div class="module-actions"><button class="btn-tech primary" data-bs-toggle="modal" data-bs-target="#categoryModal"><i class="bi bi-plus-lg"></i>Tambah Kategori</button></div>
  </div>

  <div class="metric-grid">
    <article class="metric-card green"><div class="metric-top"><span class="metric-label">Pendapatan</span><span class="metric-icon"><i class="bi bi-arrow-down-left-circle-fill"></i></span></div><strong><%= categories.filter(c=>c.type==='income').length %></strong><small>Kategori pemasukan</small></article>
    <article class="metric-card red"><div class="metric-top"><span class="metric-label">Pengeluaran</span><span class="metric-icon"><i class="bi bi-arrow-up-right-circle-fill"></i></span></div><strong><%= categories.filter(c=>c.type==='expense').length %></strong><small>Kategori pengeluaran manual</small></article>
  </div>

  <div class="data-card">
    <div class="data-card-head"><div><h3>Daftar Kategori Kas</h3><small>Kode kategori menjadi prefix nomor transaksi, contoh OPS-202608-000123.</small></div></div>
    <div class="table-responsive">
      <table class="app-table">
        <thead><tr><th>Kode</th><th>Nama</th><th>Jenis</th><th>Site</th><th>Keterangan</th><th>Dipakai</th><th>Status</th><th class="text-end">Tindakan</th></tr></thead>
        <tbody>
          <% categories.forEach(c=>{ const systemCategory=['Pendapatan Billing','Setoran Cash Pelanggan'].includes(c.name); %>
          <tr>
            <td><code class="cash-category-code"><%= c.code||'-' %></code></td>
            <td><span class="cell-main"><%= c.name %></span><% if(systemCategory){ %><span class="cell-sub">Kategori sistem pembayaran</span><% } %></td>
            <td><span class="status-badge <%= c.type==='income'?'green':'red' %>"><%= c.type==='income'?'Pendapatan':'Pengeluaran' %></span></td>
            <td><span class="status-badge purple"><%= c.site_code||'GLOBAL' %></span></td>
            <td><%= c.description||'-' %></td>
            <td><span class="cell-main"><%= Number(c.usage_count||0) %></span><span class="cell-sub">transaksi</span></td>
            <td><span class="status-badge <%= c.is_active?'green':'gray' %>"><%= c.is_active?'aktif':'nonaktif' %></span></td>
            <td class="text-end">
              <% if(systemCategory){ %>
                <span class="status-badge purple"><i class="bi bi-lock-fill"></i>Sistem</span>
              <% } else if(user.role==='admin'){ %>
                <form method="post" action="/cash/categories/<%= c.id %>/delete" class="d-inline" onsubmit="return confirm('Hapus kategori ini? Kategori yang sudah dipakai transaksi tidak dapat dihapus.')">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button class="btn-tech danger compact" type="submit"><i class="bi bi-trash3"></i>Hapus</button>
                </form>
              <% } else { %><span class="text-secondary">-</span><% } %>
            </td>
          </tr>
          <% }) %>
          <% if(!categories.length){ %><tr><td colspan="8"><div class="empty-state"><i class="bi bi-tags"></i><strong>Belum ada kategori kas</strong><small>Klik Tambah Kategori untuk membuat kategori pertama.</small></div></td></tr><% } %>
        </tbody>
      </table>
    </div>
  </div>
</section>

<div class="modal fade" id="categoryModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <form class="modal-content" method="post" action="/cash/categories">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="modal-header"><div><div class="module-kicker">KATEGORI MANUAL</div><h5 class="modal-title">Tambah Kategori Kas</h5></div><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div>
      <div class="modal-body">
        <div class="row g-3">
          <div class="col-4"><label class="form-label">Kode</label><input class="form-control text-uppercase" name="code" maxlength="10" placeholder="OPS"><div class="form-help">Boleh kosong, kode dibuat otomatis dari nama.</div></div>
          <div class="col-8"><label class="form-label">Nama</label><input class="form-control" name="name" required placeholder="Contoh: BBM Teknisi"></div>
          <div class="col-6"><label class="form-label">Jenis</label><select class="form-select" name="type"><option value="expense" selected>Pengeluaran</option><option value="income">Pendapatan</option></select></div>
          <div class="col-6"><label class="form-label">Site</label><select class="form-select" name="site_id"><option value="">Global</option><% sites.forEach(s=>{ %><option value="<%= s.id %>"><%= s.code %> · <%= s.name %></option><% }) %></select></div>
          <div class="col-12"><label class="form-label">Deskripsi</label><textarea class="form-control" name="description" rows="3" placeholder="Keterangan kategori..."></textarea></div>
        </div>
      </div>
      <div class="modal-footer"><button type="button" class="btn-tech" data-bs-dismiss="modal">Batal</button><button class="btn-tech primary">Simpan Kategori</button></div>
    </form>
  </div>
</div>
