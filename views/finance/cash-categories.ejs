<section><div class="module-head"><div><div class="module-kicker">CASH FLOW CONFIG</div><h1>Kategori Kas</h1><p>Pisahkan pendapatan dan pengeluaran per kebutuhan operasional dan site.</p></div><div class="module-actions"><button class="btn-tech primary" data-bs-toggle="modal" data-bs-target="#categoryModal"><i class="bi bi-plus-lg"></i>Tambah Kategori</button></div></div>
<div class="metric-grid"><article class="metric-card green"><div class="metric-top"><span class="metric-label">Pendapatan</span><span class="metric-icon"><i class="bi bi-arrow-down-left-circle-fill"></i></span></div><strong><%= categories.filter(c=>c.type==='income').length %></strong><small>Kategori income</small></article><article class="metric-card red"><div class="metric-top"><span class="metric-label">Pengeluaran</span><span class="metric-icon"><i class="bi bi-arrow-up-right-circle-fill"></i></span></div><strong><%= categories.filter(c=>c.type==='expense').length %></strong><small>Kategori expense</small></article></div>
<div class="data-card"><div class="data-card-head"><div><h3>Cash Categories</h3><small>Struktur arus kas operasional</small></div></div><div class="table-responsive"><table class="app-table"><thead><tr><th>Nama</th><th>Jenis</th><th>Site</th><th>Keterangan</th><th>Status</th></tr></thead><tbody><% categories.forEach(c=>{ %><tr><td class="cell-main"><%= c.name %></td><td><span class="status-badge <%= c.type==='income'?'green':'red' %>"><%= c.type %></span></td><td><span class="status-badge purple"><%= c.site_code||'GLOBAL' %></span></td><td><%= c.description||'-' %></td><td><span class="status-badge <%= c.is_active?'green':'gray' %>"><%= c.is_active?'aktif':'nonaktif' %></span></td></tr><% }) %></tbody></table></div></div></section>
<div class="modal fade" id="categoryModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><form class="modal-content" method="post" action="/cash/categories"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="modal-header"><h5 class="modal-title">Tambah Kategori Kas</h5><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="row g-3"><div class="col-12"><label class="form-label">Nama</label><input class="form-control" name="name" required></div><div class="col-6"><label class="form-label">Jenis</label><select class="form-select" name="type"><option value="income">Pendapatan</option><option value="expense">Pengeluaran</option></select></div><div class="col-6"><label class="form-label">Site</label><select class="form-select" name="site_id"><option value="">Global</option><% sites.forEach(s=>{ %><option value="<%= s.id %>"><%= s.code %></option><% }) %></select></div><div class="col-12"><label class="form-label">Deskripsi</label><textarea class="form-control" name="description"></textarea></div></div></div><div class="modal-footer"><button class="btn-tech primary">Simpan</button></div></form></div></div>
