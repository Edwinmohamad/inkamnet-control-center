<% const monthNames=['Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember']; %>
<section><div class="module-head"><div><div class="module-kicker">FINANCIAL OPERATIONS</div><h1>Arus Kas</h1><p>Kas perusahaan, pemasukan, pengeluaran, dan uang pelanggan yang masih dipegang staff.</p></div><div class="module-actions"><a class="btn-tech" href="/cash/categories"><i class="bi bi-tags"></i>Kategori</a><button class="btn-tech primary" data-bs-toggle="modal" data-bs-target="#cashModal"><i class="bi bi-plus-lg"></i>Tambah Transaksi</button></div></div>
<div class="metric-grid"><article class="metric-card green"><div class="metric-top"><span class="metric-label">Pendapatan</span><span class="metric-icon"><i class="bi bi-graph-up-arrow"></i></span></div><strong><%= formatRupiah(summary.income) %></strong><small><%= monthNames[filters.month-1] %> <%= filters.year %></small></article><article class="metric-card red"><div class="metric-top"><span class="metric-label">Pengeluaran</span><span class="metric-icon"><i class="bi bi-graph-down-arrow"></i></span></div><strong><%= formatRupiah(summary.expense) %></strong><small>Operational expense</small></article><article class="metric-card <%= summary.balance>=0?'green':'red' %>"><div class="metric-top"><span class="metric-label">Saldo Periode</span><span class="metric-icon"><i class="bi bi-wallet-fill"></i></span></div><strong><%= formatRupiah(summary.balance) %></strong><small>Income − expense</small></article><article class="metric-card"><div class="metric-top"><span class="metric-label">Transaksi</span><span class="metric-icon"><i class="bi bi-list-check"></i></span></div><strong><%= transactions.length %></strong><small>Data sesuai filter</small></article></div>
<div class="cash-custody-strip"><div><span><i class="bi bi-person-vcard"></i> Cash masih di staff</span><strong><%= formatRupiah(collection.cash_held||0) %></strong><small><%= Number(collection.held_count||0) %> pembayaran belum disetor</small></div><a href="/payments/reconciliation">Buka Rekonsiliasi <i class="bi bi-arrow-right"></i></a></div>
<form class="filter-card" method="get"><div class="filter-grid"><div class="filter-group"><label>BULAN</label><select class="form-select" name="month"><% monthNames.forEach((m,i)=>{ %><option value="<%= i+1 %>" <%= filters.month===i+1?'selected':'' %>><%= m %></option><% }) %></select></div><div class="filter-group"><label>TAHUN</label><input class="form-control" type="number" name="year" value="<%= filters.year %>"></div><div class="filter-group"><label>SITE</label><select class="form-select" name="site"><option value="">Semua Site</option><% sites.forEach(s=>{ %><option value="<%= s.code %>" <%= filters.site===s.code?'selected':'' %>><%= s.code %></option><% }) %></select></div><div class="d-flex align-items-end"><button class="btn-tech primary">Filter</button></div></div></form>
<div class="data-card"><div class="data-card-head"><div><h3>Cash Ledger</h3><small>Income & expense ledger</small></div></div><div class="table-responsive"><table class="app-table"><thead><tr><th>Tanggal</th><th>Nama</th><th>Kategori</th><th>Site</th><th>Pendapatan</th><th>Pengeluaran</th><th>Catatan</th></tr></thead><tbody><% transactions.forEach(t=>{ %><tr><td><%= formatDate(t.transaction_date) %></td><td class="cell-main"><%= t.name %></td><td><span class="status-badge <%= t.category_type==='income'?'green':'red' %>"><%= t.category_name %></span></td><td><%= t.site_code||'GLOBAL' %></td><td class="money text-success-soft"><%= t.category_type==='income'?formatRupiah(t.amount):'-' %></td><td class="money text-danger-soft"><%= t.category_type==='expense'?formatRupiah(t.amount):'-' %></td><td><%= t.notes||'-' %></td></tr><% }) %><% if(!transactions.length){%><tr><td colspan="7"><div class="empty-state"><i class="bi bi-cash-stack"></i><strong>Belum ada transaksi</strong><small>Tambahkan pemasukan atau pengeluaran untuk periode ini.</small></div></td></tr><%}%></tbody></table></div></div></section>
<div class="modal fade" id="cashModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><form class="modal-content" method="post" action="/cash"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="modal-header"><h5 class="modal-title">Tambah Transaksi Kas</h5><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="row g-3"><div class="col-6"><label class="form-label">Tanggal</label><input class="form-control" type="date" name="transaction_date" required></div><div class="col-6"><label class="form-label">Site</label><select class="form-select" name="site_id"><option value="">Global</option><% sites.forEach(s=>{ %><option value="<%= s.id %>"><%= s.code %></option><% }) %></select></div><div class="col-12"><label class="form-label">Nama Transaksi</label><input class="form-control" name="name" required></div><div class="col-12"><label class="form-label">Kategori</label><select class="form-select" name="category_id" required><% categories.forEach(c=>{ %><option value="<%= c.id %>"><%= c.type==='income'?'[+]':'[-]' %> <%= c.name %></option><% }) %></select></div><div class="col-12"><label class="form-label">Nominal</label><input class="form-control" type="number" name="amount" min="1" required></div><div class="col-12"><label class="form-label">Catatan</label><textarea class="form-control" name="notes"></textarea></div></div></div><div class="modal-footer"><button class="btn-tech primary">Simpan Transaksi</button></div></form></div></div>
