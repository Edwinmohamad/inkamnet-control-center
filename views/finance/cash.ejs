<% const monthNames=['Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember']; %>
<section class="cash-page">
  <div class="module-head cash-page-head">
    <div><div class="module-kicker">FINANCIAL OPERATIONS</div><h1>Data Kas</h1><p>Kelola pemasukan, pengeluaran, bukti transaksi, kode unik, dan saldo kas per periode.</p></div>
    <div class="module-actions"><a class="btn-tech" href="/cash/categories"><i class="bi bi-tags"></i>Kategori Kas</a><a class="btn-tech" href="/payments/reconciliation"><i class="bi bi-arrow-left-right"></i>Rekonsiliasi</a></div>
  </div>

  <form class="cash-period-panel" method="get" action="/cash">
    <div class="cash-period-copy"><strong>Periode Kas</strong><small>Filter transaksi berdasarkan bulan, tahun, dan site.</small></div>
    <div class="cash-period-controls">
      <select class="form-select" name="month"><% monthNames.forEach((m,i)=>{ %><option value="<%= i+1 %>" <%= filters.month===i+1?'selected':'' %>><%= m %></option><% }) %></select>
      <input class="form-control" type="number" name="year" min="2020" max="2100" value="<%= filters.year %>">
      <select class="form-select" name="site"><option value="">Semua Site</option><% sites.forEach(s=>{ %><option value="<%= s.code %>" <%= filters.site===s.code?'selected':'' %>><%= s.code %> · <%= s.name %></option><% }) %></select>
      <button class="btn-tech primary"><i class="bi bi-funnel"></i>Terapkan</button>
    </div>
  </form>

  <div class="cash-summary-grid">
    <article class="cash-summary-card income"><div><span>Pendapatan</span><strong><%= formatRupiah(summary.income) %></strong></div><i class="bi bi-graph-up-arrow"></i></article>
    <article class="cash-summary-card balance"><div><span>Saldo</span><strong><%= formatRupiah(summary.balance) %></strong></div><i class="bi bi-wallet2"></i></article>
    <article class="cash-summary-card expense"><div><span>Pengeluaran</span><strong><%= formatRupiah(summary.expense) %></strong></div><i class="bi bi-graph-down-arrow"></i></article>
  </div>

  <div class="cash-custody-strip"><div><span><i class="bi bi-person-vcard"></i> Cash masih di staff</span><strong><%= formatRupiah(collection.cash_held||0) %></strong><small><%= Number(collection.held_count||0) %> pembayaran belum disetor</small></div><a href="/payments/reconciliation">Buka Rekonsiliasi <i class="bi bi-arrow-right"></i></a></div>

  <div class="cash-action-bar">
    <button class="btn-tech primary" type="button" data-bs-toggle="modal" data-bs-target="#cashModal"><i class="bi bi-plus-lg"></i>Data Kas</button>
    <div class="cash-action-right">
      <form method="get" action="/cash" class="cash-search-form"><input type="hidden" name="month" value="<%= filters.month %>"><input type="hidden" name="year" value="<%= filters.year %>"><input type="hidden" name="site" value="<%= filters.site %>"><div class="search-box" style="min-width:340px"><i class="bi bi-search"></i><input name="q" value="<%= filters.q %>" placeholder="Cari kode, transaksi, kategori..."></div></form>
      <% if(user.role==='admin'){ %><form method="post" action="/cash/delete-all" onsubmit="return confirm('Hapus SEMUA transaksi kas MANUAL pada <%= monthNames[filters.month-1] %> <%= filters.year %>? Transaksi otomatis pembayaran tetap aman.')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="month" value="<%= filters.month %>"><input type="hidden" name="year" value="<%= filters.year %>"><input type="hidden" name="site" value="<%= filters.site %>"><button class="btn-tech danger"><i class="bi bi-trash3"></i>Hapus Semua</button></form><% } %>
    </div>
  </div>

  <div class="data-card cash-ledger-card">
    <div class="data-card-head"><div><h3>Data Kas · <%= monthNames[filters.month-1] %> <%= filters.year %></h3><small><%= transactions.length %> transaksi<%= filters.site?` · ${filters.site}`:'' %></small></div><div class="legend-inline"><span><i class="dot success"></i>Pemasukan</span><span><i class="dot warning"></i>Bukti tersedia</span></div></div>
    <div class="table-responsive">
      <table class="app-table cash-ledger-table">
        <thead><tr><th>#</th><th>Kode Transaksi</th><th>Nama</th><th>Tanggal</th><th>Kategori</th><th>Site</th><th>Keterangan</th><th>Sumber Belanja</th><th>Bukti</th><th>Pendapatan</th><th>Pengeluaran</th><th class="text-end">Aksi</th></tr></thead>
        <tbody>
          <% transactions.forEach((t,index)=>{ const editable=!t.source_type||t.source_type==='manual';const td=new Date(t.transaction_date);const txDate=`${td.getFullYear()}-${String(td.getMonth()+1).padStart(2,'0')}-${String(td.getDate()).padStart(2,'0')}`; %>
          <tr>
            <td><span class="cell-main"><%= index+1 %></span></td>
            <td><code class="cash-tx-code"><%= t.transaction_code||'-' %></code><span class="cell-sub"><%= t.category_code||'' %></span></td>
            <td><span class="cell-main"><%= t.name %></span><span class="cell-sub"><%= t.source_type==='payment'?'AUTO BILLING':'MANUAL' %></span></td>
            <td><%= formatDate(t.transaction_date) %></td>
            <td><span class="status-badge <%= t.category_type==='income'?'green':'red' %>"><%= t.category_name %></span></td>
            <td><span class="status-badge purple"><%= t.site_code||'GLOBAL' %></span></td>
            <td><span class="cash-note"><%= t.notes||'-' %></span></td>
            <td><% if(t.purchase_channel){ %><span class="purchase-channel <%= t.purchase_channel %>"><i class="bi <%= t.purchase_channel==='online'?'bi-bag-check-fill':'bi-shop' %>"></i><%= t.purchase_channel==='online'?'Online Shop':'Offline Shop' %></span><span class="cell-sub"><%= t.purchase_shop_name||'-' %></span><% }else{ %><span class="text-secondary small">—</span><% } %></td>
            <td>
              <% if(t.proof_path){ %><a class="proof-chip compact-proof" href="/cash/<%= t.id %>/proof" target="_blank" rel="noopener"><span class="proof-chip-icon"><i class="bi <%= t.proof_mime==='application/pdf'?'bi-file-earmark-pdf-fill':'bi-image-fill' %>"></i></span><span><strong>Sudah upload</strong><small>Lihat bukti</small></span></a>
              <% } else if(t.category_type==='expense'){ %><span class="proof-missing proof-missing-strong"><i class="bi bi-exclamation-triangle-fill"></i>Belum ada bukti</span>
              <% } else { %><span class="text-secondary small">—</span><% } %>
            </td>
            <td class="money text-success-soft"><%= t.category_type==='income'?formatRupiah(t.amount):'-' %></td>
            <td class="money text-danger-soft"><%= t.category_type==='expense'?formatRupiah(t.amount):'-' %></td>
            <td class="text-end"><% if(user.role==='admin'&&editable){ %><button class="action-menu action-menu-labeled" type="button" onclick="document.getElementById('cashAction<%= t.id %>').showModal()" aria-label="Buka tindakan transaksi <%= t.transaction_code||t.id %>"><i class="bi bi-three-dots-vertical"></i><span>Aksi</span></button><dialog class="ink-action-dialog" id="cashAction<%= t.id %>"><div class="ink-action-dialog-head"><div><small>DATA KAS</small><strong><%= t.name %></strong><span><%= t.transaction_code||'-' %> · <%= formatRupiah(t.amount) %></span></div><button class="ink-dialog-close" type="button" onclick="this.closest('dialog').close()"><i class="bi bi-x-lg"></i></button></div><div class="ink-action-dialog-body"><button type="button" class="ink-action-item success" onclick="this.closest('dialog').close()" data-bs-toggle="modal" data-bs-target="#cashEditModal" data-id="<%= t.id %>" data-date="<%= txDate %>" data-name="<%= t.name %>" data-category="<%= t.category_id %>" data-site="<%= t.site_id||'' %>" data-amount="<%= Number(t.amount) %>" data-notes="<%= t.notes||'' %>" data-purchase-channel="<%= t.purchase_channel||'' %>" data-purchase-shop="<%= t.purchase_shop_name||'' %>"><i class="bi bi-pencil-square"></i><span><b>Perbarui Data</b><small>Edit transaksi atau upload bukti</small></span></button><% if(t.proof_path){ %><a class="ink-action-item" href="/cash/<%= t.id %>/proof" target="_blank" rel="noopener"><i class="bi bi-file-earmark-image"></i><span><b>Lihat Bukti</b><small>Buka lampiran transaksi</small></span></a><% } %><div class="ink-action-separator"></div><form method="post" action="/cash/<%= t.id %>/delete" onsubmit="return confirm('Hapus transaksi kas <%= t.transaction_code||'' %>?')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="return_month" value="<%= filters.month %>"><input type="hidden" name="return_year" value="<%= filters.year %>"><input type="hidden" name="return_site" value="<%= filters.site %>"><input type="hidden" name="return_q" value="<%= filters.q %>"><button type="submit" class="ink-action-item danger"><i class="bi bi-trash3"></i><span><b>Hapus</b><small>Hapus transaksi manual ini</small></span></button></form></div></dialog><% } else { %><span class="cash-locked"><i class="bi bi-lock"></i></span><% } %></td>
          </tr>
          <% }) %>
          <% if(!transactions.length){ %><tr><td colspan="12"><div class="empty-state"><i class="bi bi-cash-stack"></i><strong>Belum ada data kas</strong><small>Tambahkan pemasukan/pengeluaran atau ubah filter periode.</small></div></td></tr><% } %>
        </tbody>
      </table>
    </div>
  </div>
</section>

<div class="modal fade" id="cashModal" tabindex="-1"><div class="modal-dialog modal-lg modal-dialog-centered"><form class="modal-content" method="post" action="/cash" enctype="multipart/form-data"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="modal-header"><div><div class="module-kicker">CASH LEDGER</div><h5 class="modal-title">Tambah Data Kas</h5></div><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="cash-code-hint"><i class="bi bi-upc-scan"></i><div><strong>Kode transaksi dibuat otomatis</strong><small>Contoh: PC-202608-000123 untuk Petty Cash, LIA-202608-000124 untuk Liability.</small></div></div><div class="row g-3 mt-1"><div class="col-md-4"><label class="form-label">Tanggal</label><input class="form-control" type="date" name="transaction_date" value="<%= `${filters.year}-${String(filters.month).padStart(2,'0')}-01` %>" required></div><div class="col-md-4"><label class="form-label">Site</label><select class="form-select" name="site_id"><option value="">Global</option><% sites.forEach(s=>{ %><option value="<%= s.id %>"><%= s.code %></option><% }) %></select></div><div class="col-md-4"><label class="form-label">Nominal</label><input class="form-control" type="number" name="amount" min="1" required></div><div class="col-md-6"><label class="form-label">Nama Transaksi</label><input class="form-control" name="name" required placeholder="Contoh: BBM teknisi / pembelian adaptor"></div><div class="col-md-6"><label class="form-label">Kategori</label><select class="form-select" name="category_id" required><% categories.forEach(c=>{ %><option value="<%= c.id %>" data-type="<%= c.type %>"><%= c.type==='income'?'[+]':'[-]' %> <%= c.code %> · <%= c.name %></option><% }) %></select></div><div class="col-md-6"><label class="form-label">Pembelian Dari</label><select class="form-select" name="purchase_channel" data-purchase-channel><option value="">Tidak terkait pembelian</option><option value="online">Online Shop / Marketplace</option><option value="offline">Offline Shop / Toko Fisik</option></select></div><div class="col-md-6"><label class="form-label">Nama Toko / Marketplace <span class="text-secondary">(opsional)</span></label><input class="form-control" name="purchase_shop_name" data-purchase-shop placeholder="Contoh: Shopee / Tokopedia / Toko Sumber Jaya"></div><div class="col-12"><label class="form-label">Keterangan</label><textarea class="form-control" name="notes" rows="3"></textarea></div><div class="col-12"><label class="form-label">Foto / Bukti Pengeluaran <span class="text-secondary">(opsional)</span></label><label class="proof-dropzone large"><input type="file" name="proof_file" accept="image/jpeg,image/png,image/webp,application/pdf" data-cash-proof><span class="proof-drop-icon"><i class="bi bi-camera-fill"></i></span><span><strong>Upload foto / dokumen bukti</strong><small>JPG, PNG, WEBP, PDF · Maks. 6 MB</small><em data-cash-proof-name>Belum ada file dipilih</em></span></label></div></div></div><div class="modal-footer"><button type="button" class="btn-tech" data-bs-dismiss="modal">Batal</button><button class="btn-tech primary"><i class="bi bi-check2"></i>Simpan Data Kas</button></div></form></div></div>

<div class="modal fade" id="cashEditModal" tabindex="-1"><div class="modal-dialog modal-lg modal-dialog-centered"><form class="modal-content" method="post" id="cashEditForm" enctype="multipart/form-data"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="return_month" value="<%= filters.month %>"><input type="hidden" name="return_year" value="<%= filters.year %>"><input type="hidden" name="return_site" value="<%= filters.site %>"><input type="hidden" name="return_q" value="<%= filters.q %>"><div class="modal-header"><div><div class="module-kicker">EDIT CASH LEDGER</div><h5 class="modal-title">Perbarui Data Kas</h5></div><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="row g-3"><div class="col-md-4"><label class="form-label">Tanggal</label><input class="form-control" type="date" name="transaction_date" id="cashEditDate" required></div><div class="col-md-4"><label class="form-label">Site</label><select class="form-select" name="site_id" id="cashEditSite"><option value="">Global</option><% sites.forEach(s=>{ %><option value="<%= s.id %>"><%= s.code %></option><% }) %></select></div><div class="col-md-4"><label class="form-label">Nominal</label><input class="form-control" type="number" name="amount" id="cashEditAmount" min="1" required></div><div class="col-md-6"><label class="form-label">Nama Transaksi</label><input class="form-control" name="name" id="cashEditName" required></div><div class="col-md-6"><label class="form-label">Kategori</label><select class="form-select" name="category_id" id="cashEditCategory" required><% categories.forEach(c=>{ %><option value="<%= c.id %>"><%= c.type==='income'?'[+]':'[-]' %> <%= c.code %> · <%= c.name %></option><% }) %></select></div><div class="col-md-6"><label class="form-label">Pembelian Dari</label><select class="form-select" name="purchase_channel" id="cashEditPurchaseChannel"><option value="">Tidak terkait pembelian</option><option value="online">Online Shop / Marketplace</option><option value="offline">Offline Shop / Toko Fisik</option></select></div><div class="col-md-6"><label class="form-label">Nama Toko / Marketplace <span class="text-secondary">(opsional)</span></label><input class="form-control" name="purchase_shop_name" id="cashEditPurchaseShop" placeholder="Nama toko / marketplace"></div><div class="col-12"><label class="form-label">Keterangan</label><textarea class="form-control" name="notes" id="cashEditNotes" rows="3"></textarea></div><div class="col-12"><label class="form-label">Upload / Ganti Bukti <span class="text-secondary">(opsional)</span></label><label class="proof-dropzone"><input type="file" name="proof_file" accept="image/jpeg,image/png,image/webp,application/pdf" data-cash-proof><span class="proof-drop-icon"><i class="bi bi-cloud-arrow-up-fill"></i></span><span><strong>Pilih bukti baru</strong><small>Jika kosong, bukti lama tetap digunakan.</small><em data-cash-proof-name>Belum ada file baru</em></span></label></div></div></div><div class="modal-footer"><button type="button" class="btn-tech" data-bs-dismiss="modal">Batal</button><button class="btn-tech primary"><i class="bi bi-check2"></i>Simpan Perubahan</button></div></form></div></div>

<script>
(()=>{
  const modal=document.getElementById('cashEditModal');if(modal)modal.addEventListener('show.bs.modal',event=>{const b=event.relatedTarget;if(!b)return;const form=document.getElementById('cashEditForm');form.action=`/cash/${b.dataset.id}/update`;document.getElementById('cashEditDate').value=b.dataset.date||'';document.getElementById('cashEditName').value=b.dataset.name||'';document.getElementById('cashEditCategory').value=b.dataset.category||'';document.getElementById('cashEditSite').value=b.dataset.site||'';document.getElementById('cashEditAmount').value=b.dataset.amount||'';document.getElementById('cashEditPurchaseChannel').value=b.dataset.purchaseChannel||'';document.getElementById('cashEditPurchaseShop').value=b.dataset.purchaseShop||'';document.getElementById('cashEditNotes').value=b.dataset.notes||'';});
  document.querySelectorAll('[data-cash-proof]').forEach(input=>input.addEventListener('change',()=>{const label=input.closest('.proof-dropzone')?.querySelector('[data-cash-proof-name]');if(label)label.textContent=input.files?.[0]?.name||'Belum ada file dipilih';}));
})();
</script>
