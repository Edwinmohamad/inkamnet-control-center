<% const monthNames=['Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember']; %>
<section class="analytics-page analytics-v119">
  <div class="module-head analytics-head">
    <div><div class="module-kicker">RT/RW NET BUSINESS INTELLIGENCE</div><h1>Analitik Keuangan & PSB</h1><p>Ringkasan eksekutif untuk collection, MRR, piutang, pertumbuhan PSB, dan kapasitas ODP.</p></div>
    <form class="analytics-filter" method="get" data-auto-filter><select name="site" class="form-select"><option value="">Semua Site</option><% sites.forEach(s=>{ %><option value="<%= s.code %>" <%= selectedSiteCode===s.code?'selected':'' %>><%= s.code %> · <%= s.name %></option><% }) %></select><select name="month" class="form-select"><% monthNames.forEach((m,i)=>{ %><option value="<%= i+1 %>" <%= month===i+1?'selected':'' %>><%= m %></option><% }) %></select><input class="form-control" type="number" name="year" min="2020" max="2100" value="<%= year %>"></form>
  </div>

  <% if(typeof isDummy!=='undefined'&&isDummy){ %><div class="alert alert-warning alert-modern" role="alert"><i class="bi bi-exclamation-triangle-fill me-2"></i>Sumber data analitik belum siap (tabel/kolom database belum lengkap). Menampilkan <b>data contoh sementara</b> agar halaman tetap dapat digunakan.</div><% } %>
  <nav class="analytics-tabs" aria-label="Analitik"><button class="active" data-analytics-tab="executive"><i class="bi bi-stars"></i>Executive Summary</button><button data-analytics-tab="finance"><i class="bi bi-graph-up-arrow"></i>Analitik Keuangan</button><button data-analytics-tab="psb"><i class="bi bi-diagram-3-fill"></i>PSB & Infrastruktur</button></nav>

  <div class="analytics-pane active" data-analytics-pane="executive">
    <div class="analytics-kpi-grid">
      <article><span>Pelanggan Aktif</span><strong><%= kpis.activeCustomers %></strong><small><%= selectedSiteCode||'Semua site' %></small><i class="bi bi-people-fill"></i></article>
      <article><span>MRR Aktif</span><strong><%= formatRupiah(kpis.mrr) %></strong><small>Nilai paket pelanggan aktif</small><i class="bi bi-cash-stack"></i></article>
      <article><span>Collection Rate</span><strong><%= kpis.collectionRate %>%</strong><small><%= monthNames[month-1] %> <%= year %></small><i class="bi bi-pie-chart-fill"></i></article>
      <article><span>Outstanding</span><strong><%= formatRupiah(kpis.outstanding) %></strong><small>Piutang periode terpilih</small><i class="bi bi-exclamation-diamond-fill"></i></article>
      <article><span>PSB Bulan Ini</span><strong><%= kpis.psb %></strong><small>Pemasangan baru</small><i class="bi bi-person-plus-fill"></i></article>
      <article><span>Kas Pending</span><strong><%= kpis.pendingCash %></strong><small>Belum masuk saldo real</small><i class="bi bi-shield-check"></i></article>
    </div>
    <article class="analytics-advisory-card"><div class="analytics-section-title"><div><span>SMART ADVISORY ENGINE</span><h2>Saran Otomatis</h2></div><i class="bi bi-lightbulb-fill"></i></div><div class="analytics-advisory-list"><% advisories.forEach(a=>{ %><a class="<%= a.tone %>" href="<%= a.href %>"><i class="bi <%= a.icon %>"></i><div><strong><%= a.title %></strong><small><%= a.detail %></small></div><span class="bi bi-arrow-right"></span></a><% }) %></div></article>
  </div>

  <div class="analytics-pane" data-analytics-pane="finance">
    <div class="analytics-finance-grid"><article class="analytics-chart-card"><div class="analytics-section-title"><div><span>CASHFLOW STREAM</span><h2>Inflow vs Outflow</h2></div></div><div class="analytics-chart"><canvas id="analyticsCashflowChart"></canvas></div></article><article class="analytics-chart-card"><div class="analytics-section-title"><div><span>RECURRING REVENUE</span><h2>MRR / Billing Trend</h2></div></div><div class="analytics-chart"><canvas id="analyticsMrrChart"></canvas></div></article></div>
    <article class="analytics-aging-card"><div class="analytics-section-title"><div><span>AGING PIUTANG</span><h2>Prioritas Collection</h2></div><a href="/invoices?status=open">Buka Tagihan <i class="bi bi-arrow-right"></i></a></div><div class="aging-summary"><span><b><%= agingBuckets.h3.length %></b>H-3</span><span><b><%= agingBuckets.hplus3.length %></b>H+3 s/d 30</span><span class="danger"><b><%= agingBuckets.over30.length %></b>&gt;30 Hari</span></div><div class="table-responsive"><table class="app-table"><thead><tr><th>Pelanggan</th><th>Site</th><th>Jatuh Tempo</th><th>Umur</th><th>Outstanding</th><th>Status</th><th>Aksi</th></tr></thead><tbody><% aging.slice(0,40).forEach(row=>{const days=Number(row.days_overdue||0);const waText=encodeURIComponent(`Halo ${row.customer_name}, ini pengingat tagihan INKAMNET Anda sebesar ${formatRupiah(row.outstanding)} yang ${days>0?`sudah lewat ${days} hari dari jatuh tempo`:'akan segera jatuh tempo'}. Mohon segera melakukan pembayaran. Terima kasih.`);%><tr><td><span class="cell-main"><%= row.customer_name %></span><span class="cell-sub"><%= row.customer_code %></span></td><td><span class="status-badge purple"><%= row.site_code %></span></td><td><%= formatDate(row.oldest_due) %></td><td><%= days>0?`${days} hari overdue`:days<0?`H${days}`:'Hari ini' %></td><td class="money"><%= formatRupiah(row.outstanding) %></td><td><span class="status-badge <%= days>30?'red':days>0?'orange':'green' %>"><%= days>30?'Siap review isolir':days>0?'Follow-up':'Reminder H-3' %></span></td><td><% if(row.whatsappNumber){ %><a class="btn-tech success btn-sm" href="https://wa.me/<%= row.whatsappNumber %>?text=<%= waText %>" target="_blank" rel="noopener"><i class="bi bi-whatsapp"></i>Reminder</a><% }else{ %><span class="cell-sub" title="Nomor WhatsApp pelanggan belum valid/tersimpan">Nomor belum ada</span><% } %></td></tr><% }) %><% if(!aging.length){ %><tr><td colspan="7"><div class="empty-state"><i class="bi bi-check2-circle"></i><strong>Tidak ada piutang terbuka</strong></div></td></tr><% } %></tbody></table></div></article>
  </div>

  <div class="analytics-pane" data-analytics-pane="psb">
    <div class="analytics-psb-grid"><article class="analytics-funnel-card"><div class="analytics-section-title"><div><span>PSB CONVERSION FUNNEL</span><h2>Registrasi → Aktivasi</h2><small>Stage diturunkan dari kelengkapan alamat/cluster, provisioning PPPoE, dan activation date saat ini.</small></div></div><div class="psb-funnel"><% const base=Math.max(1,Number(funnel[0]?.value||0)); funnel.forEach((f,index)=>{ %><div style="--funnel-width:<%= Math.max(38,Math.round(Number(f.value||0)/base*100)) %>%"><span><i><%= index+1 %></i><b><%= f.label %></b><small><%= f.hint %></small></span><strong><%= f.value %></strong></div><% }) %></div></article><article class="analytics-sla-card"><span>RATA-RATA SLA PSB</span><strong><%= sla.avgDays %><small> hari</small></strong><p>Dari registrasi sampai activation date pada <%= sla.samples %> pelanggan teraktivasi.</p><i class="bi bi-stopwatch-fill"></i></article></div>
    <article class="analytics-odp-card"><div class="analytics-section-title"><div><span>ODP CAPACITY HEATMAP</span><h2>Kapasitas per Site / ODP</h2></div><a href="/clusters">Kelola ODP <i class="bi bi-arrow-right"></i></a></div><div class="odp-heatmap"><% odp.forEach(o=>{const tone=o.capacity_ports===0?'unknown':o.remaining_ports<2?'critical':o.utilization>=75?'warning':'healthy';%><a class="<%= tone %>" href="/clusters?site=<%= o.site_code %>"><span><b><%= o.site_code %></b><small><%= o.name %></small></span><strong><%= o.capacity_ports?`${o.used_ports}/${o.capacity_ports}`:'N/A' %></strong><em><%= o.capacity_ports?`${o.remaining_ports} port tersisa`:'Kapasitas belum diisi' %></em><i style="--odp-use:<%= o.utilization %>%"></i></a><% }) %><% if(!odp.length){ %><div class="empty-state"><i class="bi bi-diagram-3"></i><strong>Belum ada data ODP</strong></div><% } %></div></article>
  </div>
</section>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
<script>
(()=>{
  document.querySelectorAll('[data-analytics-tab]').forEach(btn=>btn.addEventListener('click',()=>{document.querySelectorAll('[data-analytics-tab]').forEach(x=>x.classList.toggle('active',x===btn));document.querySelectorAll('[data-analytics-pane]').forEach(x=>x.classList.toggle('active',x.dataset.analyticsPane===btn.dataset.analyticsTab));}));
  if(typeof Chart==='undefined')return;
  const series=<%- JSON.stringify(financeSeries) %>,currency=v=>'Rp '+new Intl.NumberFormat('id-ID',{notation:'compact',maximumFractionDigits:1}).format(v||0);
  const base={responsive:true,maintainAspectRatio:false,plugins:{legend:{labels:{color:'#8995aa',boxWidth:10,usePointStyle:true}},tooltip:{backgroundColor:'#0b1020',padding:12,callbacks:{label:c=>`${c.dataset.label}: ${currency(c.raw)}`}}},scales:{x:{grid:{display:false},ticks:{color:'#7f8aa0'}},y:{beginAtZero:true,grid:{color:'rgba(148,163,184,.08)'},ticks:{color:'#7f8aa0',callback:currency}}}};
  const cash=document.getElementById('analyticsCashflowChart');if(cash)new Chart(cash,{type:'bar',data:{labels:series.labels,datasets:[{label:'Inflow',data:series.inflow,backgroundColor:'rgba(46,214,161,.65)',borderColor:'#2ed6a1',borderWidth:1,borderRadius:6},{label:'Outflow',data:series.outflow,backgroundColor:'rgba(255,105,105,.55)',borderColor:'#ff6969',borderWidth:1,borderRadius:6}]},options:{...base,scales:{...base.scales,x:{...base.scales.x,stacked:false}}}});
  const mrr=document.getElementById('analyticsMrrChart');if(mrr)new Chart(mrr,{type:'bar',data:{labels:series.labels,datasets:[{label:'Billing recurring',data:series.mrr,backgroundColor:'rgba(95,91,255,.60)',borderColor:'#766cff',borderWidth:1,borderRadius:7}]},options:base});
})();
</script>
