<section>
  <div class="module-head"><div><div class="module-kicker">SERVICE CATALOG</div><h1>Paket Internet</h1><p>Service plan, bandwidth, harga, subscriber, dan mapping PPP Profile MikroTik.</p></div><div class="module-actions"><button class="btn-tech primary" data-bs-toggle="modal" data-bs-target="#packageModal"><i class="bi bi-plus-lg"></i>Tambah Paket</button></div></div>
  <div class="metric-grid"><article class="metric-card"><div class="metric-top"><span class="metric-label">Total Paket</span><span class="metric-icon"><i class="bi bi-speedometer2"></i></span></div><strong><%= packages.length %></strong><small>Semua service plan</small></article><article class="metric-card green"><div class="metric-top"><span class="metric-label">Paket Aktif</span><span class="metric-icon"><i class="bi bi-check-circle-fill"></i></span></div><strong><%= packages.filter(p=>p.is_active).length %></strong><small>Siap di-assign</small></article><article class="metric-card"><div class="metric-top"><span class="metric-label">Harga Terendah</span><span class="metric-icon"><i class="bi bi-tag-fill"></i></span></div><strong><%= formatRupiah(packages.length?Math.min(...packages.map(p=>Number(p.price))):0) %></strong><small>Entry package</small></article><article class="metric-card"><div class="metric-top"><span class="metric-label">Subscriber</span><span class="metric-icon"><i class="bi bi-people-fill"></i></span></div><strong><%= packages.reduce((a,p)=>a+Number(p.customer_count||0),0) %></strong><small>Aktif pada seluruh paket</small></article></div>
  <div class="plan-grid">
    <% packages.forEach((p,index)=>{ %><article class="plan-card reveal-item <%= p.is_active?'':'inactive' %>" style="--enter-delay:<%= Math.min(index*35,250) %>ms"><div class="plan-top"><div><span class="plan-index"><%= String(index+1).padStart(2,'0') %></span><h3><%= p.name %></h3></div><span class="status-badge <%= p.is_active?'green':'gray' %>"><%= p.is_active?'ACTIVE':'OFF' %></span></div><div class="plan-speed"><i class="bi bi-lightning-charge-fill"></i><strong><%= p.speed_label||'-' %></strong><small>Bandwidth Plan</small></div><div class="plan-price"><strong><%= formatRupiah(p.price) %></strong><span>/ bulan</span></div><div class="plan-meta"><div><span>PPPoE Profile</span><code><%= p.mikrotik_profile||'-' %></code></div><div><span>Subscriber</span><b><%= p.customer_count||0 %></b></div></div><div class="plan-bottom"><span><i class="bi bi-router"></i> MikroTik Ready</span><form method="post" action="/packages/<%= p.id %>/toggle"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="action-pill" title="Aktif/Nonaktif"><i class="bi bi-power"></i></button></form></div></article><% }) %>
    <% if(!packages.length){ %><div class="empty-state large"><i class="bi bi-speedometer2"></i><strong>Belum ada paket</strong><small>Buat service plan pertama INKAMNET.</small></div><% } %>
  </div>
</section>
<div class="modal fade" id="packageModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><form method="post" action="/packages" class="modal-content"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="modal-header"><div><div class="module-kicker">NEW SERVICE PLAN</div><h5 class="modal-title">Tambah Paket Internet</h5></div><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="row g-3"><div class="col-12"><label class="form-label">Nama Paket</label><input class="form-control" name="name" required placeholder="20Mbps-KRW"></div><div class="col-6"><label class="form-label">Bandwidth</label><input class="form-control" name="speed_label" placeholder="20 Mbps"></div><div class="col-6"><label class="form-label">Harga / Bulan</label><input class="form-control" type="number" name="price" required></div><div class="col-12"><label class="form-label">MikroTik PPP Profile</label><input class="form-control" name="mikrotik_profile" placeholder="20Mbps"></div></div></div><div class="modal-footer"><button type="button" class="btn-tech" data-bs-dismiss="modal">Batal</button><button class="btn-tech primary">Simpan Paket</button></div></form></div></div>
