<section class="package-page">
  <div class="module-head">
    <div><div class="module-kicker">SERVICE CATALOG</div><h1>Paket Internet</h1><p>Paket layanan dibedakan per Site / POP agar harga, bandwidth, dan PPP Profile tidak tercampur antar lokasi.</p></div>
    <div class="module-actions"><button class="btn-tech primary" data-bs-toggle="modal" data-bs-target="#packageModal"><i class="bi bi-plus-lg"></i>Tambah Paket</button></div>
  </div>

  <div class="package-site-switcher"><a class="<%= selectedSite?'':'active' %>" href="/packages"><i class="bi bi-grid-fill"></i><span><strong>Semua Site</strong><small><%= siteStats.reduce((n,s)=>n+Number(s.package_count||0),0) %> paket</small></span></a><% siteStats.forEach(site=>{ %><a class="<%= String(selectedSite)===String(site.id)?'active':'' %>" href="/packages?site=<%= site.id %>"><span class="site-code-pill"><%= site.code %></span><span><strong><%= site.name %></strong><small><%= site.active_count %>/<%= site.package_count %> paket aktif</small></span></a><% }) %></div>

  <div class="metric-grid">
    <article class="metric-card"><div class="metric-top"><span class="metric-label">Total Paket</span><span class="metric-icon"><i class="bi bi-speedometer2"></i></span></div><strong><%= packages.length %></strong><small>Hasil filter saat ini</small></article>
    <article class="metric-card green"><div class="metric-top"><span class="metric-label">Paket Aktif</span><span class="metric-icon"><i class="bi bi-check-circle-fill"></i></span></div><strong><%= packages.filter(p=>p.is_active).length %></strong><small>Siap dipakai pelanggan</small></article>
    <article class="metric-card"><div class="metric-top"><span class="metric-label">Harga Terendah</span><span class="metric-icon"><i class="bi bi-tag-fill"></i></span></div><strong><%= formatRupiah(packages.length?Math.min(...packages.map(p=>Number(p.price))):0) %></strong><small>Paket termurah</small></article>
    <article class="metric-card"><div class="metric-top"><span class="metric-label">Subscriber</span><span class="metric-icon"><i class="bi bi-people-fill"></i></span></div><strong><%= packages.reduce((a,p)=>a+Number(p.customer_count||0),0) %></strong><small>Pelanggan aktif</small></article>
  </div>

  <div class="plan-grid package-catalog-grid">
    <% packages.forEach((p,index)=>{ %>
      <article class="plan-card reveal-item <%= p.is_active?'':'inactive' %>" style="--enter-delay:<%= Math.min(index*35,250) %>ms">
        <div class="plan-top"><div><span class="plan-index"><%= String(index+1).padStart(2,'0') %></span><div><small>PAKET <%= p.site_code||'GLOBAL' %></small><h3><%= p.name %></h3></div></div><span class="status-badge <%= p.is_active?'green':'gray' %>"><%= p.is_active?'AKTIF':'NONAKTIF' %></span></div>
        <div class="package-site-badge"><i class="bi bi-geo-alt-fill"></i><strong><%= p.site_code||'GLOBAL' %></strong><span><%= p.site_name||'Paket lama / semua site' %></span></div>
        <div class="plan-speed"><i class="bi bi-lightning-charge-fill"></i><strong><%= p.speed_label||'-' %></strong><small>Bandwidth Plan</small></div>
        <div class="plan-price"><strong><%= formatRupiah(p.price) %></strong><span>/ bulan</span></div>
        <div class="plan-meta"><div><span>PPPoE Profile</span><code><%= p.mikrotik_profile||'-' %></code></div><div><span>Subscriber</span><b><%= p.customer_count||0 %></b></div></div>
        <div class="plan-bottom"><span><i class="bi bi-hdd-network"></i> <%= p.site_code||'GLOBAL' %></span><div class="d-flex gap-1"><button class="action-pill" type="button" title="Edit Paket" data-bs-toggle="modal" data-bs-target="#editPackage<%= p.id %>"><i class="bi bi-pencil-square"></i></button><form method="post" action="/packages/<%= p.id %>/toggle"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="action-pill" title="Aktif/Nonaktif"><i class="bi bi-power"></i></button></form></div></div>
      </article>
    <% }) %>
    <% if(!packages.length){ %><div class="empty-state large"><i class="bi bi-speedometer2"></i><strong>Belum ada paket</strong><small>Tambahkan paket untuk Site / POP yang dipilih.</small></div><% } %>
  </div>
</section>

<div class="modal fade" id="packageModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><form method="post" action="/packages" class="modal-content"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="modal-header"><div><div class="module-kicker">NEW SERVICE PLAN</div><h5 class="modal-title">Tambah Paket Internet</h5></div><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="row g-3"><div class="col-12"><label class="form-label">Site / POP *</label><select class="form-select" name="site_id" required><option value="">Pilih Site</option><% sites.forEach(s=>{ %><option value="<%= s.id %>"><%= s.code %> · <%= s.name %></option><% }) %></select></div><div class="col-12"><label class="form-label">Nama Paket *</label><input class="form-control" name="name" required placeholder="20Mbps-KRW"></div><div class="col-6"><label class="form-label">Bandwidth</label><input class="form-control" name="speed_label" placeholder="20 Mbps"></div><div class="col-6"><label class="form-label">Harga / Bulan</label><input class="form-control" type="number" min="0" name="price" required></div><div class="col-12"><label class="form-label">MikroTik PPP Profile</label><input class="form-control" name="mikrotik_profile" placeholder="20Mbps"></div></div></div><div class="modal-footer"><button type="button" class="btn-tech" data-bs-dismiss="modal">Batal</button><button class="btn-tech primary">Simpan Paket</button></div></form></div></div>

<% packages.forEach(p=>{ %><div class="modal fade" id="editPackage<%= p.id %>" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><form method="post" action="/packages/<%= p.id %>/edit" class="modal-content"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="modal-header"><div><div class="module-kicker">SERVICE PLAN UPDATE</div><h5 class="modal-title">Edit Paket <%= p.name %></h5></div><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="row g-3"><div class="col-12"><label class="form-label">Site / POP *</label><select class="form-select" name="site_id" required><option value="">Pilih Site</option><% sites.forEach(s=>{ %><option value="<%= s.id %>" <%= String(p.site_id||'')===String(s.id)?'selected':'' %>><%= s.code %> · <%= s.name %></option><% }) %></select><% if(!p.site_id){ %><div class="form-help text-warning-soft">Paket lama ini masih GLOBAL. Pilih site yang benar sebelum menyimpan perubahan.</div><% } %></div><div class="col-12"><label class="form-label">Nama Paket *</label><input class="form-control" name="name" required value="<%= p.name %>"></div><div class="col-6"><label class="form-label">Bandwidth</label><input class="form-control" name="speed_label" value="<%= p.speed_label||'' %>"></div><div class="col-6"><label class="form-label">Harga / Bulan</label><input class="form-control" type="number" min="0" name="price" value="<%= Number(p.price||0) %>" required></div><div class="col-12"><label class="form-label">MikroTik PPP Profile</label><input class="form-control" name="mikrotik_profile" value="<%= p.mikrotik_profile||'' %>"></div></div></div><div class="modal-footer"><button type="button" class="btn-tech" data-bs-dismiss="modal">Batal</button><button class="btn-tech primary"><i class="bi bi-check2"></i>Simpan Perubahan</button></div></form></div></div><% }) %>
