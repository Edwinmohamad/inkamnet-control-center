<section>
  <div class="module-head"><div><div class="module-kicker">NETWORK OPERATIONS CENTER</div><h1>Network Monitor</h1><p>Ringkasan kesehatan router, pelanggan online, isolir, dan status tiap site.</p></div><div class="module-actions"><a href="/routers" class="btn-tech primary"><i class="bi bi-router-fill"></i>Router MikroTik</a></div></div>
  <div class="metric-grid">
    <article class="metric-card green"><div class="metric-top"><span class="metric-label">Router Online</span><span class="metric-icon"><i class="bi bi-router-fill"></i></span></div><strong><%= Number(summary.routers_online||0) %>/<%= Number(summary.routers_total||0) %></strong><small>Last known health</small></article>
    <article class="metric-card green"><div class="metric-top"><span class="metric-label">Customer Online</span><span class="metric-icon"><i class="bi bi-wifi"></i></span></div><strong><%= Number(summary.customers_online||0) %></strong><small>PPPoE/network status online</small></article>
    <article class="metric-card red"><div class="metric-top"><span class="metric-label">Customer Isolir</span><span class="metric-icon"><i class="bi bi-wifi-off"></i></span></div><strong><%= Number(summary.customers_isolated||0) %></strong><small>Billing / manual isolation</small></article>
    <article class="metric-card"><div class="metric-top"><span class="metric-label">Monitoring Mode</span><span class="metric-icon"><i class="bi bi-activity"></i></span></div><strong>LIVE</strong><small>Database + router health state</small></article>
  </div>
  <div class="noc-site-grid mb-3">
    <% sites.forEach((s,index)=>{ const total=Number(s.customers||0); const on=Number(s.online_count||0); const pct=total?Math.round(on/total*100):0; %>
    <article class="noc-site-card reveal-item" style="--enter-delay:<%= index*55 %>ms"><div class="noc-site-top"><div><span class="module-kicker">SITE <%= s.code %></span><h3><%= s.name %></h3></div><div class="noc-signal <%= Number(s.unreachable_count||0)>0?'danger':'ok' %>"><i></i><%= Number(s.unreachable_count||0)>0?'ATTENTION':'STABLE' %></div></div><div class="noc-ring" style="--p:<%= pct %>"><span><b><%= pct %>%</b><small>online</small></span></div><div class="noc-mini-stats"><span><b><%= on %></b> Online</span><span><b><%= Number(s.offline_count||0) %></b> Offline</span><span><b><%= Number(s.isolated_count||0) %></b> Isolir</span></div></article>
    <% }) %>
  </div>
  <div class="data-card"><div class="data-card-head"><div><h3>Router Fleet</h3><small>Status terakhir router per site dan distribusi customer.</small></div></div><div class="table-responsive"><table class="app-table"><thead><tr><th>Router</th><th>Site</th><th>Status</th><th>Last Seen</th><th>Customer</th><th>Online</th><th>Isolir</th><th>Endpoint</th></tr></thead><tbody><% routers.forEach(r=>{ %><tr><td><span class="cell-main"><%= r.name %></span><span class="cell-sub"><%= r.username %></span></td><td><span class="status-badge purple"><%= r.site_code %></span></td><td><span class="status-badge <%= r.last_status==='online'?'green':r.last_status==='offline'?'red':'orange' %>"><%= r.last_status %></span></td><td><%= r.last_seen_at?new Date(r.last_seen_at).toLocaleString('id-ID',{timeZone:'Asia/Jakarta'}):'-' %></td><td><%= r.customers %></td><td class="text-success-soft"><%= r.online_customers %></td><td class="text-danger-soft"><%= r.isolated_customers %></td><td><code class="endpoint"><%= r.base_url %></code></td></tr><% }) %><% if(!routers.length){ %><tr><td colspan="8"><div class="empty-state"><i class="bi bi-router"></i><strong>Belum ada router</strong><small>Tambahkan MikroTik dari menu Router MikroTik.</small></div></td></tr><% } %></tbody></table></div></div>
</section>
