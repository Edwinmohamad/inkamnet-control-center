<% const monthNames=['Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember']; %>
<section>
<div class="module-head"><div><div class="module-kicker">BUSINESS INTELLIGENCE</div><h1>Laporan</h1><p>Tagihan, pemasukan, pengeluaran, pembayaran, tunggakan, dan cash collection per site.</p></div></div>
<form class="filter-card" method="get"><div class="filter-grid"><div class="filter-group"><label>BULAN</label><select class="form-select" name="month"><% monthNames.forEach((m,i)=>{ %><option value="<%= i+1 %>" <%= filters.month===i+1?'selected':'' %>><%= m %></option><% }) %></select></div><div class="filter-group"><label>TAHUN</label><input class="form-control" type="number" name="year" value="<%= filters.year %>"></div><div class="filter-group"><label>SITE / POP</label><select class="form-select" name="site"><option value="">Semua Site</option><% sites.forEach(s=>{ %><option value="<%= s.code %>" <%= filters.site===s.code?'selected':'' %>><%= s.code %> · <%= s.name %></option><% }) %></select></div><div class="d-flex align-items-end"><button class="btn-tech primary"><i class="bi bi-stars"></i>Generate Report</button></div></div></form>
<div class="report-export-bar"><div><span class="module-kicker">EXPORT CENTER</span><strong><%= monthNames[filters.month-1] %> <%= filters.year %> <%= filters.site?'· '+filters.site:'· Semua Site' %></strong></div><div class="report-export-actions"><a href="/reports/csv?type=billing&month=<%= filters.month %>&year=<%= filters.year %>&site=<%= filters.site %>"><i class="bi bi-receipt"></i>Tagihan</a><a href="/reports/csv?type=payments&month=<%= filters.month %>&year=<%= filters.year %>&site=<%= filters.site %>"><i class="bi bi-wallet2"></i>Pembayaran</a><a href="/reports/csv?type=income&month=<%= filters.month %>&year=<%= filters.year %>&site=<%= filters.site %>"><i class="bi bi-arrow-down-left-circle"></i>Pemasukan</a><a href="/reports/csv?type=expense&month=<%= filters.month %>&year=<%= filters.year %>&site=<%= filters.site %>"><i class="bi bi-arrow-up-right-circle"></i>Pengeluaran</a></div></div>
<div class="metric-grid"><article class="metric-card"><div class="metric-top"><span class="metric-label">Total Tagihan</span><span class="metric-icon"><i class="bi bi-receipt"></i></span></div><strong><%= formatRupiah(billing.billed) %></strong><small><%= billing.invoices %> invoice</small></article><article class="metric-card green"><div class="metric-top"><span class="metric-label">Pembayaran</span><span class="metric-icon"><i class="bi bi-check2-circle"></i></span></div><strong><%= formatRupiah(billing.paid) %></strong><small>Billing collected</small></article><article class="metric-card red"><div class="metric-top"><span class="metric-label">Outstanding</span><span class="metric-icon"><i class="bi bi-hourglass-split"></i></span></div><strong><%= formatRupiah(billing.outstanding) %></strong><small>Belum tertagih</small></article><article class="metric-card <%= cash.balance>=0?'green':'red' %>"><div class="metric-top"><span class="metric-label">Cash Balance</span><span class="metric-icon"><i class="bi bi-wallet2"></i></span></div><strong><%= formatRupiah(cash.balance) %></strong><small><%= formatRupiah(cash.income) %> in · <%= formatRupiah(cash.expense) %> out</small></article></div>
<div class="report-insight-strip"><div><i class="bi bi-person-vcard"></i><span>Cash masih di staff</span><strong><%= formatRupiah(collection.cash_held||0) %></strong></div><div><i class="bi bi-bank2"></i><span>Transfer pending</span><strong><%= formatRupiah(collection.transfer_pending||0) %></strong></div><div><i class="bi bi-graph-up-arrow"></i><span>Net cashflow</span><strong><%= formatRupiah(cash.balance) %></strong></div></div>
<div class="row g-3"><div class="col-xl-7"><div class="data-card h-100"><div class="data-card-head"><div><h3>Arus Kas Periode</h3><small><%= monthNames[filters.month-1] %> <%= filters.year %></small></div></div><div class="table-responsive"><table class="app-table"><thead><tr><th>Tanggal</th><th>Nama</th><th>Kategori</th><th>Site</th><th>Jenis</th><th>Nominal</th></tr></thead><tbody><% cashRows.forEach(r=>{ %><tr><td><%= formatDate(r.transaction_date) %></td><td class="cell-main"><%= r.name %></td><td><%= r.category %></td><td><%= r.site_code||'GLOBAL' %></td><td><span class="status-badge <%= r.type==='income'?'green':'red' %>"><%= r.type %></span></td><td class="money <%= r.type==='income'?'text-success-soft':'text-danger-soft' %>"><%= formatRupiah(r.amount) %></td></tr><% }) %><% if(!cashRows.length){%><tr><td colspan="6"><div class="empty-state"><i class="bi bi-bar-chart-line"></i><strong>Belum ada data arus kas</strong><small>Tambahkan transaksi dari menu Arus Kas.</small></div></td></tr><%}%></tbody></table></div></div></div><div class="col-xl-5"><div class="data-card h-100"><div class="data-card-head"><div><h3>Tunggakan per Site</h3><small>Aging outstanding semua periode</small></div></div><div class="table-responsive"><table class="app-table"><thead><tr><th>Site</th><th>Invoice</th><th>Outstanding</th></tr></thead><tbody><% aging.forEach(r=>{ %><tr><td><span class="status-badge purple"><%= r.site_code %></span></td><td><%= r.invoices %></td><td class="money text-danger-soft"><%= formatRupiah(r.outstanding) %></td></tr><% }) %><% if(!aging.length){%><tr><td colspan="3"><div class="empty-state"><i class="bi bi-check2-circle"></i><strong>Tidak ada tunggakan</strong><small>Outstanding bersih.</small></div></td></tr><%}%></tbody></table></div></div></div></div>
</section>
